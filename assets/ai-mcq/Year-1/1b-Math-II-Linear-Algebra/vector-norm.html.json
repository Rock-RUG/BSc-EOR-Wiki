swer_mode":"server","feedback_revision":"a59dc64a5a999466899e63e1"},{"id":"la_batch12_vector_norm_003","difficulty":"standard","question_type":"conceptual","question":"The triangle inequality for the Euclidean norm states that $\\|x+y\\|$ is:","options":["$\\le\\|x\\|+\\|y\\|$","$=\\|x\\|+\\|y\\|$","$\\ge\\|x\\|+\\|y\\|$","$=\\|x\\|\\,\\|y\\|$"],"answer_mode":"server","feedback_revision":"1bb02575159623f915d705ce"},{"id":"la_batch12_vector_norm_004","difficulty":"basic","question_type":"conceptual","question":"If a vector is multiplied by a scalar $\\alpha$, what happens to its norm?","options":["The norm is multiplied by $\\alpha$ even when $\\alpha \\lt 0$.","The norm is increased by $\\alpha$.","The norm is unchanged for every scalar.","The norm is multiplied by $|\\alpha|$."],"answer_mode":"server","feedback_revision":"f924a29e0f4be3b1a42c3d61"},{"id":"la_batch12_vector_norm_005","difficulty":"basic","question_type":"conceptual","question":"What is lost when a vector is replaced only by its norm?","options":["Its nonnegativity is lost.","Its length is lost.","Its existence as a vector space element is lost.","Its direction is lost."],"answer_mode":"server","feedback_revision":"0c396962ef6e6a1ec8c1b502"},{"id":"la_batch12_vector_norm_006","difficulty":"basic","question_type":"application","question":"What is $\\|(3,4)\\|$?","options":["$5$","$7$","$\\sqrt7$","$25$"],"answer_mode":"server","feedback_revision":"f082dbe23f11fa258aecd160"},{"id":"la_batch12_vector_norm_007","difficulty":"basic","question_type":"application","question":"What is $\\|(-1,2,2)\\|$?","options":["$5$","$3$","$\\sqrt5$","$-3$"],"answer_mode":"server","feedback_revision":"91c804b2c727af0a3a21c09b"},{"id":"la_batch12_vector_norm_008","difficulty":"basic","question_type":"application","question":"Which vector has norm $\\sqrt2$?","options":["$(2,0)$","$(0,0)$","$(1,2)$","$(1,1)$"],"answer_mode":"server","feedback_revision":"24c2e90a98331d71158abb33"},{"id":"la_batch12_vector_norm_009","difficulty":"basic","question_type":"application","question":"If $\\|x\\|=5$, what is $\\|2x\\|$?","options":["$25$","$10$","$7$","$5$"],"answer_mode":"server","feedback_revision":"f4c65e778c71d0b5b55d59ef"},{"id":"la_batch12_vector_norm_010","difficulty":"basic","question_type":"application","question":"What is $\\|(0,0,0)\\|$?","options":["$1$","It is undefined.","$0$","$3$"],"answer_mode":"server","feedback_revision":"15e47cf11de045c1360e8429"},{"id":"la_batch12_vector_norm_011","difficulty":"standard","question_type":"conceptual","question":"Why do $x$ and $-x$ always have the same norm?","options":["They are always the same vector.","The statement only holds in $\\mathbb R^2$.","The norm ignores all coordinates except the first.","Multiplying by $-1$ changes direction but not length."],"answer_mode":"server","feedback_revision":"ab70cd7b3e552a063c0e719c"},{"id":"la_batch12_vector_norm_012","difficulty":"basic","question_type":"conceptual","question":"For any vector $x$, the quantity $\\|x\\|^{2}$ equals:","options":["$|x_1|+\\cdots+|x_n|$","$x\\cdot x$","$2(x\\cdot x)$","$x+x$"],"answer_mode":"server","feedback_revision":"4e609d9297fdd626fcd300ec"},{"id":"la_batch12_vector_norm_013","difficulty":"standard","question_type":"conceptual","question":"Which proposed “length” rule would fail the nonnegativity expected of a norm?","options":["Assigning $\\|(-3,-4)\\|=5$.","Assigning $\\|(1,-3)\\|=-2$.","Assigning $\\|(3,4)\\|=5$.","Assigning $\\|(0,0)\\|=0$."],"answer_mode":"server","feedback_revision":"02f1da1675b8a984c0e0ab77"},{"id":"la_batch12_vector_norm_014","difficulty":"standard","question_type":"application","question":"For which value of $t$ is $\\|(3,t)\\|=5$?","options":["$t=5$","$t=8$","$t=2$","$t=4$"],"answer_mode":"server","feedback_revision":"962af5915d8106314820b092"},{"id":"la_batch12_vector_norm_015","difficulty":"standard","question_type":"application","question":"If $\\|x\\|=6$, what is $\\|-\\tfrac12 x\\|$?","options":["$-3$","$12$","$3$","$6$"],"answer_mode":"server","feedback_revision":"6fb2e42bc0e4c3467cab8533"},{"id":"la_batch12_vector_norm_016","difficulty":"standard","question_type":"application","question":"Which vector has the smallest norm?","options":["$(2,2,1)$","$(1,1,1)$","$(0,0,2)$","$(3,0,0)$"],"answer_mode":"server","feedback_revision":"f862c6ae05f295c74775ddbd"},{"id":"la_batch12_vector_norm_017","difficulty":"standard","question_type":"conceptual","question":"The correct scaling (homogeneity) property of a norm is $\\|\\alpha x\\|=$","options":["$\\alpha^{2}\\,\\|x\\|$","$\\|x\\|$","$|\\alpha|\\,\\|x\\|$","$\\alpha\\,\\|x\\|$"],"answer_mode":"server","feedback_revision":"af4fa0e6be1cb3239f5225eb"},{"id":"la_batch12_vector_norm_018","difficulty":"challenge","question_type":"conceptual","question":"A vector has a large norm. What conclusion is safe?","options":["Its coordinates are all positive.","It is orthogonal to every short vector.","It has more coordinates than a vector with small norm.","It is far from the origin."],"answer_mode":"server","feedback_revision":"4787522fa8c0b5851e566311"},{"id":"la_batch12_vector_norm_019","difficulty":"challenge","question_type":"application","question":"If $\\|(3,4)\\|=5$, for which scalar $\\alpha$ does $\\|\\alpha(3,4)\\|=20$ hold?","options":["$\\alpha=-20$","$\\alpha=-4$","$\\alpha=\\tfrac14$","$\\alpha=5$"],"answer_mode":"server","feedback_revision":"fc5fffff3f323bd90b093b97"},{"id":"la_batch12_vector_norm_020","difficulty":"challenge","question_type":"application","question":"Which vector is a unit vector in the same direction as $(1,1,1)$?","options":["$(1/3,1/3,1/3)$","$(\\sqrt3,\\sqrt3,\\sqrt3)$","$(-1/\\sqrt3,-1/\\sqrt3,-1/\\sqrt3)$","$(1/\\sqrt3,1/\\sqrt3,1/\\sqrt3)$"],"answer_mode":"server","feedback_revision":"0b16d3cb2fac5b88726228c8"}]}}