,{"id":"la_batch16_projection_matrix_003","difficulty":"basic","question_type":"conceptual","question":"Why is the identity matrix a projection matrix?","options":["It projects only onto the $x$-axis, which is false","It sends every vector to zero","It projects every vector onto the whole space","It is never idempotent"],"answer_mode":"server","feedback_revision":"79aa5a514e2582c873fe6ed3"},{"id":"la_batch16_projection_matrix_004","difficulty":"basic","question_type":"conceptual","question":"What extra property is stated for orthogonal projection matrices?","options":["They are singular in every case","They have no real entries","They satisfy $P^2=-P$","They are symmetric as well as idempotent"],"answer_mode":"server","feedback_revision":"c74c3f16342b244e57b863d4"},{"id":"la_batch16_projection_matrix_005","difficulty":"basic","question_type":"conceptual","question":"What happens to a vector that is already in the subspace onto which $P$ projects?","options":["It stays fixed under the projection","It changes sign","It must become the zero vector","It is sent outside the subspace"],"answer_mode":"server","feedback_revision":"a6f97d3454e05d38f35bec63"},{"id":"la_batch16_projection_matrix_006","difficulty":"basic","question_type":"application","question":"Let $P=\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$. What is $P(3,4)^T$?","options":["$\\begin{pmatrix}3\\\\4\\end{pmatrix}$","$\\begin{pmatrix}0\\\\4\\end{pmatrix}$","$\\begin{pmatrix}0\\\\0\\end{pmatrix}$","$\\begin{pmatrix}3\\\\0\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"bd64470f90a21b2323b636af"},{"id":"la_batch16_projection_matrix_007","difficulty":"basic","question_type":"application","question":"For $P=\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$, what is $P^2$?","options":["$\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$","$\\begin{pmatrix}1&0\\\\0&1\\end{pmatrix}$","$\\begin{pmatrix}2&0\\\\0&0\\end{pmatrix}$","$\\begin{pmatrix}0&0\\\\0&0\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"84dac1683a09047cc728f205"},{"id":"la_batch16_projection_matrix_008","difficulty":"basic","question_type":"application","question":"Which matrix projects $(x,y)^T$ onto the $y$-axis?","options":["$\\begin{pmatrix}0&1\\\\1&0\\end{pmatrix}$","$\\begin{pmatrix}0&0\\\\0&1\\end{pmatrix}$","$\\begin{pmatrix}1&1\\\\0&0\\end{pmatrix}$","$\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"d58876175af0350c170ca5d9"},{"id":"la_batch16_projection_matrix_009","difficulty":"basic","question_type":"application","question":"What does the identity matrix $I_2$ do as a projection?","options":["It sends $(x,y)^T$ to $(x,0)^T$","It sends $(x,y)^T$ to $(0,y)^T$","It sends every vector to $(1,1)^T$","It sends $(x,y)^T$ to $(x,y)^T$"],"answer_mode":"server","feedback_revision":"f72fbef515919dc43f7062a9"},{"id":"la_batch16_projection_matrix_010","difficulty":"basic","question_type":"application","question":"Which matrix is idempotent?","options":["$\\begin{pmatrix}0&1\\\\-1&0\\end{pmatrix}$","$\\begin{pmatrix}1&1\\\\1&1\\end{pmatrix}$","$\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$","$\\begin{pmatrix}2&0\\\\0&0\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"147c407201ed239f4d553956"},{"id":"la_batch16_projection_matrix_011","difficulty":"standard","question_type":"conceptual","question":"A projection matrix may collapse some nonzero vectors to zero. Where do those vectors lie geometrically?","options":["Only outside the original vector space","In directions removed by the projection","In the target subspace itself","Only among vectors with no coordinates"],"answer_mode":"server","feedback_revision":"ffa4c5787ec8f6a4ab63e3ff"},{"id":"la_batch16_projection_matrix_012","difficulty":"standard","question_type":"conceptual","question":"Why is $P^2=P$ a natural test for a projection?","options":["The second projection always reverses the first one","After one projection, applying it again has no further effect","A projection has to swap coordinates","Every projection must be invertible"],"answer_mode":"server","feedback_revision":"4a15a4a85c25a378ab24e774"},{"id":"la_batch16_projection_matrix_013","difficulty":"standard","question_type":"conceptual","question":"Does idempotence alone make a projection orthogonal?","options":["Yes; symmetry is unrelated to orthogonal projection","No; idempotent matrices cannot be projections","No; orthogonal projections also have symmetry","Yes; every idempotent matrix is automatically symmetric"],"answer_mode":"server","feedback_revision":"d436a9fcf8b5bcf9fff400d5"},{"id":"la_batch16_projection_matrix_014","difficulty":"standard","question_type":"application","question":"Let $P=\\begin{pmatrix}1&1\\\\0&0\\end{pmatrix}$. What is $P^2$?","options":["$0$","$P$","$2P$","$I_2$"],"answer_mode":"server","feedback_revision":"9242f1aed4911fc2c957b352"},{"id":"la_batch16_projection_matrix_015","difficulty":"standard","question_type":"application","question":"For $P=\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$, which vector is fixed by $P$?","options":["$\\begin{pmatrix}5\\\\0\\end{pmatrix}$","$\\begin{pmatrix}-1\\\\2\\end{pmatrix}$","$\\begin{pmatrix}0\\\\5\\end{pmatrix}$","$\\begin{pmatrix}3\\\\4\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"c44622bd21469c2aab76a4fe"},{"id":"la_batch16_projection_matrix_016","difficulty":"standard","question_type":"application","question":"For $P=\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$, which vector is sent to zero?","options":["$\\begin{pmatrix}7\\\\0\\end{pmatrix}$","$\\begin{pmatrix}0\\\\7\\end{pmatrix}$","$\\begin{pmatrix}7\\\\7\\end{pmatrix}$","$\\begin{pmatrix}1\\\\1\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"c4044749dbcacf5ca7e5e399"},{"id":"la_batch16_projection_matrix_017","difficulty":"challenge","question_type":"conceptual","question":"If $P^2=P$, why is $I-P$ also projection-like?","options":["Because $(I-P)^2=I-P$","Because subtracting from $I$ destroys idempotence","Because $I-P$ must equal $P$","Because $I-P$ is always the zero matrix"],"answer_mode":"server","feedback_revision":"8badf14967d37d0508a053b5"},{"id":"la_batch16_projection_matrix_018","difficulty":"challenge","question_type":"conceptual","question":"Why can $\\begin{pmatrix}1&1\\\\0&0\\end{pmatrix}$ be idempotent without being an orthogonal projection matrix?","options":["It satisfies $P^2=P$ but is not symmetric","It sends every vector to itself","It is symmetric but not idempotent","It has no real entries"],"answer_mode":"server","feedback_revision":"ab58519eae0ceb7522723103"},{"id":"la_batch16_projection_matrix_019","difficulty":"challenge","question_type":"application","question":"For $P=\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$, what is $(I-P)(3,4)^T$?","options":["$\\begin{pmatrix}0\\\\4\\end{pmatrix}$","$\\begin{pmatrix}3\\\\4\\end{pmatrix}$","$\\begin{pmatrix}3\\\\0\\end{pmatrix}$","$\\begin{pmatrix}0\\\\0\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"a409b4b7a5342d873cf08527"},{"id":"la_batch16_projection_matrix_020","difficulty":"challenge","question_type":"application","question":"Which matrix is idempotent but not symmetric?","options":["$\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$","$\\begin{pmatrix}2&0\\\\0&2\\end{pmatrix}$","$\\begin{pmatrix}0&1\\\\1&0\\end{pmatrix}$","$\\begin{pmatrix}1&1\\\\0&0\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"173213a19cdca374691c19f4"}]}}