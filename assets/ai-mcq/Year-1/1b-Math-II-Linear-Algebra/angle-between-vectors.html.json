th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1b-Math-II-Linear-Algebra/angle-between-vectors.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/angle-between-vectors.html","questions":[{"id":"la_batch12_angle_between_vectors_001","difficulty":"basic","question_type":"conceptual","question":"Which equation relates the angle $\\theta$ between nonzero vectors to their dot product?","options":["$x\\cdot y=\\|x\\|\\|y\\|\\cos\\theta$","$x\\cdot y=\\|x\\|+\\|y\\|+\\theta$","$\\|x-y\\|=\\theta$","$x\\cdot y=\\|x\\|\\|y\\|\\sin\\theta$"],"answer_mode":"server","feedback_revision":"34518daee8d7865f9fbf6841","time_limit":20},{"id":"la_batch12_angle_between_vectors_002","difficulty":"basic","question_type":"conceptual","question":"Why must both vectors be nonzero when defining the angle by the dot-product formula?","options":["Angles are defined only for unit vectors.","The denominator $\\|x\\|\\|y\\|$ would otherwise be zero.","The dot product is undefined for zero vectors.","Zero vectors have negative length."],"answer_mode":"server","feedback_revision":"1bd28cf54c5d700711d716d9","time_limit":25},{"id":"la_batch12_angle_between_vectors_003","difficulty":"basic","question_type":"conceptual","question":"If $x\\cdot y \\gt 0$, what kind of angle do nonzero vectors $x$ and $y$ make?","options":["An obtuse angle.","An acute angle.","No angle can be defined.","A right angle."],"answer_mode":"server","feedback_revision":"9bee4aa2da9ab9d5ac836f1a","time_limit":20},{"id":"la_batch12_angle_between_vectors_004","difficulty":"basic","question_type":"conceptual","question":"If $x\\cdot y=0$ for nonzero vectors, what is their angle?","options":["An obtuse angle.","A zero angle.","An acute angle.","A right angle."],"answer_mode":"server","feedback_revision":"8844006819fcd52c00236f99","time_limit":20},{"id":"la_batch12_angle_between_vectors_006","difficulty":"basic","question_type":"application","question":"What is the angle between $(1,0)$ and $(0,1)$?","options":["$\\pi/2$","$\\pi$","$\\pi/4$","$0$"],"answer_mode":"server","feedback_revision":"883ac8eda1ff63fd32eca891","time_limit":20},{"id":"la_batch12_angle_between_vectors_008","difficulty":"basic","question_type":"application","question":"What is the angle between $(1,0)$ and $(-1,0)$?","options":["$\\pi$","$0$","$\\pi/4$","$\\pi/2$"],"answer_mode":"server","feedback_revision":"c757252fca46296b1eb8dd83","time_limit":20},{"id":"la_batch12_angle_between_vectors_011","difficulty":"standard","question_type":"conceptual","question":"How does Cauchy-Schwarz support the angle formula?","options":["It says the denominator is always zero.","It ensures the cosine ratio lies in $[-1,1]$.","It replaces cosine by determinant.","It makes every angle acute."],"answer_mode":"server","feedback_revision":"3bd2eb501580d38df41f88c0","time_limit":30},{"id":"la_batch12_angle_between_vectors_013","difficulty":"standard","question_type":"conceptual","question":"Why does scaling one vector by a positive scalar not change the angle?","options":["The norm of the scaled vector becomes zero, so the angle formula no longer changes.","The formula stops using the dot product.","The vector becomes orthogonal to itself.","The dot product and the norm product are scaled by the same positive factor."],"answer_mode":"server","feedback_revision":"36739c60247d12f0357935bf","time_limit":30},{"id":"la_batch12_angle_between_vectors_014","difficulty":"standard","question_type":"application","question":"For $x=(1,0)$ and $y=(1,1)$, what is $\\cos\\theta$?","options":["$-1/\\sqrt{2}$","$0$","$1/\\sqrt{2}$","$\\sqrt{2}$"],"answer_mode":"server","feedback_revision":"04d6e113095779329e4c34b7","time_limit":30},{"id":"la_batch12_angle_between_vectors_017","difficulty":"challenge","question_type":"conceptual","question":"Why is the angle between nonzero vectors usually taken in $[0,\\pi]$?","options":["The cosine function is positive only on that interval.","That interval gives a unique angle determined by the cosine value.","Angles outside the interval make dot products undefined.","Vectors cannot be opposite in $\\mathbb{R}^n$."],"answer_mode":"server","feedback_revision":"577a5ef9da57a0712b0d7bfd","time_limit":40},{"id":"la_batch12_angle_between_vectors_007_curated20261027_001","difficulty":"standard","question_type":"application","question":"Nonzero vectors $\\boldsymbol{x},\\boldsymbol{y}\\in\\mathbb{R}^n$ make the angle $\\pi/4$. What is the angle between $-2\\boldsymbol{x}$ and $\\boldsymbol{y}$?","options":["$3\\pi/4$","$\\pi/4$","$\\pi/2$","$5\\pi/4$"],"answer_mode":"server","feedback_revision":"d9e07334ce1855d1e6f56439","time_limit":30},{"id":"la_batch12_angle_between_vectors_018_curated20261027_002","difficulty":"challenge","question_type":"conceptual","question":"Let $\\boldsymbol{y}\\in\\mathbb{R}^n$ be nonzero. Which statement about the zero vector $\\boldsymbol{0}$ and $\\boldsymbol{y}$ is correct?","options":["$\\boldsymbol{0}$ is orthogonal to $\\boldsymbol{y}$, but no angle between them is defined.","The angle between $\\boldsymbol{0}$ and $\\boldsymbol{y}$ is $\\pi/2$, since $\\boldsymbol{0}\\cdot\\boldsymbol{y}=0$.","$\\boldsymbol{0}$ is not orthogonal to $\\boldsymbol{y}$, since no angle between them is defined.","The angle between $\\boldsymbol{0}$ and $\\boldsymbol{y}$ is $0$, since $\\boldsymbol{0}=0\\boldsymbol{y}$."],"answer_mode":"server","feedback_revision":"29d7f777b609b96a6fcbfe3f","time_limit":45}]}}