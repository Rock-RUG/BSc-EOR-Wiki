th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1b-Math-II-Linear-Algebra/solution-set.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/solution-set.html","questions":[{"id":"la_batch6_solution_set_001","difficulty":"basic","question_type":"conceptual","question":"What does a solution set contain?","options":["A single particular solution chosen to represent the system.","All values that satisfy at least one equation of the system.","All values of the unknowns for which the equations are defined.","All values or rules that satisfy the equation or system."],"answer_mode":"server","feedback_revision":"3ae944f23eba5d30f552730a","time_limit":25},{"id":"la_batch6_solution_set_003","difficulty":"basic","question_type":"conceptual","question":"What do equivalent systems have in common?","options":["The same number of symbols in each row.","The same solution set.","The same-looking equations.","The same coefficient matrix only."],"answer_mode":"server","feedback_revision":"06735fbeb7558d7d73b36df0","time_limit":20},{"id":"la_batch6_solution_set_004","difficulty":"basic","question_type":"conceptual","question":"How are free variables usually recorded in a solution set?","options":["Using parameters.","By deleting all solutions except one.","By forcing the free variables to be zero.","By moving them outside the system."],"answer_mode":"server","feedback_revision":"7bf3bb1ae358fecd1bea2d44","time_limit":20},{"id":"la_batch6_solution_set_005","difficulty":"basic","question_type":"conceptual","question":"Can a solution set be empty?","options":["Yes, if no value satisfies the equation or system.","Yes, but only for homogeneous systems.","No, a system without solutions has no solution set at all.","Yes, but only when there are more equations than unknowns."],"answer_mode":"server","feedback_revision":"6dba9884c07a69c47d964e83","time_limit":25},{"id":"la_batch6_solution_set_007","difficulty":"basic","question_type":"application","question":"What is the solution set of $x^2=1$ over $\\mathbb{R}$?","options":["$\\{-1\\}$","$\\{1\\}$","$\\{-1,1\\}$","$\\varnothing$"],"answer_mode":"server","feedback_revision":"d58512bf38d98372edfb4488","time_limit":20},{"id":"la_batch6_solution_set_009","difficulty":"basic","question_type":"application","question":"Which parameterization describes all solutions of $x+y=10$?","options":["$x=10-t$, $y=t$, with $t\\ge0$.","$x=10-t$, $y=t$, with $t\\in\\mathbb{R}$.","$x=t$, $y=t-10$, with $t\\in\\mathbb{R}$.","$x=10-s$, $y=10-t$, with $s,t\\in\\mathbb{R}$."],"answer_mode":"server","feedback_revision":"6d58bbc36400bbf1d564de8e","time_limit":30},{"id":"la_batch6_solution_set_010","difficulty":"basic","question_type":"application","question":"What is the solution set of $0x=5$ over $\\mathbb{R}$?","options":["$\\varnothing$","$\\mathbb{R}$","$\\{0\\}$","$\\{5\\}$"],"answer_mode":"server","feedback_revision":"0ed31ce902c06c891c3d69fb","time_limit":20},{"id":"la_batch6_solution_set_014","difficulty":"standard","question_type":"application","question":"Which system has solution set $\\{(1,1)\\}$?","options":["$x-y=0$ only.","$x+y=2$, $x-y=0$.","$x+y=2$ only.","$x+y=3$, $x-y=0$."],"answer_mode":"server","feedback_revision":"4bbc5509e54a2e7a94cbfb03","time_limit":30},{"id":"la_batch6_solution_set_015","difficulty":"standard","question_type":"application","question":"For $x=2t$, $y=1-t$, what equation is satisfied for every $t$?","options":["$2x+y=1$","$x+y=1$","$x-y=0$","$x+2y=2$"],"answer_mode":"server","feedback_revision":"f9dc68bfe4cfe591bcfd4870","time_limit":30},{"id":"la_batch6_solution_set_016","difficulty":"standard","question_type":"application","question":"Which equation has all real numbers as its solution set?","options":["$x+1=x+1$","$x+1=x$","$0x=5$","$x^2=1$"],"answer_mode":"server","feedback_revision":"4d03cc83b97c346aed1716c1","time_limit":30},{"id":"la_batch6_solution_set_017","difficulty":"challenge","question_type":"conceptual","question":"Why must the domain be specified when giving a solution set?","options":["The domain matters only for nonlinear equations, never linear ones.","The allowed values can change which solutions are included.","Only systems with infinitely many solutions depend on the domain.","The domain changes only how solutions are written, not which ones."],"answer_mode":"server","feedback_revision":"efc60d2dbf4815f5bdcc391c","time_limit":40},{"id":"la_batch6_solution_set_020","difficulty":"challenge","question_type":"application","question":"Which parameterization gives the same solution set as $x+y+z=0$?","options":["$x=0$, $y=s$, $z=t$.","$x=-s-t$, $y=s$, $z=-t$.","$x=s+t$, $y=s$, $z=t$.","$x=-s-t$, $y=s$, $z=t$."],"answer_mode":"server","feedback_revision":"c0f39c7333dff8e11b2a2c88","time_limit":40},{"id":"la_batch6_solution_set_002_curated20261027_001","difficulty":"challenge","question_type":"conceptual","question":"Over $\\mathbb{R}$, the linear system $\\boldsymbol{A}\\boldsymbol{x}=\\boldsymbol{b}$ with $\\boldsymbol{b}\\neq\\boldsymbol{0}$ has two solutions $\\boldsymbol{x}_1\\neq\\boldsymbol{x}_2$. Which conclusion is correct?","options":["Every $\\boldsymbol{x}_1+t(\\boldsymbol{x}_2-\\boldsymbol{x}_1)$ with $t\\in\\mathbb{R}$ is a solution, so there are infinitely many.","The solution set may be exactly $\\{\\boldsymbol{x}_1,\\boldsymbol{x}_2\\}$, as for $x^2=1$.","$\\boldsymbol{x}_1+\\boldsymbol{x}_2$ is also a solution, since a sum of solutions is again a solution.","$\\boldsymbol{x}_2-\\boldsymbol{x}_1$ is also a solution of $\\boldsymbol{A}\\boldsymbol{x}=\\boldsymbol{b}$, being a difference of two solutions."],"answer_mode":"server","feedback_revision":"0346d143008440415903125a","time_limit":40}]}}