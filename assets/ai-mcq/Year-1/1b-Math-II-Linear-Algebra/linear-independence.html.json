th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1b-Math-II-Linear-Algebra/linear-independence.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/linear-independence.html","questions":[{"id":"la_manual_batch1_linear_independence_001","difficulty":"basic","question_type":"conceptual","question":"What does linear independence say about the equation $\\alpha_1v_1+\\cdots+\\alpha_kv_k=\\boldsymbol0$?","options":["The only solution is $\\alpha_1=\\cdots=\\alpha_k=0$.","The equation has no solution at all.","The vectors must all be zero.","There must be at least one nonzero solution."],"answer_mode":"server","feedback_revision":"501d8857b4074a9bc219085b","time_limit":25},{"id":"pilot_linear_independence_001","difficulty":"basic","question_type":"conceptual","question":"Which condition is equivalent to linear dependence of a list of vectors?","options":["there exist coefficients, not all zero, giving $\\boldsymbol0$","only the all-zero choice of coefficients gives $\\boldsymbol0$","there exist coefficients, all nonzero, giving $\\boldsymbol0$","one of the vectors in the list is the zero vector $\\boldsymbol0$"],"answer_mode":"server","feedback_revision":"b5936880bef9197957ca6008","time_limit":30},{"id":"la_manual_batch1_linear_independence_003","difficulty":"standard","question_type":"conceptual","question":"If $(v_1,\\dots,v_k)$ is linearly independent, in how many ways can a vector $w\\in\\operatorname{span}(v_1,\\dots,v_k)$ be written as $\\sum_i a_i v_i$?","options":["Exactly one way","At least two ways","Infinitely many ways","No way in general"],"answer_mode":"server","feedback_revision":"07451aef6759264a3a5ef396","time_limit":30},{"id":"la_manual_batch1_linear_independence_004","difficulty":"basic","question_type":"conceptual","question":"Can a list containing the zero vector be linearly independent?","options":["No, because $1\\boldsymbol0=\\boldsymbol0$ is a non-trivial relation.","Yes, if the list has at least two other vectors.","Yes, because the zero vector is needed for independence.","No, because the zero vector is not in any vector space."],"answer_mode":"server","feedback_revision":"4a561902dda72628ce7f4405","time_limit":25},{"id":"la_manual_batch1_linear_independence_005","difficulty":"standard","question_type":"conceptual","question":"What is the largest possible number of vectors in a linearly independent list in $\\mathbb{R}^3$?","options":["Unbounded","$3$","$2$","$4$"],"answer_mode":"server","feedback_revision":"31f3f2617daacf99b775b143","time_limit":30},{"id":"pilot_linear_independence_002","difficulty":"standard","question_type":"application","question":"The list $(v_1,v_2,v_3)$ is linearly independent. What about the sublist $(v_1,v_2)$?","options":["Also linearly independent","Necessarily dependent","Independent only if $v_3=\\boldsymbol0$","Cannot be determined"],"answer_mode":"server","feedback_revision":"9b18e34075e04ce6bfd6345f","time_limit":30},{"id":"la_manual_batch1_linear_independence_008","difficulty":"basic","question_type":"application","question":"Is the single-vector list $((3,4))$ linearly independent?","options":["Yes, because $a(3,4)=(0,0)$ forces $a=0$.","No, because $(3,4)$ is not a standard vector.","Yes, because every vector in $\\mathbb{R}^2$ is independent.","No, because a list needs at least two vectors to be independent."],"answer_mode":"server","feedback_revision":"b2cfbbe0d489912bece3491c","time_limit":25},{"id":"pilot_linear_independence_003","difficulty":"basic","question_type":"conceptual","question":"Which list is guaranteed to be linearly dependent?","options":["A list where one vector is a scalar multiple of another","A list of two nonzero vectors orthogonal to each other","Any list of three vectors taken from the space $\\mathbb{R}^3$","A list in which every vector has at least one zero coordinate"],"answer_mode":"server","feedback_revision":"c6fcfdf33d02e419130b712b","time_limit":25},{"id":"la_manual_batch1_linear_independence_012","difficulty":"challenge","question_type":"conceptual","question":"Suppose $(v_1,v_2)$ is linearly independent. For which vectors $v_3$ is $(v_1,v_2,v_3)$ linearly dependent?","options":["always","never","$v_3\\in\\operatorname{span}(v_1,v_2)$","$v_3=\\boldsymbol0$ only"],"answer_mode":"server","feedback_revision":"09cd699856be70bef1ce3568","time_limit":40},{"id":"la_manual_batch1_linear_independence_014","difficulty":"standard","question_type":"application","question":"Which pair is linearly independent in $\\mathbb{R}^2$?","options":["$((1,1),(2,2))$","$((1,0),(1,1))$","$((3,3),(1,1))$","$((0,0),(1,0))$"],"answer_mode":"server","feedback_revision":"1b6fda6c17f9d943f39b55b7","time_limit":30},{"id":"la_manual_batch1_linear_independence_015","difficulty":"standard","question_type":"application","question":"For $u=(1,2)$ and $v=(3,6)$, which relation shows dependence?","options":["$3u-v=\\boldsymbol0$","$u-v=\\boldsymbol0$","$2v-u=\\boldsymbol0$","$u+v=\\boldsymbol0$"],"answer_mode":"server","feedback_revision":"ebba4d5b2ea2d7b8ad66917b","time_limit":30},{"id":"pilot_linear_independence_005","difficulty":"challenge","question_type":"conceptual","question":"In $\\mathbb{R}^2$, $(1,0),(0,1),(1,1)$ are independent in every pair. Is the full list independent?","options":["No: $(1,0)+(0,1)-(1,1)=\\boldsymbol0$ is a non-trivial relation","Yes, pairwise independence implies independence","Yes, because none of them is the zero vector","Yes, because the list spans $\\mathbb{R}^2$"],"answer_mode":"server","feedback_revision":"24924bc3aa08d03d33122f67","time_limit":40},{"id":"la_manual_batch1_linear_independence_019_curated20261027_001","difficulty":"challenge","question_type":"application","question":"The list $((1,2),(3,6),(1,0))$ in $\\mathbb{R}^2$ is linearly dependent. Which vector of the list is not a linear combination of the other two?","options":["$(1,0)$","$(1,2)$","$(3,6)$","None of the three, since the list is dependent"],"answer_mode":"server","feedback_revision":"4e2aa823fe32d03c8b2dead2","time_limit":40}]}}