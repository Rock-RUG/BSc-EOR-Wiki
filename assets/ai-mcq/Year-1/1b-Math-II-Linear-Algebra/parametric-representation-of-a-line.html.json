th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1b-Math-II-Linear-Algebra/parametric-representation-of-a-line.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/parametric-representation-of-a-line.html","questions":[{"id":"la_batch14_parametric_representation_of_a_line_001","difficulty":"basic","question_type":"conceptual","question":"In $\\ell(t)=A+tv$, what does the point $A$ provide?","options":["A specific point on the line.","A normal vector to the line.","The only possible value of $t$.","The dimension of the line."],"answer_mode":"server","feedback_revision":"f552fc2058ddc3e8bbe7f7b5","time_limit":25},{"id":"la_batch14_parametric_representation_of_a_line_004","difficulty":"basic","question_type":"conceptual","question":"Why can the same line have many parametric representations?","options":["Changing representation changes a line into a plane.","The parameter must always be renamed.","Base points can shift and direction vectors can be rescaled.","A line has no fixed points."],"answer_mode":"server","feedback_revision":"a7b9c5dbb65cbfe8bf8c9de7","time_limit":20},{"id":"la_batch14_parametric_representation_of_a_line_005","difficulty":"basic","question_type":"conceptual","question":"How can one test whether a point lies on a parametrised line?","options":["Check whether it equals $A+tv$ for some real $t$.","Check whether it has norm $1$.","Check whether it is orthogonal to $A$.","Check only whether its first coordinate equals $t$."],"answer_mode":"server","feedback_revision":"d68b5ddd963b0d626f25d652","time_limit":30},{"id":"la_batch14_parametric_representation_of_a_line_008","difficulty":"basic","question_type":"application","question":"For $\\ell(t)=(1,2)+t(3,-1)$, what is $\\ell(2)$?","options":["$(7,0)$","$(6,-2)$","$(4,1)$","$(3,-1)$"],"answer_mode":"server","feedback_revision":"7c43fd8e44b23032b0eefb04","time_limit":20},{"id":"la_batch14_parametric_representation_of_a_line_009","difficulty":"basic","question_type":"application","question":"Which parametrisation describes the line through $(1,0)$ in direction $(2,3)$?","options":["$\\ell(t)=(2,3)+t(1,0)$","$\\ell(t)=(1,0)+t(2,3)$","$\\ell(t)=(1,0)+t(3,2)$","$\\ell(t)=t(1,0)$"],"answer_mode":"server","feedback_revision":"ba94e81b8e44c87a3d5c70e1","time_limit":20},{"id":"la_batch14_parametric_representation_of_a_line_012","difficulty":"standard","question_type":"conceptual","question":"For $\\ell(t)=A+tv$ with $v\\ne0$, which parameter set traces the full line?","options":["All $t\\in\\mathbb{R}$","Only $0\\le t\\le1$","Only $t=0$","Only $t>0$"],"answer_mode":"server","feedback_revision":"2bda77c4f90deef0a9c1aac4","time_limit":30},{"id":"la_batch14_parametric_representation_of_a_line_013","difficulty":"standard","question_type":"conceptual","question":"Why must the direction vector in a useful line parametrisation be nonzero?","options":["A zero direction would give only the single point $A$.","A zero direction gives every point in the space.","A zero direction gives a plane.","A zero direction is the only direction that defines a line."],"answer_mode":"server","feedback_revision":"2fb2e366d7f55b81a64b1492","time_limit":30},{"id":"la_batch14_parametric_representation_of_a_line_014","difficulty":"standard","question_type":"application","question":"Find a parametrisation of the line through $x=(1,2)$ and $y=(4,8)$.","options":["$\\ell(t)=(3,6)+t(1,-2)$","$\\ell(t)=(1,2)+t(4,7)$","$\\ell(t)=(4,8)+t(1,-2)$","$\\ell(t)=(1,2)+t(3,6)$"],"answer_mode":"server","feedback_revision":"a10b226b23e17979c55d728d","time_limit":30},{"id":"la_batch14_parametric_representation_of_a_line_015","difficulty":"standard","question_type":"application","question":"For $\\ell(t)=(2-t,1+3t)$, which direction vector matches the parametrisation?","options":["$(1,3)$","$(-1,3)$","$(-t,3t)$","$(2,1)$"],"answer_mode":"server","feedback_revision":"4d88b5f1012b1f572074be71","time_limit":30},{"id":"la_batch14_parametric_representation_of_a_line_016","difficulty":"standard","question_type":"application","question":"For which $t$ does $\\ell(t)=(1,2)+t(2,1)$ give $(5,4)$?","options":["No such $t$","$t=1$","$t=3$","$t=2$"],"answer_mode":"server","feedback_revision":"eb273c54030bf01a4f146fb3","time_limit":30},{"id":"la_batch14_parametric_representation_of_a_line_020","difficulty":"challenge","question_type":"application","question":"Does $(2,4)$ lie on $\\ell(t)=(1,1)+t(1,2)$?","options":["No, because $(1,2)$ is not a valid direction vector.","Yes; the first coordinate gives $t=1$, which settles it.","No; the coordinate equations give different values of $t$.","Yes; the second coordinate gives $t=3/2$, which settles it."],"answer_mode":"server","feedback_revision":"da762e1d58851c8c07433a6e","time_limit":40},{"id":"la_batch14_parametric_representation_of_a_line_002_curated20261027_001","difficulty":"standard","question_type":"conceptual","question":"In $\\mathbb{R}^3$, let $\\boldsymbol{P}(s,t)=\\boldsymbol{A}+s\\boldsymbol{v}+t\\boldsymbol{w}$ with $s,t\\in\\mathbb{R}$, $\\boldsymbol{v}\\ne\\boldsymbol{0}$ and $\\boldsymbol{w}=2\\boldsymbol{v}$. What set of points does $\\boldsymbol{P}$ trace?","options":["A line through $\\boldsymbol{A}$","A plane through $\\boldsymbol{A}$","Only the point $\\boldsymbol{A}$","All of $\\mathbb{R}^3$"],"answer_mode":"server","feedback_revision":"c8d1a3b5cc02185ba53b1d69","time_limit":30}]}}