th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028+v3-2026-11-02+v3-2026-11-10+v3-2026-11-10+v3-2026-11-10+v3-2026-11-10+type-mix-retire-20261112+type-mix-topup-20261112+type-mix-retire2-20261112+fill-20261112+fill2-20261112","concept_id":"Year-1/1b-Math-II-Linear-Algebra/identity-matrix.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/identity-matrix.html","questions":[{"id":"la_batch4_identity_matrix_004","difficulty":"basic","question_type":"conceptual","question":"For an $m\\times n$ matrix $A$, which identity matrices leave $A$ unchanged by multiplication?","options":["$I_nA=A$ and $AI_m=A$ always.","$I_mA=A$ and $AI_n=A$.","$I_1A=A$ and $AI_1=A$ for every $A$.","$I_m+A=A$ and $A+I_n=A$."],"answer_mode":"server","feedback_revision":"5b4b0748ef1ec6880f5dda55","time_limit":30},{"id":"la_batch4_identity_matrix_006","difficulty":"basic","question_type":"application","question":"Which matrix is $I_2$?","options":["$\\begin{pmatrix}0&0\\\\0&0\\end{pmatrix}$","$\\begin{pmatrix}0&1\\\\1&0\\end{pmatrix}$","$\\begin{pmatrix}1&1\\\\1&1\\end{pmatrix}$","$\\begin{pmatrix}1&0\\\\0&1\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"7f83f4e8b30f8ec086fca9c1","time_limit":20},{"id":"la_batch4_identity_matrix_012","difficulty":"standard","question_type":"conceptual","question":"What does idempotent mean for the identity matrix?","options":["$I_n^{\\top}=0$.","$I_n^2=0$.","$I_n^2=I_n$.","$I_n+I_n=I_n$."],"answer_mode":"server","feedback_revision":"c12e79f46708f78e0c1248a9","time_limit":30},{"id":"la_batch4_identity_matrix_013","difficulty":"standard","question_type":"conceptual","question":"How is the identity matrix related to the identity map?","options":["It represents a map that changes the dimension of every vector.","It represents complex conjugation only.","It represents the map that sends each coordinate vector to itself.","It represents the map that sends every vector to zero."],"answer_mode":"server","feedback_revision":"66a6425342f8ee1b6311bbc9","time_limit":30},{"id":"la_batch4_identity_matrix_015","difficulty":"basic","question_type":"conceptual","question":"The identity matrix is a special case of which type of matrix?","options":["a diagonal matrix","a zero matrix","a non-square matrix","a singular matrix"],"answer_mode":"server","feedback_revision":"b420476c7cb45b411e48f5cf","time_limit":20},{"id":"la_batch4_identity_matrix_017_curated20261027_001","difficulty":"standard","question_type":"conceptual","question":"Is $\\boldsymbol{I}_n$ the identity element for addition of $n\\times n$ matrices?","options":["Yes: adding $\\boldsymbol{I}_n$ to any $n\\times n$ matrix leaves it unchanged.","Yes, but only when it is added to diagonal matrices.","No: $\\boldsymbol{I}_n$ is the identity for multiplication; for addition it is $\\boldsymbol{0}$.","No: $n\\times n$ matrices have no identity element for addition at all."],"answer_mode":"server","feedback_revision":"160b9bec233aca9f1e399f6d","time_limit":35},{"id":"year_1_1b_math_ii_linear_algebra_identity_matrix_421d235a_topup20261028_001","difficulty":"standard","question_type":"conceptual","question":"Let $\\boldsymbol{B}$ be a real $2\\times2$ matrix. Which condition on $\\boldsymbol{B}$ forces $\\boldsymbol{B}=\\boldsymbol{I}_2$?","options":["$\\boldsymbol{B}\\boldsymbol{A}=\\boldsymbol{A}$ for one nonzero real $2\\times2$ matrix $\\boldsymbol{A}$","$\\boldsymbol{B}\\boldsymbol{A}=\\boldsymbol{A}$ for every real $2\\times2$ matrix $\\boldsymbol{A}$","Both main-diagonal entries of $\\boldsymbol{B}$ are equal to $1$","$\\boldsymbol{B}^2=\\boldsymbol{B}$, as for the identity matrix"],"answer_mode":"server","feedback_revision":"f58cc3cd2aab6be5cea83486","time_limit":35},{"id":"year_1_1b_math_ii_linear_algebra_identity_matrix_421d235a_fill20261112_001","difficulty":"standard","question_type":"application","question":"Let $\\boldsymbol{A}$ be a real $n\\times n$ matrix and $\\boldsymbol{I}=\\boldsymbol{I}_n$. Which statement about $(\\boldsymbol{A}+\\boldsymbol{I})^2$ is correct?","options":["It equals $\\boldsymbol{A}^2+\\boldsymbol{I}$ for every $\\boldsymbol{A}$, as a sum is squared term by term.","It equals $\\boldsymbol{A}^2+2\\boldsymbol{A}+\\boldsymbol{I}$ only for diagonal $\\boldsymbol{A}$, as only they commute with $\\boldsymbol{I}$.","It equals $\\boldsymbol{A}^2+2\\boldsymbol{A}+\\boldsymbol{I}$ for every $\\boldsymbol{A}$, since $\\boldsymbol{A}\\boldsymbol{I}=\\boldsymbol{I}\\boldsymbol{A}=\\boldsymbol{A}$.","It equals $\\boldsymbol{A}^2+2\\boldsymbol{A}+\\boldsymbol{I}$, just as $(\\boldsymbol{A}+\\boldsymbol{B})^2=\\boldsymbol{A}^2+2\\boldsymbol{A}\\boldsymbol{B}+\\boldsymbol{B}^2$ for every $n\\times n$ matrix $\\boldsymbol{B}$."],"answer_mode":"server","feedback_revision":"719707f709a89d2be4dc0f35","time_limit":45},{"id":"year_1_1b_math_ii_linear_algebra_identity_matrix_421d235a_fill20261112_002","difficulty":"standard","question_type":"application","question":"A linear system of three equations in the two unknowns $x_1,x_2$ has, after Gauss-Jordan elimination, the augmented matrix $\\begin{pmatrix}1&0&2\\\\0&1&-3\\\\0&0&0\\end{pmatrix}$. Which statement about its solutions is correct?","options":["It has no unique solution, since its coefficient part has not become an identity matrix.","It has no solution, since there are more equations than unknowns.","It has infinitely many solutions, since the zero row gives a free variable.","It has the unique solution $x_1=2$, $x_2=-3$."],"answer_mode":"server","feedback_revision":"8e0818f7041a647057db65ae","time_limit":35}]}}