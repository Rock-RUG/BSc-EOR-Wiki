th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028+v3-2026-11-02+v3-2026-11-10+v3-2026-11-10+v3-2026-11-10+v3-2026-11-10+type-mix-retire-20261112+type-mix-topup-20261112+type-mix-retire2-20261112+fill-20261112+fill2-20261112","concept_id":"Year-1/1b-Math-II-Linear-Algebra/polynomial-long-division.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/polynomial-long-division.html","questions":[{"id":"la_batch21_polynomial_long_division_002","difficulty":"basic","question_type":"conceptual","question":"What degree condition must the remainder satisfy after dividing by $b(x)$?","options":["$\\deg r \\gt \\deg b$ always","$r(x)$ must be a nonzero constant","$r(x)=0$ or $\\deg r \\lt \\deg b$","$\\deg r=\\deg a$ always"],"answer_mode":"server","feedback_revision":"4e3fa6c0ab57f71eeffb96a5","time_limit":25},{"id":"la_batch21_polynomial_long_division_003","difficulty":"basic","question_type":"conceptual","question":"Why is the divisor $b(x)$ required to be nonzero?","options":["The quotient would then have to be a constant polynomial","The divisor must have a larger degree than the dividend","Division by the zero polynomial is not defined","With $b=0$ the remainder would always be $0$"],"answer_mode":"server","feedback_revision":"f209bd429c794d189d680480","time_limit":25},{"id":"la_batch21_polynomial_long_division_005","difficulty":"basic","question_type":"conceptual","question":"What does uniqueness mean in polynomial long division?","options":["The quotient is fixed, but several remainders can work.","Divisors of equal degree always give the same quotient.","The quotient and remainder are fixed by $a(x)$ and $b(x)$.","The pair is unique only when the remainder is zero."],"answer_mode":"server","feedback_revision":"298958c98756cba59de83f1c","time_limit":25},{"id":"la_batch21_polynomial_long_division_007","difficulty":"basic","question_type":"application","question":"Divide $x^2+1$ by $x+1$. What is the remainder?","options":["$x$","$x+1$","$2$","$0$"],"answer_mode":"server","feedback_revision":"a022659277b35c5231eb13fa","time_limit":20},{"id":"la_batch21_polynomial_long_division_009","difficulty":"basic","question_type":"application","question":"Which identity correctly expresses division of $a(x)$ by $b(x)$?","options":["$b(x)=q(x)a(x)+r(x)$","$a(x)=q(x)b(x)+r(x)$","$a(x)=q(x)+b(x)r(x)$","$r(x)=a(x)b(x)+q(x)$"],"answer_mode":"server","feedback_revision":"7101d995f08c2884ba8f1162","time_limit":20},{"id":"la_batch21_polynomial_long_division_012","difficulty":"standard","question_type":"conceptual","question":"Why is a field used as the coefficient system for polynomial long division?","options":["Leading coefficients need division by nonzero scalars.","A field guarantees every nonconstant polynomial has a root.","Over a field, every division leaves remainder zero.","A field is needed so that sums of polynomials stay polynomials."],"answer_mode":"server","feedback_revision":"724f653619dc65c96463d0f1","time_limit":30},{"id":"la_batch21_polynomial_long_division_013","difficulty":"standard","question_type":"conceptual","question":"What does a zero remainder tell us about $a(x)$ and $b(x)$?","options":["$a(x)$ and $b(x)$ have the same degree","Both polynomials are zero","$a(x)$ divides $b(x)$ automatically","$b(x)$ divides $a(x)$"],"answer_mode":"server","feedback_revision":"50f645b9c47f520cc1d97a06","time_limit":30},{"id":"la_batch21_polynomial_long_division_015","difficulty":"standard","question_type":"application","question":"Divide $x^2+3x+5$ by $x+1$. What is the quotient and remainder?","options":["Quotient $x+2$, remainder $3$","Quotient $x-1$, remainder $6$","Quotient $x+3$, remainder $2$","Quotient $x+2$, remainder $5$"],"answer_mode":"server","feedback_revision":"3380b5115045913658d9856e","time_limit":30},{"id":"la_batch21_polynomial_long_division_016","difficulty":"standard","question_type":"application","question":"If dividing $a(x)$ by a quadratic $b(x)$ gives a nonzero remainder, which form is possible for the remainder?","options":["$b(x)+1$","$x^3$","$x^2+1$","$3x-1$"],"answer_mode":"server","feedback_revision":"2510897cacde1ee98e444152","time_limit":30},{"id":"la_batch21_polynomial_long_division_020","difficulty":"challenge","question_type":"application","question":"A student claims that polynomial long division is complete with $a(x)=q(x)b(x)+r(x)$, where $\\deg b=3$ and $r(x)=x^3+1$. Which requirement for a valid remainder is violated?","options":["The remainder must be a constant polynomial.","The remainder degree is not less than $\\deg b$.","The quotient must have degree below $\\deg b$.","The remainder must have degree below $\\deg a$."],"answer_mode":"server","feedback_revision":"13ee75aa70eef8392e5a8698","time_limit":40},{"id":"year_1_1b_math_ii_linear_algebra_polynomial_long_division_fedb0679_typemix20261112_001","difficulty":"standard","question_type":"application","question":"Divide $a(x)=x^3-2$ by $b(x)=x^2+x$ in $\\mathbb{R}[x]$. What are the quotient $q(x)$ and the remainder $r(x)$?","options":["$q(x)=x$, $r(x)=-x^2-2$","$q(x)=x-1$, $r(x)=x-2$","$q(x)=x-1$, $r(x)=-x-2$","$q(x)=x-3$, $r(x)=3x$"],"answer_mode":"server","feedback_revision":"c31b49e08475099244d3933c","time_limit":30},{"id":"year_1_1b_math_ii_linear_algebra_polynomial_long_division_fedb0679_typemix20261112_002","difficulty":"standard","question_type":"application","question":"What is the remainder when $a(x)=8x^3+4x-1$ is divided by $b(x)=2x+1$ in $\\mathbb{R}[x]$?","options":["$-1$","$2$","$-4$","$-13$"],"answer_mode":"server","feedback_revision":"6926d8a9f4825aa14afc5727","time_limit":30},{"id":"year_1_1b_math_ii_linear_algebra_polynomial_long_division_fedb0679_fill220261112_001","difficulty":"basic","question_type":"application","question":"In $\\mathbb{R}[x]$, polynomial long division of $a(x)=x+1$ by $b(x)=x^2+1$ is to produce the quotient $q(x)$ and the remainder $r(x)$. What are they?","options":["No quotient and remainder exist, since $\\deg a<\\deg b$","$q(x)=\\tfrac{1}{x}$ and $r(x)=1-\\tfrac{1}{x}$","$q(x)=1$ and $r(x)=-x^2+x$","$q(x)=0$ and $r(x)=x+1$"],"answer_mode":"server","feedback_revision":"d27f1d949784b85607bd98e6","time_limit":35},{"id":"year_1_1b_math_ii_linear_algebra_polynomial_long_division_fedb0679_fill220261112_002","difficulty":"basic","question_type":"application","question":"Let $a(x),b(x)\\in\\mathbb{R}[x]$ with $\\deg a=6$ and $\\deg b=2$, and let $q(x)$ be the quotient when $a$ is divided by $b$. What is $\\deg q$?","options":["$3$","$4$","$8$","$1$"],"answer_mode":"server","feedback_revision":"836acf0b17a9376279c8d7f0","time_limit":30}]}}