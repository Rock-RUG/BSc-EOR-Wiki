a8541463a33b0f6031c8d03d"},{"id":"la_batch22_cardinality_of_the_continuum_003","difficulty":"basic","question_type":"conceptual","question":"How does $\\mathfrak c$ compare with countable infinity?","options":["It is smaller than every infinite cardinal","It is equal to $\\aleph_0$","It is larger than countable infinity","It is a finite number"],"answer_mode":"server","feedback_revision":"7503a34732a3d3dcaad372a5"},{"id":"la_batch22_cardinality_of_the_continuum_004","difficulty":"basic","question_type":"conceptual","question":"Which set is a standard example with cardinality $\\mathfrak c$?","options":["$\\mathbb N$","$[0,1]$","$\\mathbb Z$","Any two-element set"],"answer_mode":"server","feedback_revision":"62d3f10f3e97a0099aeb1cf3"},{"id":"la_batch22_cardinality_of_the_continuum_005","difficulty":"basic","question_type":"conceptual","question":"What is the relationship between $2^{\\mathbb N}$ and $\\mathfrak c$?","options":["$2^{\\mathbb N}$ has no cardinality","$\\operatorname{card}(2^{\\mathbb N})=\\mathfrak c$","$2^{\\mathbb N}$ is finite","$\\operatorname{card}(2^{\\mathbb N})=\\aleph_0$"],"answer_mode":"server","feedback_revision":"f755a401a12b389271b2e453"},{"id":"la_batch22_cardinality_of_the_continuum_006","difficulty":"basic","question_type":"application","question":"What is $\\operatorname{card}(\\mathbb R)$?","options":["$1$","$0$","$\\aleph_0$","$\\mathfrak c$"],"answer_mode":"server","feedback_revision":"8982341b4d06b7138f73dddc"},{"id":"la_batch22_cardinality_of_the_continuum_007","difficulty":"basic","question_type":"application","question":"What is the cardinality of $[0,1]$?","options":["$0$","$\\aleph_0$","$\\mathfrak c$","$2$"],"answer_mode":"server","feedback_revision":"ef207edc24d129d0559389d6"},{"id":"la_batch22_cardinality_of_the_continuum_008","difficulty":"basic","question_type":"application","question":"Which set has cardinality $\\aleph_0$, not $\\mathfrak c$, among the following?","options":["$[0,1]$","$2^{\\mathbb N}$","$\\mathbb N$","$\\mathbb R$"],"answer_mode":"server","feedback_revision":"78b3fc8c09e59a41455ee487"},{"id":"la_batch22_cardinality_of_the_continuum_009","difficulty":"basic","question_type":"application","question":"If a set $A$ is in bijection with $\\mathbb R$, what is $\\operatorname{card}(A)$?","options":["$0$","$\\operatorname{card}(\\mathbb N)$","$\\aleph_0$","$\\mathfrak c$"],"answer_mode":"server","feedback_revision":"4d5a1a7bc0fc0ddc8f15bf41"},{"id":"la_batch22_cardinality_of_the_continuum_010","difficulty":"basic","question_type":"application","question":"What is $2^{\\aleph_0}$ equal to?","options":["$0$","$\\mathfrak c$","$\\aleph_0$","$1$"],"answer_mode":"server","feedback_revision":"78205ee81baf29740204812b"},{"id":"la_batch22_cardinality_of_the_continuum_011","difficulty":"standard","question_type":"conceptual","question":"Why is $\\mathfrak c$ not just another notation for $\\aleph_0$?","options":["$\\mathfrak c$ counts only finitely many real numbers","$\\aleph_0$ is the cardinality of $\\mathbb R$","The symbols are written differently but mean the same cardinality","Cantor's diagonal argument shows the real line is uncountable"],"answer_mode":"server","feedback_revision":"c9a30457ec4c814072d74b1e"},{"id":"la_batch22_cardinality_of_the_continuum_012","difficulty":"standard","question_type":"conceptual","question":"What does the identity $\\operatorname{card}(2^{\\mathbb N})=\\operatorname{card}(\\mathbb R)$ tell us?","options":["Subsets of $\\mathbb N$ and real numbers have the same cardinality","There are only countably many subsets of $\\mathbb N$","Every subset of $\\mathbb N$ is a real number without encoding","The real numbers are finite"],"answer_mode":"server","feedback_revision":"3017f33178e2a6b52e7459e9"},{"id":"la_batch22_cardinality_of_the_continuum_013","difficulty":"standard","question_type":"conceptual","question":"Why are bijections mentioned when defining $\\mathfrak c$?","options":["Bijections prove other sets share $\\mathbb R$'s cardinality.","Bijections are needed only for finite sets","Bijections turn real numbers into natural numbers.","Bijections define addition on real numbers"],"answer_mode":"server","feedback_revision":"6444061c569fe836db3f6e4d"},{"id":"la_batch22_cardinality_of_the_continuum_014","difficulty":"standard","question_type":"application","question":"Which chain of equalities holds for $\\mathfrak c$?","options":["$\\operatorname{card}(2^{\\mathbb N})=2^{\\aleph_0}=\\operatorname{card}(\\mathbb R)=\\mathfrak c$","$\\operatorname{card}(2^{\\mathbb N})=\\aleph_0 \\lt \\mathfrak c$","$\\mathfrak c=0=1$","$\\operatorname{card}(\\mathbb N)=\\operatorname{card}(\\mathbb R)=\\mathfrak c$"],"answer_mode":"server","feedback_revision":"f4df5829d34911e2e3014540"},{"id":"la_batch22_cardinality_of_the_continuum_015","difficulty":"standard","question_type":"application","question":"A set $B$ is known to have the same cardinality as $2^{\\mathbb N}$. What cardinality should be assigned to $B$?","options":["$\\mathfrak c$","$\\aleph_0$","$\\operatorname{card}(\\varnothing)$","$2$"],"answer_mode":"server","feedback_revision":"87ca56d351dda9eda2fa5c48"},{"id":"la_batch22_cardinality_of_the_continuum_016","difficulty":"standard","question_type":"application","question":"Which comparison is correct?","options":["$\\mathfrak c=\\operatorname{card}(\\mathbb N)$","$\\operatorname{card}([0,1])=\\aleph_0$","$\\mathfrak c \\lt \\operatorname{card}(\\mathbb N)$","$\\operatorname{card}(\\mathbb N) \\lt \\mathfrak c$"],"answer_mode":"server","feedback_revision":"8a1038a9af52a1d0672531bc"},{"id":"la_batch22_cardinality_of_the_continuum_017","difficulty":"challenge","question_type":"conceptual","question":"What question does the continuum hypothesis ask using $\\aleph_0$ and $\\mathfrak c$?","options":["Whether $\\mathfrak c$ is smaller than every finite number","Whether both symbols denote finite sets","Whether there is a cardinality strictly between them","Whether $\\aleph_0$ is the cardinality of $\\mathbb R$"],"answer_mode":"server","feedback_revision":"21923bb2c581545a1ce05a71"},{"id":"la_batch22_cardinality_of_the_continuum_018","difficulty":"challenge","question_type":"conceptual","question":"Why does knowing that $[0,1]$ has cardinality $\\mathfrak c$ not make $[0,1]$ a countable list?","options":["$\\mathfrak c$ is uncountable, larger than $\\aleph_0$","Every real interval is countably infinite","Cardinality ignores all elements of an interval","Every interval is finite"],"answer_mode":"server","feedback_revision":"4a54c2c6300025a51ade62c3"},{"id":"la_batch22_cardinality_of_the_continuum_019","difficulty":"challenge","question_type":"application","question":"Classify the cardinalities of $\\mathbb N$, $\\mathbb Q$, and $\\mathbb R$ in the order shown.","options":["$\\aleph_0,\\ \\aleph_0,\\ \\mathfrak c$","$\\mathfrak c,\\ \\mathfrak c,\\ \\aleph_0$","$\\mathfrak c,\\ \\aleph_0,\\ \\aleph_0$","$\\aleph_0,\\ \\mathfrak c,\\ \\mathfrak c$"],"answer_mode":"server","feedback_revision":"3280c6470613461543bfb7d3"},{"id":"la_batch22_cardinality_of_the_continuum_020","difficulty":"challenge","question_type":"application","question":"If a set $A$ satisfies $\\operatorname{card}(A)=\\operatorname{card}([0,1])$, what is $\\operatorname{card}(A)$?","options":["$\\operatorname{card}(\\mathbb Z)$","$\\aleph_0$","$\\mathfrak c$","$1$"],"answer_mode":"server","feedback_revision":"ad28a94a5ee3d3d481b6fdae"}]}}