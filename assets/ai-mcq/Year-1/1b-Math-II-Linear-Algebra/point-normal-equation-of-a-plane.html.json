th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028+v3-2026-11-02+v3-2026-11-10+v3-2026-11-10+v3-2026-11-10+v3-2026-11-10+type-mix-retire-20261112+type-mix-topup-20261112+type-mix-retire2-20261112+fill-20261112+fill2-20261112","concept_id":"Year-1/1b-Math-II-Linear-Algebra/point-normal-equation-of-a-plane.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/point-normal-equation-of-a-plane.html","questions":[{"id":"la_batch14_point_normal_equation_of_a_plane_001","difficulty":"basic","question_type":"conceptual","question":"What does the point-normal equation say about a displacement vector lying in the plane?","options":["It is parallel to the normal vector.","It is perpendicular to the normal vector.","It must have length one.","It must be the zero vector."],"answer_mode":"server","feedback_revision":"884c44045de7baa134327864","time_limit":20},{"id":"la_batch14_point_normal_equation_of_a_plane_005","difficulty":"basic","question_type":"conceptual","question":"How is the normal vector read from $2x-3y+z=5$?","options":["It is $(2,3,5)$.","It is $(2,-3,1)$.","It is $(5,5,5)$.","It is $(x,y,z)$."],"answer_mode":"server","feedback_revision":"d68269708a09adc47e5558ef","time_limit":20},{"id":"la_batch14_point_normal_equation_of_a_plane_006","difficulty":"basic","question_type":"application","question":"A plane passes through $(0,0,0)$ with normal $(0,0,1)$. What is its equation?","options":["$x=0$","$z=0$","$y=0$","$x+y+z=1$"],"answer_mode":"server","feedback_revision":"585d34e8ea087357fa6e74e0","time_limit":20},{"id":"la_batch14_point_normal_equation_of_a_plane_010","difficulty":"basic","question_type":"application","question":"What is $d$ for the plane $2x+y-z=d$ passing through $(1,3,2)$?","options":["$6$","$0$","$3$","$1$"],"answer_mode":"server","feedback_revision":"d0e3208c3fec24c3a7d8a4c0","time_limit":20},{"id":"la_batch14_point_normal_equation_of_a_plane_013","difficulty":"standard","question_type":"conceptual","question":"What happens if the coefficient vector $(a,b,c)$ is zero in $ax+by+cz=d$?","options":["It always gives the $xy$-plane.","It gives a unique point.","It gives a normal vector of length one, which fixes the plane.","The equation no longer determines an ordinary plane."],"answer_mode":"server","feedback_revision":"88cf8d61758095c1f6bb429a","time_limit":30},{"id":"la_batch14_point_normal_equation_of_a_plane_014","difficulty":"standard","question_type":"application","question":"Write the point-normal equation for the plane through $(1,2,3)$ with normal $(2,-1,4)$.","options":["$2x-y+4z=0$","$(x-2)+2(y+1)+3(z-4)=0$","$2(x-1)-(y-2)+4(z-3)=0$","$2(x+1)-y+2+4(z+3)=0$"],"answer_mode":"server","feedback_revision":"ffabe6c94d19aa649e23ef9f","time_limit":30},{"id":"la_batch14_point_normal_equation_of_a_plane_015","difficulty":"standard","question_type":"application","question":"Rewrite $2(x-1)-(y-2)+4(z-3)=0$ as $ax+by+cz=d$.","options":["$2x+y+4z=12$","$x-2y+4z=12$","$2x-y+4z=0$","$2x-y+4z=12$"],"answer_mode":"server","feedback_revision":"26ed2ffccc1cde935fb6af6e","time_limit":30},{"id":"la_batch14_point_normal_equation_of_a_plane_016","difficulty":"standard","question_type":"application","question":"Which point lies on the plane $2x-y+z=3$?","options":["$(2,0,0)$","$(1,1,1)$","$(1,0,1)$","$(0,0,0)$"],"answer_mode":"server","feedback_revision":"715b5c3b5f66521aa0883ed0","time_limit":30},{"id":"la_batch14_point_normal_equation_of_a_plane_017","difficulty":"challenge","question_type":"conceptual","question":"Why does the point-normal equation describe an infinite set of points rather than just the fixed point $(x_0,y_0,z_0)$?","options":["Many displacement vectors can be perpendicular to the same normal vector.","Only the zero displacement is perpendicular to a normal vector.","The fixed point is not actually on the plane.","The equation forces $x=x_0$, $y=y_0$, and $z=z_0$."],"answer_mode":"server","feedback_revision":"9903773e94134525ed4347d4","time_limit":40},{"id":"la_batch14_point_normal_equation_of_a_plane_018","difficulty":"challenge","question_type":"conceptual","question":"Why does the equation $ax+by+cz=d$ determine the normal direction but not a unique normal vector?","options":["The normal vector is unique only when $d=0$.","Any vector lying in the plane can serve as a normal vector.","Any vector as long as $(a,b,c)$ is also a normal vector.","Any nonzero multiple of $(a,b,c)$ is also a normal vector."],"answer_mode":"server","feedback_revision":"528556983c48fd1a1f9498ee","time_limit":40},{"id":"la_batch14_point_normal_equation_of_a_plane_020","difficulty":"challenge","question_type":"application","question":"Which vector lies in the plane direction space of $2x-y+z=3$?","options":["$(1,3,1)$","$(0,0,3)$","$(2,-1,1)$","$(1,0,0)$"],"answer_mode":"server","feedback_revision":"721faf2e7ee0e12bbb5ff868","time_limit":40},{"id":"year_1_1b_math_ii_linear_algebra_point_normal_equation_of_a_plane_10f5f285_fill220261112_001","difficulty":"standard","question_type":"application","question":"Which equation describes the plane in $\\mathbb{R}^3$ through the three points $\\boldsymbol{A}=(1,0,0)$, $\\boldsymbol{B}=(1,2,0)$ and $\\boldsymbol{C}=(0,0,3)$?","options":["$x+3z=1$","$2x-y=2$","$3x+z=0$","$3x+z=3$"],"answer_mode":"server","feedback_revision":"df439e0e99d7274d0d462e06","time_limit":30},{"id":"year_1_1b_math_ii_linear_algebra_point_normal_equation_of_a_plane_10f5f285_fill220261112_002","difficulty":"standard","question_type":"application","question":"How are the planes $\\Pi_1\\colon 2x-y+z=3$ and $\\Pi_2\\colon -4x+2y-2z=6$ in $\\mathbb{R}^3$ related?","options":["They are the same plane, because $(-4,2,-2)=-2\\,(2,-1,1)$.","They are distinct parallel planes, because dividing $\\Pi_2$ by $-2$ gives $2x-y+z=-3$.","They meet in a line, because their normal vectors point in opposite directions.","They are distinct parallel planes, because their right-hand sides $3$ and $6$ differ."],"answer_mode":"server","feedback_revision":"0e6fc9a586a471a4c3c37c08","time_limit":35},{"id":"year_1_1b_math_ii_linear_algebra_point_normal_equation_of_a_plane_10f5f285_fill220261112_003","difficulty":"standard","question_type":"application","question":"In $\\mathbb{R}^3$, where does the line $\\boldsymbol{\\ell}(t)=(1,0,2)+t(1,1,-1)$, $t\\in\\mathbb{R}$, meet the plane $2x-y+z=3$?","options":["Nowhere: substituting gives $4=3$ for every $t$, so the line is parallel to the plane.","The whole line lies in the plane, because $(1,1,-1)$ is orthogonal to the normal $(2,-1,1)$.","In exactly one point, since every line meets a plane in exactly one point.","In the single point $\\boldsymbol{\\ell}(-1)=(0,-1,3)$, from solving $4+t=3$."],"answer_mode":"server","feedback_revision":"9c76db43856dca2792cab3f5","time_limit":40}]}}