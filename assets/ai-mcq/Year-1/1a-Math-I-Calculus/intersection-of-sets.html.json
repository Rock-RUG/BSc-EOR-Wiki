lication","question":"Compute $\\{1,2,3\\}\\cap(\\{2,3,4\\}\\cap\\{3,4,5\\})$.","options":["$\\{2,3\\}$","$\\{3,4\\}$","$\\{3\\}$","$\\{1,2,3,4,5\\}$"],"answer_mode":"server","feedback_revision":"d42e1c2162c2a6cd46b1e873","time_limit":30},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_008","difficulty":"standard","question_type":"application","question":"If $x\\in A\\cap B$ and $B\\cap C = \\varnothing$, what can be concluded about $x\\in C$?","options":["$x\\notin C$","$x\\in C$","$x\\in A\\cap C$ necessarily.","$x$ is not an element of $B$."],"answer_mode":"server","feedback_revision":"ff0b29bcfb0e488451a46054","time_limit":30},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_017","difficulty":"basic","question_type":"application","question":"If $A=\\{x\\in\\mathbb{R}\\colon x\\geq0\\}$ and $B=\\{x\\in\\mathbb{R}\\colon x\\leq0\\}$, what is $A\\cap B$?","options":["$\\mathbb{R}$","$\\varnothing$","$\\{0\\}$","$(0,+\\infty)$"],"answer_mode":"server","feedback_revision":"51b294649867145fa1593ef6","time_limit":20},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_005_curated20261027_001","difficulty":"standard","question_type":"conceptual","question":"The notation $\\{x\\in A\\colon x\\in B\\}$ starts from $A$ and keeps the elements that lie in $B$. How does it compare with $\\{x\\in B\\colon x\\in A\\}$?","options":["They are always equal, both being $A\\cap B$","They differ: one lies in $A$, the other in $B$","They are equal only if $A\\subseteq B$","They are equal only if $A=B$"],"answer_mode":"server","feedback_revision":"37cee6932f4ac5ef853d190b","time_limit":35},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_009_curated20261027_002","difficulty":"basic","question_type":"conceptual","question":"For an arbitrary set $A$, what is $A\\cap\\varnothing$?","options":["$\\varnothing$","$A$","$\\{\\varnothing\\}$","Undefined, as $\\varnothing$ has no elements"],"answer_mode":"server","feedback_revision":"0966c4d6aca663b5097d444a","time_limit":20},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_010_curated20261027_003","difficulty":"standard","question_type":"conceptual","question":"Which condition is equivalent to $x\\notin A\\cap B$?","options":["$x\\notin A$ and $x\\notin B$","$x\\notin A$ or $x\\notin B$","$x\\notin A$","$x\\in A$ and $x\\notin B$"],"answer_mode":"server","feedback_revision":"f512bafeff8ffb31f1d598b6","time_limit":30},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_011_curated20261027_004","difficulty":"standard","question_type":"conceptual","question":"Which identity holds for all sets $A$, $B$, $C$?","options":["$A\\cap(B\\cup C)=(A\\cap B)\\cup(A\\cap C)$","$A\\cap(B\\cup C)=A\\cap B\\cap C$","$A\\cap(B\\cup C)=A\\cup B\\cup C$","$A\\cap(B\\cup C)=(A\\cup B)\\cap C$"],"answer_mode":"server","feedback_revision":"e7e45b5b57d3b9e399be3c5a","time_limit":30},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_013_curated20261027_005","difficulty":"basic","question_type":"conceptual","question":"How does $A\\cap B$ relate to $A$ as sets, for all sets $A$ and $B$?","options":["$A\\cap B\\subseteq A$","$A\\subseteq A\\cap B$","$A\\cap B=A\\cup B$","$A\\cap B$ and $A$ are disjoint"],"answer_mode":"server","feedback_revision":"65edb444c44bf013df62308f","time_limit":25},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_019_curated20261027_006","difficulty":"standard","question_type":"conceptual","question":"For sets $A$ and $B$, the condition $A\\cap B=A$ is equivalent to which relation?","options":["$A\\subseteq B$","$B\\subseteq A$","$A=B$","$A\\cap B=\\varnothing$"],"answer_mode":"server","feedback_revision":"839382bbc59adccacb910621","time_limit":30}]}}