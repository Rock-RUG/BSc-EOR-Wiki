n $\\neg(x\\in A)$.","Implication, as in $(x\\in A)\\Rightarrow(x\\in B)$."],"answer_mode":"server","feedback_revision":"bd9fa5fa41f0e82fab45cfc2"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_003","difficulty":"basic","question_type":"application","question":"Compute $\\{1,2,3\\}\\cap\\{2,3,4\\}$.","options":["$\\{1,4\\}$","$\\{1,2,3,4\\}$","$\\varnothing$","$\\{2,3\\}$"],"answer_mode":"server","feedback_revision":"1f605c1ce8e60d6eb2e3909f"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_004","difficulty":"basic","question_type":"conceptual","question":"What does $A\\cap B=\\varnothing$ say about $A$ and $B$?","options":["They are disjoint.","They are equal.","One contains the other.","They are both empty."],"answer_mode":"server","feedback_revision":"71a561c294af50c59199728a"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_005","difficulty":"standard","question_type":"conceptual","question":"Which property holds for intersection?","options":["$A\\cap B = B\\cap A$","$A\\cap B = A\\cup B$","$A\\cap B = \\varnothing$ for all sets $A$ and $B$","$A\\cap B = A$ for all sets $A$ and $B$"],"answer_mode":"server","feedback_revision":"6c5aa93fe1b5f34435eb1260"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_006","difficulty":"standard","question_type":"conceptual","question":"What does associativity of intersection say?","options":["$A\\cap(B\\cap C) = (A\\cap B)\\cap C$","$A\\cap(B\\cap C) = A\\cup B\\cup C$","$A\\cap(B\\cap C) = \\varnothing$ always.","$A\\cap(B\\cap C) = B$ always."],"answer_mode":"server","feedback_revision":"09faaf7d083b8e3996cab05f"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_007","difficulty":"standard","question_type":"application","question":"Compute $\\{1,2,3\\}\\cap(\\{2,3,4\\}\\cap\\{3,4,5\\})$.","options":["$\\{2,3\\}$","$\\{3,4\\}$","$\\{3\\}$","$\\{1,2,3,4,5\\}$"],"answer_mode":"server","feedback_revision":"d42e1c2162c2a6cd46b1e873"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_008","difficulty":"standard","question_type":"application","question":"If $x\\in A\\cap B$ and $B\\cap C = \\varnothing$, what can be concluded about $x\\in C$?","options":["$x\\notin C$","$x\\in C$","$x\\in A\\cap C$ necessarily.","$x$ is not an element of $B$."],"answer_mode":"server","feedback_revision":"ff0b29bcfb0e488451a46054"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_009","difficulty":"challenge","question_type":"conceptual","question":"What is $A\\cap\\varnothing$ for an arbitrary set $A$?","options":["$A\\cap\\varnothing = A$ for every set $A$.","$A\\cap\\varnothing = \\varnothing$ for every set $A$.","$A\\cap\\varnothing$ contains one element.","$A\\cap\\varnothing$ is undefined."],"answer_mode":"server","feedback_revision":"bb935eddbe5c4169716a15bb"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_010","difficulty":"challenge","question_type":"conceptual","question":"Which condition is equivalent to $x\\notin A\\cap B$?","options":["$x\\notin A$ and $x\\notin B$.","$x\\notin A$ or $x\\notin B$.","$x\\in A$ and $x\\in B$.","$x\\in A\\cap B$."],"answer_mode":"server","feedback_revision":"50cfc5fa0d346922bb0bd854"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_011","difficulty":"challenge","question_type":"conceptual","question":"Which identity is the distributive law of intersection over union?","options":["$A\\cap(B\\cup C)=(A\\cap B)\\cup(A\\cap C)$","$A\\cap(B\\cup C)=A\\cap B\\cap C$","$A\\cap(B\\cup C)=A\\cup B\\cup C$","$A\\cap(B\\cup C)=(A\\cup B)\\cap C$"],"answer_mode":"server","feedback_revision":"ec9247c8107f8ac54de21e2d"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_012","difficulty":"challenge","question_type":"application","question":"If $A\\cap B = A$ and $x\\in A$, what follows directly about $x$?","options":["$x\\notin B$","$x\\in\\varnothing$","$x\\in B$","$x\\notin A$"],"answer_mode":"server","feedback_revision":"7c949097f1e1b51aa1324570"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_013","difficulty":"standard","question_type":"conceptual","question":"How does $A\\cap B$ relate to $A$ as sets?","options":["$A\\cap B\\subseteq A$","$A\\subseteq A\\cap B$","$A\\cap B=A\\cup B$","$A\\cap B$ and $A$ are disjoint"],"answer_mode":"server","feedback_revision":"e9ae7a985d197a1059371482"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_014","difficulty":"basic","question_type":"conceptual","question":"What is $A\\cap A$?","options":["$A$","$\\varnothing$","a set with twice the elements","undefined"],"answer_mode":"server","feedback_revision":"70f3f43626e84a6e53da042e"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_015","difficulty":"basic","question_type":"conceptual","question":"What is the key difference between $A\\cap B$ and $A\\cup B$?","options":["Intersection uses 'and'; union uses inclusive 'or'.","Both need membership in both sets.","Both need membership in at least one set.","Intersection uses 'or', while union uses 'and'."],"answer_mode":"server","feedback_revision":"56b6e3708fba903eeb919a36"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_016","difficulty":"basic","question_type":"application","question":"Compute $\\{1,3,5\\}\\cap\\{3,5,7\\}$.","options":["$\\{1,7\\}$","$\\{1,3,5,7\\}$","$\\varnothing$","$\\{3,5\\}$"],"answer_mode":"server","feedback_revision":"c627330e996df3a539164b5a"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_017","difficulty":"basic","question_type":"application","question":"If $A=\\{x\\in\\mathbb R:x\\geq0\\}$ and $B=\\{x\\in\\mathbb R:x\\leq0\\}$, what is $A\\cap B$?","options":["$\\mathbb R$","$\\varnothing$","$\\{0\\}$","$(0,+\\infty)$"],"answer_mode":"server","feedback_revision":"167d2db5ee57b78f06ed36c8"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_018","difficulty":"basic","question_type":"application","question":"If $x\\in A$ but $x\\notin B$, what can be said about $x\\in A\\cap B$?","options":["$x\\in A\\cap B$","$A\\cap B=A$","$x\\notin A\\cap B$","$A\\cap B=B$"],"answer_mode":"server","feedback_revision":"77f7a30c755c6dfe04004d65"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_019","difficulty":"challenge","question_type":"conceptual","question":"The condition $A\\cap B=A$ is equivalent to which relation?","options":["$A\\subseteq B$","$B\\subseteq A$","$A=B$","$A\\cap B=\\varnothing$"],"answer_mode":"server","feedback_revision":"094be43dc4ec757d7b48dbe4"},{"id":"year_1_1a_math_i_calculus_intersection_of_sets_3b570899_020","difficulty":"standard","question_type":"application","question":"Let $A=\\{1,2,3\\}$, $B=\\{2,3,4\\}$, and $C=\\{3,4,5\\}$. What is $A\\cap B\\cap C$?","options":["$\\{2,3\\}$","$\\{3,4\\}$","$\\varnothing$","$\\{3\\}$"],"answer_mode":"server","feedback_revision":"4d34c4a760d70cf639ab9b64"}]}}