th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1a-Math-I-Calculus/exponential-function.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/exponential-function.html","questions":[{"id":"year_1_1a_math_i_calculus_exponential_function_560ecff2_001","difficulty":"basic","question_type":"conceptual","question":"Which form defines an exponential function?","options":["$f(x) = a+bx$ with $b \\gt 0$","$f(x) = a/b^x$ with $b = 0$","$f(x) = x^a+b$ with no base","$f(x) = ab^x$ with $b \\gt 0$"],"answer_mode":"server","feedback_revision":"2979ebaaacf96cf5ddacca68","time_limit":25},{"id":"year_1_1a_math_i_calculus_exponential_function_560ecff2_004","difficulty":"basic","question_type":"application","question":"Which example describes exponential decay?","options":["$f(x) = 2^x$","$f(x) = x^2$","$f(x) = \\sqrt{x}$","$f(x) = \\mathrm{e}^{-x}$"],"answer_mode":"server","feedback_revision":"518a0309e38c7a0fad7cb8e8","time_limit":20},{"id":"expansion_pack_020_exponential_function_new_005","difficulty":"basic","question_type":"application","question":"Which base is allowed in $ab^x$ by the definition?","options":["$b=0$","$b=-2$","$b=1/2$","No base is allowed"],"answer_mode":"server","feedback_revision":"ba91d4d25e7f5e6dfd67f48a","time_limit":20},{"id":"expansion_pack_020_exponential_function_new_006","difficulty":"basic","question_type":"application","question":"What is the derivative of the natural exponential function $\\mathrm{e}^x$?","options":["$0$","$\\mathrm{e}^x$","$x\\mathrm{e}^{x-1}$","$1/x$"],"answer_mode":"server","feedback_revision":"3147e77f61867a83fab5cb24","time_limit":20},{"id":"year_1_1a_math_i_calculus_exponential_function_560ecff2_003_curated20261027_001","difficulty":"challenge","question_type":"conceptual","question":"Which statement comparing the exponential function $2^x$ with the power function $x^2$ is correct?","options":["$2^3<3^2$, but $2^x>x^2$ for all $x>4$.","$2^x\\ge x^2$ for all $x\\ge0$.","$x^2>2^x$ for all $x>2$.","For $x>0$, $2^x=x^2$ holds only at $x=2$."],"answer_mode":"server","feedback_revision":"f2bb2492bda7435e3e47ba8d","time_limit":40},{"id":"year_1_1a_math_i_calculus_exponential_function_560ecff2_005_curated20261027_002","difficulty":"standard","question_type":"conceptual","question":"Let $f(x)=ab^x$ with $b>0$ and $a\\ne0$. Which statement holds for every real $x$?","options":["$f(x)$ has the same sign as $a$.","$f(x)>0$, because $b^x>0$.","$f(x)>0$ if $b>1$, and $f(x)<0$ if $0<b<1$.","$f(x)$ has the sign of $a$ for $x>0$ only."],"answer_mode":"server","feedback_revision":"2714b370fdc682f6e37cbdfa","time_limit":35},{"id":"expansion_pack_020_exponential_function_new_003_curated20261027_003","difficulty":"basic","question_type":"application","question":"Let $f(x)=5\\cdot3^x$, so that $f(1)=15$ and $f(2)=45$. What is $f(3)$?","options":["$135$","$75$","$48$","$225$"],"answer_mode":"server","feedback_revision":"f385158c97c467e91a5f9e2f","time_limit":25},{"id":"year_1_1a_math_i_calculus_exponential_function_560ecff2_topup20261028_001","difficulty":"basic","question_type":"conceptual","question":"Exponential functions are the functions $f(x)=ab^x$ with a constant $a$ and a base $b>0$. Which statement about the base $b=1$ is correct?","options":["It is allowed, and then $f(x)=a$ for every real $x$.","It is excluded, since an exponential base needs $b\\neq1$.","It is allowed, and then the logarithm with base $1$ inverts $f$.","It is allowed, and it gives growth, as every base $b\\geq1$ does."],"answer_mode":"server","feedback_revision":"cb52ca60f16c88856a7d9f90","time_limit":40},{"id":"year_1_1a_math_i_calculus_exponential_function_560ecff2_topup20261028_002","difficulty":"standard","question_type":"conceptual","question":"Consider the graphs of $y=2^x$ and $y=\\left(\\frac{1}{2}\\right)^x$ for all real $x$. Which statement about these two graphs is correct?","options":["They are mirror images in the $x$-axis, since $\\frac{1}{2}<1$.","They are mirror images in the line $y=x$, since the bases are reciprocal.","They are mirror images in the $y$-axis and meet only at $(0,1)$.","The graph of $\\left(\\frac{1}{2}\\right)^x$ falls below the $x$-axis for large $x$."],"answer_mode":"server","feedback_revision":"21d06277852e82f793b86b86","time_limit":40},{"id":"year_1_1a_math_i_calculus_exponential_function_560ecff2_topup20261028_003","difficulty":"standard","question_type":"application","question":"Using $\\mathrm{e}^{\\ln b}=b$ for $b>0$ and the exponent laws, which expression equals $2^x$ for every real $x$?","options":["$\\mathrm{e}^{2x}$","$\\mathrm{e}^{x/\\ln 2}$","$2\\mathrm{e}^{x}$","$\\mathrm{e}^{x\\ln 2}$"],"answer_mode":"server","feedback_revision":"657d6bc8ae9ae357987ade7a","time_limit":30}]}}