":30},{"id":"year_1_1a_math_i_calculus_division_and_quotient_0f5277ef_topup20261028_002","difficulty":"basic","question_type":"application","question":"Using $x/y=x\\times y^{-1}$ for real $x$ and $y\\neq0$, what is $6/(2/3)$?","options":["$4$","$\\frac{1}{9}$","$1$","$9$"],"answer_mode":"server","feedback_revision":"5e5de76f124577bb38db0b98","time_limit":25}]}}