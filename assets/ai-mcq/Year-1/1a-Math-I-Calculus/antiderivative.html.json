th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1a-Math-I-Calculus/antiderivative.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/antiderivative.html","questions":[{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_001","difficulty":"basic","question_type":"conceptual","question":"What does it mean for $F$ to be an antiderivative of $f$ on an interval $I$?","options":["$F(x)=f'(x)$ for every point $x\\in I$","$F$ is differentiable on $I$ with $F'=f$","$F(x)=\\int_a^x f(t)\\,\\mathrm{d}t$ for a fixed $a\\in I$","$F'(x)=f(x)$ for all but finitely many $x\\in I$"],"answer_mode":"server","feedback_revision":"699cf0d41e2a8bb22464ecdf","time_limit":35},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_006","difficulty":"standard","question_type":"conceptual","question":"Which condition is part of the definition before one may call $F$ an antiderivative of $f$?","options":["$f$ must be continuous on $I$","$f$ must be differentiable on $I$","$F$ must be differentiable on $I$","$I$ must be a closed interval"],"answer_mode":"server","feedback_revision":"032e97aea6da0aaa65cd46f6","time_limit":30},{"id":"expansion_003_antiderivative_005","difficulty":"basic","question_type":"application","question":"Which function is an antiderivative of $f(x)=2x$?","options":["$F(x)=x^2+5$","$F(x)=2x^2+5$","$F(x)=2x+5$","$F(x)=x^2/2+5$"],"answer_mode":"server","feedback_revision":"9613d4e999e9622a7211302c","time_limit":20},{"id":"expansion_003_antiderivative_007","difficulty":"standard","question_type":"conceptual","question":"What causes the non-uniqueness of antiderivatives?","options":["They may differ by arbitrary non-constant functions.","Different integration methods give genuinely different answers.","They may differ by constants while having the same derivative.","A function can have several derivatives, so $F$ is not unique."],"answer_mode":"server","feedback_revision":"5f665a7749416970cd234977","time_limit":30},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_007_curated20261027_001","difficulty":"standard","question_type":"application","question":"Let $F$ be an antiderivative of $f$ on an interval $I$. Which function is an antiderivative of $f$ on $I$ for every such $f$ and $F$ and every constant $C\\in\\mathbb{R}$?","options":["$CF$","$F+Cx$","$F+C$","$x\\mapsto F(x+C)$"],"answer_mode":"server","feedback_revision":"c70e921285225da7bee7f74e","time_limit":35},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_008_curated20261027_002","difficulty":"basic","question_type":"application","question":"Which function is an antiderivative of $f(x)=\\cos x$ on $\\mathbb{R}$?","options":["$F(x)=\\cos x+2$","$F(x)=-\\sin x$","$F(x)=x\\cos x$","$F(x)=\\sin x+2$"],"answer_mode":"server","feedback_revision":"b9d6c74fdaa3b4cde2ce1d55","time_limit":20},{"id":"expansion_003_antiderivative_003_curated20261027_003","difficulty":"standard","question_type":"conceptual","question":"Let $a<b$ and let $F$ be an antiderivative of a continuous $f$ on $[a,b]$, where $f$ is not identically zero. Which function is also an antiderivative of $f$?","options":["$x\\mapsto F(x)+x$","$x\\mapsto F(x)+\\displaystyle\\int_a^xf(t)\\,\\mathrm{d}t$","$x\\mapsto F(x)-\\displaystyle\\int_a^bf(t)\\,\\mathrm{d}t$","$x\\mapsto\\displaystyle\\int_x^bf(t)\\,\\mathrm{d}t$"],"answer_mode":"server","feedback_revision":"27f36528c53b66f47e7a0461","time_limit":30},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_topup20261028_001","difficulty":"standard","question_type":"conceptual","question":"Let $a<b$. Which property of a function $f\\colon[a,b]\\to\\mathbb{R}$ guarantees that $f$ has an antiderivative on $[a,b]$?","options":["$f$ is Riemann integrable on $[a,b]$","$f$ is nondecreasing on $[a,b]$","$f$ is continuous on $[a,b]$","$f$ is bounded on $[a,b]$"],"answer_mode":"server","feedback_revision":"72e34548367eca4f006cb637","time_limit":35},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_topup20261028_002","difficulty":"standard","question_type":"application","question":"Let $f(x)=1$ and $F(x)=|x|$ for $x\\in[0,1]$. Is $F$ an antiderivative of $f$ on the interval $[0,1]$?","options":["Yes; on $[0,1]$, $F(x)=x$, and at $0$ the right derivative is $1$","No; $|x|$ has no derivative at $0$, so $F'(0)=f(0)$ fails","No; antiderivatives of $1$ have the form $x+C$, and $|x|$ does not","No; at $x=0$ we have $F(0)=0$, while $f(0)=1$"],"answer_mode":"server","feedback_revision":"30ba3a463079166a30c2728d","time_limit":45},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_topup20261028_003","difficulty":"standard","question_type":"application","question":"Let $F$ be an antiderivative of $f(x)=2x$ on $\\mathbb{R}$ with $F(1)=4$. What is $F(3)$?","options":["$9$","$12$","$13$","$8$"],"answer_mode":"server","feedback_revision":"77a66f5d6208a7ec38ad97d4","time_limit":30}]}}