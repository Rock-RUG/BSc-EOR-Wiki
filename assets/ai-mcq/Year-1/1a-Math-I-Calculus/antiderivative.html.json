,{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_003","difficulty":"basic","question_type":"application","question":"If $f(x) = 2x$, which function is an antiderivative?","options":["$F(x) = x$","$F(x) = 2$","$F(x) = 2x^2$","$F(x) = x^2$"],"answer_mode":"server","feedback_revision":"6ae9c06575464c66a16ddf1d"},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_004","difficulty":"basic","question_type":"application","question":"If $F(x) = \\sin x+2$, what is $F'(x)$?","options":["$\\sin x$","$2\\cos x$","$\\cos x$","$\\sin x+2$"],"answer_mode":"server","feedback_revision":"9bef3ec543fe936ca3d5f9d8"},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_005","difficulty":"standard","question_type":"conceptual","question":"Why are antiderivatives not unique?","options":["They may differ by a constant factor","They may differ by arbitrary linear terms","They may differ by constants","They become unique after changing notation"],"answer_mode":"server","feedback_revision":"68cfcbb34c31505e816cbc3a"},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_006","difficulty":"standard","question_type":"conceptual","question":"Which condition is part of the definition before one may call $F$ an antiderivative of $f$?","options":["$f$ must be continuous on $I$","$I$ must be unbounded","$F$ must be differentiable on $I$","$F$ must equal $f$"],"answer_mode":"server","feedback_revision":"2a017a857421296e3a17092e"},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_007","difficulty":"standard","question_type":"application","question":"If $F$ is an antiderivative of $f$ on $I$, which function is also an antiderivative of $f$?","options":["$CF$ only when $C = 0$","$F^2$","$F+C$ for any constant $C\\in\\mathbb{R}$","$f+F$"],"answer_mode":"server","feedback_revision":"6f81b78d7967df694f9792b9"},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_008","difficulty":"standard","question_type":"application","question":"Which function is an antiderivative of $f(x) = \\cos x$?","options":["$F(x) = \\cos x+2$","$F(x) = -\\sin x$","$F(x) = x\\cos x$","$F(x) = \\sin x+2$"],"answer_mode":"server","feedback_revision":"6b4ba1bbc2ec92b19ef469ff"},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_009","difficulty":"challenge","question_type":"conceptual","question":"Why is the interval $I$ relevant for antiderivative?","options":["It only fixes the value of $F$ at one endpoint","It removes the need for differentiability","The equality $F'(x) = f(x)$ must hold for all $x\\in I$","It makes every function constant"],"answer_mode":"server","feedback_revision":"ac865b80b182476d9b79a8c4"},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_010","difficulty":"challenge","question_type":"conceptual","question":"Which statement best reflects the family viewpoint for antiderivatives?","options":["All antiderivatives of a function are treated as differing by constants","An antiderivative is unique whenever $f$ is non-zero","Antiderivatives must differ by multiplication","Every function has exactly one antiderivative on every interval"],"answer_mode":"server","feedback_revision":"6b285d8381a80b53eb346252"},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_011","difficulty":"challenge","question_type":"application","question":"If $F(x) = x^2$ is an antiderivative of $f(x) = 2x$, which other function is also an antiderivative of $f$?","options":["$x^2+7$","$2x^2$","$x^3$","$x^2+x$"],"answer_mode":"server","feedback_revision":"fc4c6b04d30f86dd53e41110"},{"id":"year_1_1a_math_i_calculus_antiderivative_4f8b183c_012","difficulty":"challenge","question_type":"application","question":"For $f(x) = 2x$, which function is not an antiderivative of $f$?","options":["$x^2$","$2x^2$","$x^2+3$","$x^2-5$"],"answer_mode":"server","feedback_revision":"bba2088dfbcc45ba05525b95"},{"id":"expansion_003_antiderivative_001","difficulty":"basic","question_type":"conceptual","question":"What condition makes $F$ an antiderivative of $f$ on an interval $I$?","options":["$F(x)=0$ for all $x\\in I$.","$F$ is bounded on $I$ and $f$ is constant","$F$ is differentiable on $I$ with $F'=f$ on $I$","$F(x)=f'(x)$ for all $x\\in I$."],"answer_mode":"server","feedback_revision":"07d29939588d98b8ae112fd2"},{"id":"expansion_003_antiderivative_002","difficulty":"basic","question_type":"conceptual","question":"Why do antiderivatives of the same function form a family?","options":["Multiplying by a constant never changes the derivative.","Adding a constant does not change the derivative.","Every antiderivative must be zero at the origin.","A function can have only one derivative."],"answer_mode":"server","feedback_revision":"e1ecdc6e5f795f898abb77b3"},{"id":"expansion_003_antiderivative_003","difficulty":"basic","question_type":"conceptual","question":"Which operation is reversed by taking an antiderivative?","options":["Composition","Set complementation","Differentiation","Taking absolute values"],"answer_mode":"server","feedback_revision":"cf7707636eb082cbc835e9ee"},{"id":"expansion_003_antiderivative_004","difficulty":"basic","question_type":"application","question":"Which function is an antiderivative of $f(x)=3x^2$?","options":["$F(x)=6x$","$F(x)=3x$","$F(x)=x^2$","$F(x)=x^3$"],"answer_mode":"server","feedback_revision":"bc627de1e856bcc8cb048273"},{"id":"expansion_003_antiderivative_005","difficulty":"basic","question_type":"application","question":"Which function is an antiderivative of $f(x)=2x$?","options":["$F(x)=x^2+5$","$F(x)=2$","$F(x)=2x+5$","$F(x)=x+2$"],"answer_mode":"server","feedback_revision":"a8eefcbf8c8683c6424897f4"},{"id":"expansion_003_antiderivative_006","difficulty":"basic","question_type":"application","question":"How many antiderivatives does a continuous function $f$ have on an interval?","options":["Exactly one, since derivatives are unique","Infinitely many, differing by a constant","None, unless $f$ is a polynomial","Exactly two: $F$ and $-F$"],"answer_mode":"server","feedback_revision":"a1db1f501a2aded1fbc69e53"},{"id":"expansion_003_antiderivative_007","difficulty":"standard","question_type":"conceptual","question":"What causes the non-uniqueness of antiderivatives?","options":["They may differ by arbitrary non-constant functions.","They are defined only at one point.","They may differ by constants while having the same derivative.","They always have different domains."],"answer_mode":"server","feedback_revision":"108f81c474c09796171b9bea"},{"id":"expansion_003_antiderivative_008","difficulty":"standard","question_type":"application","question":"If $F$ is an antiderivative of $f$ on $I$, what is the derivative of $G(x)=F(x)+4$ on $I$?","options":["$G'(x)=f(x)+4$","$G'(x)=4f(x)$","$G'(x)=F(x)$","$G'(x)=f(x)$"],"answer_mode":"server","feedback_revision":"72c0d043d5509c3dd5b770d1"}]}}