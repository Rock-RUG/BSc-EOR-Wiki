d-difference-html-q03","difficulty":"basic","question_type":"conceptual","question":"Which property of subtraction is shown by $3-5\\neq 5-3$?","options":["It is not commutative in general.","It is commutative.","It is associative.","It always gives a nonnegative number."],"answer_mode":"server","feedback_revision":"b1520b28bc81c3a5d62b64a3"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q04","difficulty":"basic","question_type":"application","question":"What is $5-3$?","options":["$3$","$2$","$5$","$8$"],"answer_mode":"server","feedback_revision":"db0737fefbe2aa501224cb04"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q05","difficulty":"basic","question_type":"application","question":"What is $3-5$?","options":["$2$","$8$","$-2$","$0$"],"answer_mode":"server","feedback_revision":"6e67886297e6624077098a40"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q06","difficulty":"basic","question_type":"application","question":"What is $x-x$?","options":["$x$","$-x$","$2x$","$0$"],"answer_mode":"server","feedback_revision":"87c8e6696a33a5e9e9207caa"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q07","difficulty":"standard","question_type":"conceptual","question":"Which equation shows why subtraction is not commutative?","options":["$5-3=3-5$","$5+3=3+5$","$5-5=0$","$5-3\\ne3-5$"],"answer_mode":"server","feedback_revision":"398d9c28cbb446c917de09f4"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q08","difficulty":"standard","question_type":"conceptual","question":"Which expression is equivalent to $x-(y+z)$?","options":["$x-y+z$","$x+y-z$","$x+y+z$","$x-y-z$"],"answer_mode":"server","feedback_revision":"08cb2db077828eba519eaeb2"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q09","difficulty":"standard","question_type":"conceptual","question":"Which statement correctly distinguishes $x-y$ from $y-x$?","options":["They are always equal.","They are always both positive.","They are undefined unless $x=y$.","They are negatives of each other."],"answer_mode":"server","feedback_revision":"0dd19d1e1129053d6f739693"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q10","difficulty":"standard","question_type":"application","question":"Which expression equals $7-(2-5)$?","options":["$7-2+5$","$7-2-5$","$7+2-5$","$7+2+5$"],"answer_mode":"server","feedback_revision":"f6c14cdc94d86ab0e32f7cf1"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q11","difficulty":"standard","question_type":"application","question":"What is $(4-9)-(2-3)$?","options":["$-6$","$0$","$6$","$-4$"],"answer_mode":"server","feedback_revision":"2ec032d0fb8efbd747bbf3b1"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q12","difficulty":"standard","question_type":"conceptual","question":"How does subtraction $x-y$ produce the difference?","options":["It forms the difference $x-y$ by adding the additive inverse of $y$.","It forms the reciprocal of $y$ and multiplies by $x$.","It measures only the nonnegative distance between $x$ and $y$.","It makes the order of the two inputs irrelevant."],"answer_mode":"server","feedback_revision":"3f3dd3a9a4be17237751622e"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q13","difficulty":"standard","question_type":"conceptual","question":"Which mistake about subtraction $x-y$ should be avoided?","options":["Writing $x-y=x+(-y)$, which is actually correct.","Treating $x-y$ as if it were always equal to $y-x$","Saying that $x-x=0$","Computing $5-3=2$"],"answer_mode":"server","feedback_revision":"92e557b10a34da856958170d"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q14","difficulty":"standard","question_type":"application","question":"Which expression equals $(a-b)+(b-c)$?","options":["$a+c$","$b-a$","$c-a$","$a-c$"],"answer_mode":"server","feedback_revision":"be4ba71ebe5ddd4c3068b22c"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q15","difficulty":"challenge","question_type":"conceptual","question":"How does $|x-y|$ differ from $x-y$?","options":["$x-y$ is always nonnegative.","$|x-y|=x-y$ for all $x,y$.","$|x-y|$ keeps track of direction.","$|x-y|$ is a distance; $x-y$ is signed."],"answer_mode":"server","feedback_revision":"31d5ef7e084b162619d564db"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q16","difficulty":"challenge","question_type":"application","question":"If $x-y=0$, what follows?","options":["$x=-y$","$x=0$ and $y=0$ necessarily","$x=y$","$x-y=1$"],"answer_mode":"server","feedback_revision":"a3be0b9968a37d14cefba201"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q17","difficulty":"challenge","question_type":"application","question":"If $x-y=4$, what is $y-x$?","options":["$-4$","$4$","$0$","$1/4$"],"answer_mode":"server","feedback_revision":"557f0708434bf7f462ee4f6c"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q18","difficulty":"challenge","question_type":"conceptual","question":"Why does the order matter in subtraction?","options":["Because addition is irrelevant to subtraction, regardless of the specific input chosen.","Because the second input is replaced by its additive inverse.","Because both inputs are always made positive.","Because subtraction ignores signs."],"answer_mode":"server","feedback_revision":"7cd621f45bad7c3127477976"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q19","difficulty":"challenge","question_type":"application","question":"Which calculation correctly illustrates non-commutativity?","options":["$8+2=10$ and $2+8=10$","$8-2=6$ and $2-8=-6$","$8-8=0$ and $2-2=0$","$8\\cdot2=16$ and $2\\cdot8=16$"],"answer_mode":"server","feedback_revision":"52d8eb013769aa129f2de0be"},{"id":"year-1-1a-math-i-calculus-subtraction-and-difference-html-q20","difficulty":"challenge","question_type":"application","question":"Which expression is equal to $-(x-y)$?","options":["$x-y$","$x+y$","$-x-y$","$y-x$"],"answer_mode":"server","feedback_revision":"f66dc986d52849d7cc71b0f3"}]}}