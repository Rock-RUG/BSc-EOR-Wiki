alculus_bounded_sequence_b6dd4438_008","difficulty":"standard","question_type":"application","question":"For $a_n = (-1)^n$, which $M$ works in $|a_i|\\ \\le M$?","options":["$M = 0$","$M = -1$","$M = \\frac{1}{2}$","$M = 1$"],"answer_mode":"server","feedback_revision":"6e2621bb8aafd6cbc5d89133"},{"id":"year_1_1a_math_i_calculus_bounded_sequence_b6dd4438_009","difficulty":"challenge","question_type":"conceptual","question":"What changes when the terms are not real numbers?","options":["Use a corresponding norm condition $\\|a_i\\|\\ \\le M$","Boundedness is no longer meaningful","Use only $a_i\\ \\le M$","Require all terms to be positive"],"answer_mode":"server","feedback_revision":"b62e5ce95d18f458a1e8b1d0"},{"id":"year_1_1a_math_i_calculus_bounded_sequence_b6dd4438_010","difficulty":"challenge","question_type":"conceptual","question":"Which statement correctly separates boundedness from convergence?","options":["Boundedness implies convergence, but convergence does not imply boundedness","Convergence implies boundedness, but boundedness alone does not imply convergence","The two notions are identical","Neither notion applies to infinite sequences"],"answer_mode":"server","feedback_revision":"55dd88292d63e8a56d6a091f"},{"id":"year_1_1a_math_i_calculus_bounded_sequence_b6dd4438_011","difficulty":"challenge","question_type":"application","question":"Which sequence is bounded from below but not bounded?","options":["$a_n = n$","$a_n = (-1)^n$","$a_n = \\frac{1}{n}$","$a_n = 0$"],"answer_mode":"server","feedback_revision":"024130b62fbdc6858897503c"},{"id":"year_1_1a_math_i_calculus_bounded_sequence_b6dd4438_012","difficulty":"challenge","question_type":"application","question":"Which conclusion is valid for a finite sequence?","options":["It is always unbounded","It must converge to $0$","It is bounded","It cannot have an upper bound"],"answer_mode":"server","feedback_revision":"2f19a4cc4217db3f9348f039"},{"id":"expansion_006_bounded_sequence_001","difficulty":"standard","question_type":"conceptual","question":"If a real sequence is unbounded, what follows about its convergence?","options":["It must diverge","It must converge","It converges to $0$","Nothing can be concluded"],"answer_mode":"server","feedback_revision":"1612ad6696db5d676547dde5"},{"id":"expansion_006_bounded_sequence_002","difficulty":"basic","question_type":"conceptual","question":"What does bounded from above mean for $(a_n)$?","options":["There exists $M$ such that $a_i\\le M$ for all $i\\ge1$.","There exists $M$ such that $a_i\\ge M$ for all $i\\ge1$.","There exists $M$ such that $a_i=M$ for exactly one $i$.","There exists $M$ such that $a_i\\ne M$ for all $i$."],"answer_mode":"server","feedback_revision":"ab108b62999e9517fc32b5f1"},{"id":"expansion_006_bounded_sequence_003","difficulty":"standard","question_type":"application","question":"What is the smallest $M$ with $|a_n|\\le M$ for $a_n=3+(-1)^n$?","options":["$4$","$2$","$3$","$1$"],"answer_mode":"server","feedback_revision":"f89afe39d9841e03d57d7b0f"},{"id":"expansion_006_bounded_sequence_004","difficulty":"basic","question_type":"application","question":"Which $M$ bounds the sequence $a_n=(-1)^n/n$?","options":["$M=0$","$M=1$","$M=-1$","No such $M$ exists."],"answer_mode":"server","feedback_revision":"5de919cc0592b5735418dfa4"},{"id":"expansion_006_bounded_sequence_005","difficulty":"basic","question_type":"application","question":"Which sequence is unbounded?","options":["$a_n=1/n$","$a_n=(-1)^n$","$a_n=0$","$a_n=n$"],"answer_mode":"server","feedback_revision":"1affa5c35addf4db9e8fa8a8"},{"id":"expansion_006_bounded_sequence_006","difficulty":"standard","question_type":"conceptual","question":"A sequence is bounded if and only if it is:","options":["bounded on both sides","bounded above but not necessarily below","monotone in one direction","convergent to a finite limit"],"answer_mode":"server","feedback_revision":"acf2d2c2744256cdca0b1e92"},{"id":"expansion_006_bounded_sequence_007","difficulty":"challenge","question_type":"conceptual","question":"Suppose a real sequence satisfies $|a_n|\\le M$ for every $n$. What is guaranteed by this bound alone?","options":["Every term lies in the interval $[-M,M]$.","The sequence converges to a real limit.","The sequence is increasing or decreasing.","The sequence has only finitely many terms."],"answer_mode":"server","feedback_revision":"ac8f36b4553f2f21c299d8c8"},{"id":"expansion_006_bounded_sequence_008","difficulty":"challenge","question_type":"conceptual","question":"An increasing sequence is bounded above. What follows?","options":["It converges","It diverges to $\\infty$","It must be constant","Nothing can be said"],"answer_mode":"server","feedback_revision":"5680f4b1a30fb36abd7de12e"}]}}