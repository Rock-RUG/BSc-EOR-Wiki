e9bbdda"},{"id":"expansion_003_alternating_series_006","difficulty":"basic","question_type":"application","question":"Which series is alternating?","options":["$\\sum_{n=0}^{\\infty}(n+1)$","$\\sum_{n=0}^{\\infty}(-1)^n(n+1)$","$\\sum_{n=0}^{\\infty}\\frac{1}{n+1}$","$\\sum_{n=0}^{\\infty}2^n$"],"answer_mode":"server","feedback_revision":"8c38b44279d6921a9d6d70a3"},{"id":"expansion_003_alternating_series_007","difficulty":"standard","question_type":"conceptual","question":"Why can partial sums of an alternating series oscillate?","options":["They must increase monotonically.","They oscillate because the terms change sign.","They must decrease monotonically.","They have the same monotonicity as the absolute-value partial sums."],"answer_mode":"server","feedback_revision":"293e0e7cd5004a61718f0a20"},{"id":"expansion_003_alternating_series_008","difficulty":"standard","question_type":"application","question":"If all $a_n \\lt 0$, what is the sign pattern of $\\sum_{n=0}^{\\infty}(-1)^n a_n$?","options":["$+,-,+,-,\\ldots$","$-,+,-,+,\\ldots$","$+,+,+,+,\\ldots$","$-,-,-,-,\\ldots$"],"answer_mode":"server","feedback_revision":"309f29831264d2f5a5f8e123"}]}}