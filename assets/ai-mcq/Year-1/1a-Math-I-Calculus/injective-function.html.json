th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1a-Math-I-Calculus/injective-function.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/injective-function.html","questions":[{"id":"year_1_1a_math_i_calculus_injective_function_4ddbd6da_001","difficulty":"basic","question_type":"conceptual","question":"What does it mean for $f\\colon X\\to Y$ to be injective?","options":["Different elements of $X$ map to different elements of $Y$","Every element of $Y$ must be hit","Every input maps to the same output","The domain $X$ and the codomain $Y$ must contain the same elements"],"answer_mode":"server","feedback_revision":"bfa504aa6e9e934bd6c7e915","time_limit":30},{"id":"year_1_1a_math_i_calculus_injective_function_4ddbd6da_003","difficulty":"basic","question_type":"application","question":"Which example is injective on $\\mathbb{R}$?","options":["$f(x) = x^2$","$f(x) = x^3$","$f(x) = 0$","$f(x) = 1$"],"answer_mode":"server","feedback_revision":"78294563798d7edbefcd7658","time_limit":20},{"id":"year_1_1a_math_i_calculus_injective_function_4ddbd6da_013","difficulty":"basic","question_type":"conceptual","question":"For the graph of an injective real-valued function, how many intersections can a horizontal line $y=c$ have?","options":["at most once","at least once","exactly twice","never"],"answer_mode":"server","feedback_revision":"5f288b749fb69900a1645edf","time_limit":20},{"id":"year_1_1a_math_i_calculus_injective_function_4ddbd6da_014","difficulty":"basic","question_type":"conceptual","question":"Which implication is equivalent to injectivity when written contrapositively?","options":["$x=y\\implies f(x)\\neq f(y)$","$f(x)=f(y)\\implies x=y$","$f(x)\\neq f(y)\\implies x=y$","$x\\neq y\\implies f(x)=f(y)$"],"answer_mode":"server","feedback_revision":"f5f559d8e7860f211d068939","time_limit":20},{"id":"year_1_1a_math_i_calculus_injective_function_4ddbd6da_015","difficulty":"basic","question_type":"conceptual","question":"If $f$ is injective and you know the value $f(x)$, what can you recover about $x$?","options":["The input $x$, uniquely determined","Nothing, unless $f$ is also surjective","Only $x$ up to sign, as for $x^2$","Only an approximation, if $f$ is continuous"],"answer_mode":"server","feedback_revision":"c44bc93e8968e3dbb9665e78","time_limit":30},{"id":"year_1_1a_math_i_calculus_injective_function_4ddbd6da_017","difficulty":"basic","question_type":"application","question":"For $f(x)=x^2$ on $\\mathbb{R}$, which pair shows non-injectivity?","options":["$1$ and $-1$","$1$ and $2$","$0$ and $1$","$2$ and $3$"],"answer_mode":"server","feedback_revision":"251e72d30c692188731af3dc","time_limit":25},{"id":"year_1_1a_math_i_calculus_injective_function_4ddbd6da_020","difficulty":"standard","question_type":"application","question":"Which restriction makes $f(x)=x^2$ injective?","options":["Domain $\\mathbb{R}$","Domain $[-1,1]$","Domain $[0,+\\infty)$","Domain $\\{-1,1\\}$"],"answer_mode":"server","feedback_revision":"0cd2bdb14046d52f02a881a2","time_limit":30},{"id":"year_1_1a_math_i_calculus_injective_function_4ddbd6da_010_curated20261027_001","difficulty":"challenge","question_type":"conceptual","question":"For functions defined on subsets of $\\mathbb{R}$, how are 'strictly monotone' and 'injective' related?","options":["Strictly monotone implies injective, but not conversely","The two properties are equivalent","Injective implies strictly monotone, but not conversely","Neither property implies the other"],"answer_mode":"server","feedback_revision":"65bf8e118b8e88d0731b7328","time_limit":40},{"id":"year_1_1a_math_i_calculus_injective_function_4ddbd6da_018_curated20261027_002","difficulty":"standard","question_type":"application","question":"Let $f\\colon\\mathbb{R}\\setminus\\{3\\}\\to\\mathbb{R}$, $f(x)=\\frac{2x+1}{x-3}$. Which argument proves that $f$ is injective?","options":["Assume $f(a)=f(b)$; clearing denominators gives $7a=7b$, so $a=b$","Check that $f(0)$, $f(1)$ and $f(2)$ are three different numbers","Assume $a=b$; then $f(a)=f(b)$, since $f$ is a function","Assume $f(a)\\neq f(b)$ and conclude that $a\\neq b$"],"answer_mode":"server","feedback_revision":"69deb0e734ce4f25497db7bc","time_limit":35},{"id":"year_1_1a_math_i_calculus_injective_function_4ddbd6da_topup20261028_001","difficulty":"standard","question_type":"application","question":"Let $f\\colon\\mathbb{R}\\to\\mathbb{R}$, $f(x)=x^3-3x$. Which statement about the injectivity of $f$ is correct?","options":["Injective: like $x^3$, every cubic polynomial is injective on $\\mathbb{R}$","Injective: $f(x)=f(y)$ gives $x^3-y^3=3(x-y)$, which forces $x=y$","Not injective: $f(-1)=2=f(2)$, so two different inputs share an output","Not injective: $f(-x)=-f(x)$, so $x$ and $-x$ always share an output"],"answer_mode":"server","feedback_revision":"6f3afd7cbf0ddbd6fc37a40b","time_limit":35}]}}