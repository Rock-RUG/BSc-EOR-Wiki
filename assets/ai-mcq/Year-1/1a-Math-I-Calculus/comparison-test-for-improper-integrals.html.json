th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1a-Math-I-Calculus/comparison-test-for-improper-integrals.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/comparison-test-for-improper-integrals.html","questions":[{"id":"wiki20261002_comparison_improper_001","difficulty":"basic","question_type":"conceptual","question":"Assume $0\\le f\\le g$ on $[1,\\infty)$ and both functions are continuous there. Which implication is guaranteed?","options":["If the integral of $g$ diverges, so does that of $f$.","If the integral of $g$ converges, so does that of $f$.","If the integral of $f$ diverges, that of $g$ converges.","If the integral of $f$ converges, so does that of $g$."],"answer_mode":"server","feedback_revision":"cd3c8c0e8a4a90b068d99dd2","time_limit":40},{"id":"wiki20261002_comparison_improper_003","difficulty":"basic","question_type":"conceptual","question":"For positive continuous $f,g$ on $[1,\\infty)$, which limit allows the stated limit comparison test in both directions?","options":["$\\lim f/g=+\\infty$","$\\lim f/g=0$","$\\lim f/g$ does not exist","$\\lim f/g=3$"],"answer_mode":"server","feedback_revision":"39de8278f9bb794ee36a9fe9","time_limit":25},{"id":"wiki20261002_comparison_improper_004","difficulty":"basic","question_type":"application","question":"Why does $\\int_1^\\infty (x^2+x)^{-1}\\,\\mathrm{d}x$ converge?","options":["It is bounded above by the constant $1$.","It is bounded above by $x^{-2}$.","Every integrand tending to zero is integrable.","It is bounded below by $x^{-1}$."],"answer_mode":"server","feedback_revision":"8857795dbb31fccece94f128","time_limit":25},{"id":"wiki20261002_comparison_improper_005","difficulty":"basic","question_type":"application","question":"Which reference gives a convergent upper bound for $1/\\sqrt{x(1+x)}$ on $0<x\\le1$?","options":["$x^{-1/2}$","$x^{-1}$","$1$","$x^{-2}$"],"answer_mode":"server","feedback_revision":"077af64d0727914dd0db3567","time_limit":20},{"id":"wiki20261002_comparison_improper_007","difficulty":"standard","question_type":"application","question":"Use limit comparison to classify $\\int_1^\\infty (3x+1)/(x^3+2)\\,\\mathrm{d}x$.","options":["Converges like $x^{-1/2}$.","Diverges like $x^{-1}$.","Diverges like a constant.","Converges like $x^{-2}$."],"answer_mode":"server","feedback_revision":"07015cf17ef135b992bc634f","time_limit":30},{"id":"wiki20261002_comparison_improper_010","difficulty":"standard","question_type":"application","question":"Classify $\\int_0^1 (2+x)/x^{3/2}\\,\\mathrm{d}x$.","options":["Converges because the interval is finite.","Diverges because every power is nonintegrable at zero.","Diverges by a lower bound $2x^{-3/2}$.","Converges by an upper bound $3x^{-3/2}$."],"answer_mode":"server","feedback_revision":"1717f16d1e40a27d33e8209a","time_limit":30},{"id":"wiki20261002_comparison_improper_011","difficulty":"standard","question_type":"conceptual","question":"Let $f,g>0$ be continuous on $[1,\\infty)$ with $f/g\\to0$ and $\\int_1^\\infty g<\\infty$. What can be concluded?","options":["The integral of $f$ may diverge.","The integral of $f$ equals that of $g$.","Both integrals diverge.","The integral of $f$ converges."],"answer_mode":"server","feedback_revision":"3928d9fc28b99b8c95b67e91","time_limit":30},{"id":"wiki20261002_comparison_improper_012","difficulty":"standard","question_type":"conceptual","question":"Let $f,g>0$ be continuous on $[1,\\infty)$, $f/g\\to0$, and $\\int_1^\\infty g=+\\infty$. What follows from these assumptions?","options":["The integral of $f$ is not determined.","The integral of $f$ necessarily diverges.","The integral of $f$ necessarily converges.","The integral of $f$ must equal zero."],"answer_mode":"server","feedback_revision":"2851a084845a17fc779b8899","time_limit":30},{"id":"wiki20261002_comparison_improper_014","difficulty":"standard","question_type":"conceptual","question":"A nonnegative continuous function on $[1,\\infty)$ satisfies $f(x)\\le x^{-2}$ for $x\\ge100$. What is true?","options":["Its integral diverges because the bound starts late.","Its integral necessarily equals $1/100$.","Its integral converges only if $f(100)=0$.","Its integral converges despite the late bound."],"answer_mode":"server","feedback_revision":"49e804100a7730b4a881ac16","time_limit":30},{"id":"wiki20261002_comparison_improper_016","difficulty":"standard","question_type":"conceptual","question":"For $x\\ge1$, a continuous $h$ satisfies $|h(x)|\\le x^{-2}$. Which conclusion is guaranteed?","options":["The integral of $h$ is zero.","The integral of $h$ converges absolutely.","The function $h$ has no sign changes.","The integral of $h$ is positive."],"answer_mode":"server","feedback_revision":"7fc595b6efe213509f362e28","time_limit":30},{"id":"wiki20261002_comparison_improper_019","difficulty":"challenge","question_type":"application","question":"For real $a$, when does $\\int_0^\\infty x^a/(1+x^2)\\,\\mathrm{d}x$ converge?","options":["$-1<a<1$","$a<1$","$a>-1$","$-1\\le a\\le1$"],"answer_mode":"server","feedback_revision":"5fe41984e9b758eeeef1bbd4","time_limit":40},{"id":"wiki20261002_comparison_improper_020","difficulty":"challenge","question_type":"conceptual","question":"A student uses $|h|\\le g$ and divergence of $\\int_1^\\infty g$ to claim divergence of $\\int_1^\\infty h$. Which pair disproves this argument?","options":["$h=2x^{-1},\\ g=x^{-1}$","$h=x^{-1},\\ g=x^{-1}$","$h=x^{-2},\\ g=x^{-1}$","$h=x^{-1},\\ g=x^{-2}$"],"answer_mode":"server","feedback_revision":"eff1d6525cb791a44a5ba94c","time_limit":40},{"id":"wiki20261002_comparison_improper_006_curated20261027_001","difficulty":"challenge","question_type":"application","question":"On $[1,\\infty)$ we have $-x\\le\\frac{1}{x^2}$, and $\\int_1^{\\infty}\\frac{\\mathrm{d}x}{x^2}$ converges. What does the comparison test give for $\\int_1^{\\infty}(-x)\\,\\mathrm{d}x$?","options":["No conclusion, since $-x<0$; in fact the integral diverges.","Convergence, since $-x$ lies below a convergent reference.","Convergence, since absolute convergence handles negative integrands.","No conclusion, since $\\int_1^{\\infty}x^{-2}\\,\\mathrm{d}x$ diverges."],"answer_mode":"server","feedback_revision":"6a21401ee4ea2174050f4704","time_limit":40}]}}