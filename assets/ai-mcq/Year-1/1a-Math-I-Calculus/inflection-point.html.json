th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1a-Math-I-Calculus/inflection-point.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/inflection-point.html","questions":[{"id":"year_1_1a_math_i_calculus_inflection_point_09906653_001","difficulty":"basic","question_type":"conceptual","question":"What is an inflection point of $f\\colon\\mathbb{R}\\to\\mathbb{R}$?","options":["A point where the curve switches convex and concave","A point where the tangent line to the graph is horizontal","A point where $f$ switches from increasing to decreasing","A point where the second derivative $f''$ equals zero"],"answer_mode":"server","feedback_revision":"2f274d9e4a4537050e2053e6","time_limit":25},{"id":"year_1_1a_math_i_calculus_inflection_point_09906653_006","difficulty":"standard","question_type":"conceptual","question":"Does $f''(x_0)=0$ on its own guarantee an inflection point at $x_0$?","options":["Yes; $f''(x_0)=0$ is exactly how an inflection point is defined","No; inflection points instead require $f''(x_0)\\neq 0$","Yes, provided that $f$ is twice differentiable at $x_0$","No; a curvature change around $x_0$ must still be checked"],"answer_mode":"server","feedback_revision":"705cee6ccecda489b9f50490","time_limit":30},{"id":"year_1_1a_math_i_calculus_inflection_point_09906653_018","difficulty":"basic","question_type":"application","question":"A curve changes from concave to convex at $x=2$. Which point is the inflection point?","options":["$(f(2),2)$","$(2,f'(2))$","$(0,2)$","$(2,f(2))$"],"answer_mode":"server","feedback_revision":"7f2e6e84941278d7e6b93d9e","time_limit":20},{"id":"year_1_1a_math_i_calculus_inflection_point_09906653_020","difficulty":"standard","question_type":"application","question":"Suppose $f''$ is negative to the left of $x_0$ and positive to the right of $x_0$. What does this support?","options":["A local minimum of $f$ at $x_0$","A switch from convex to concave at $x_0$","A stationary point with $f'(x_0)=0$","An inflection point at $(x_0,f(x_0))$"],"answer_mode":"server","feedback_revision":"164c09459fd9ec850a35a797","time_limit":30},{"id":"year_1_1a_math_i_calculus_inflection_point_09906653_003_curated20261027_001","difficulty":"basic","question_type":"application","question":"Which function has an inflection point at $x=0$?","options":["$f(x)=x^3$","$f(x)=x^4$","$f(x)=x^2$","$f(x)=|x|$"],"answer_mode":"server","feedback_revision":"87c49bc957c9df321275a1e9","time_limit":20},{"id":"year_1_1a_math_i_calculus_inflection_point_09906653_007_curated20261027_002","difficulty":"challenge","question_type":"application","question":"For $f(x)=x|x|$ on $\\mathbb{R}$, which statement about the point $(0,0)$ is true?","options":["It is an inflection point, although $f''(0)$ does not exist","It is not an inflection point, since $f''(0)$ does not exist","It is an inflection point, and $f''(0)=0$ there","It is a local minimum of $f$, since $f'(0)=0$"],"answer_mode":"server","feedback_revision":"5e0b0eed364a298246634311","time_limit":40},{"id":"year_1_1a_math_i_calculus_inflection_point_09906653_008_curated20261027_003","difficulty":"standard","question_type":"conceptual","question":"Let $f$ be differentiable on an open interval containing $x_0$, and let $(x_0,f(x_0))$ be an inflection point. Which statement must hold?","options":["$f'$ has a local extremum at $x_0$","$f'(x_0)=0$","$f$ has a local extremum at $x_0$","$f''(x_0)=0$"],"answer_mode":"server","feedback_revision":"1126462410b36e3d1049b67e","time_limit":30},{"id":"year_1_1a_math_i_calculus_inflection_point_09906653_topup20261028_001","difficulty":"standard","question_type":"application","question":"Let $f(x)=x^5-5x^4$ for $x\\in\\mathbb{R}$, so that $f''(x)=20x^2(x-3)$. At which values of $x$ does the graph of $f$ have an inflection point?","options":["At $x=0$ and $x=3$","At $x=0$ and $x=4$","Only at $x=3$","Only at $x=4$"],"answer_mode":"server","feedback_revision":"2c95e81637dc071cc7de21de","time_limit":30},{"id":"year_1_1a_math_i_calculus_inflection_point_09906653_topup20261028_002","difficulty":"standard","question_type":"application","question":"Let $f(x)=3x-x^3$ for $x\\in\\mathbb{R}$. Its graph has an inflection point at $(0,0)$, where the tangent line is $y=3x$. How does the graph lie relative to this tangent line for $x$ near $0$, $x\\neq0$?","options":["Above the tangent for $x<0$, below it for $x>0$","Below the tangent for $x<0$, above it for $x>0$","Below the tangent on both sides of $0$","Above the tangent on both sides of $0$"],"answer_mode":"server","feedback_revision":"a06f50e98e87a90f3641796c","time_limit":45},{"id":"year_1_1a_math_i_calculus_inflection_point_09906653_topup20261028_003","difficulty":"basic","question_type":"conceptual","question":"Let $g\\colon[0,1]\\to\\mathbb{R}$, $g(x)=x^3$. Is $(0,0)$ an inflection point of the graph of $g$?","options":["Yes: $g''(0)=0$ and $g''>0$ on $(0,1]$","Yes: $x\\mapsto x^3$ has an inflection point at $0$ on $\\mathbb{R}$","No: $g'(0)=0$, and a stationary point is never an inflection point","No: $0$ is an endpoint of $[0,1]$, so there is no left side to compare"],"answer_mode":"server","feedback_revision":"255f7acc356034169cf19ed5","time_limit":40}]}}