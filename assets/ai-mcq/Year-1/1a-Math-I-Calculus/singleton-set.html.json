03","difficulty":"basic","question_type":"conceptual","question":"What is the cardinality of $\\{a\\}$?","options":["$0$","$2$","$|a|$","$1$"],"answer_mode":"server","feedback_revision":"ffac32036df108d3e13c4da0"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q04","difficulty":"basic","question_type":"application","question":"Which set is a singleton?","options":["$\\varnothing$","$\\{7\\}$","$\\{3,4\\}$","$\\mathbb N$"],"answer_mode":"server","feedback_revision":"53252c8bfcd5c23c4b4fac6d"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q05","difficulty":"basic","question_type":"application","question":"How many elements does $\\{1,1\\}$ have?","options":["$0$","$2$","$1$","Infinitely many"],"answer_mode":"server","feedback_revision":"9bf6391bf8590f3a8d7de5c6"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q06","difficulty":"basic","question_type":"application","question":"Which set has the empty set as its only element?","options":["$\\varnothing$","$\\{0\\}$","$\\{\\varnothing\\}$","$\\{\\varnothing,0\\}$"],"answer_mode":"server","feedback_revision":"6d263f4d4ece9291b112e64e"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q07","difficulty":"standard","question_type":"conceptual","question":"Which statement correctly distinguishes $\\varnothing$ from $\\{\\varnothing\\}$?","options":["$\\varnothing$ is empty, while $\\{\\varnothing\\}$ is a singleton.","Both are empty.","$\\varnothing$ is a singleton, while $\\{\\varnothing\\}$ is empty.","They are equal because both use the symbol $\\varnothing$."],"answer_mode":"server","feedback_revision":"82f5d9ed29f4b13e32aa942f"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q08","difficulty":"standard","question_type":"conceptual","question":"Which condition is equivalent to saying that $S$ is a singleton?","options":["There exists an element $a$ such that $S=\\{a\\}$.","$S$ is a subset of every set.","$S$ contains all elements of another set.","$S$ has at least two distinct elements."],"answer_mode":"server","feedback_revision":"1df7a02a063a7248b96246b8"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q09","difficulty":"standard","question_type":"conceptual","question":"When are two singleton sets $\\{a\\}$ and $\\{b\\}$ equal?","options":["Exactly when $a\\ne b$","Always, because all singletons have one element","Exactly when $a=b$","Never, because their labels are different"],"answer_mode":"server","feedback_revision":"7c799ca6558f6f79045f959d"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q10","difficulty":"standard","question_type":"application","question":"Which set is not a singleton?","options":["$\\{1,2\\}$","$\\{5\\}$","$\\{\\varnothing\\}$","$\\{x\\in\\mathbb R:x=0\\}$"],"answer_mode":"server","feedback_revision":"63c1ed587f809b98c0de411e"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q11","difficulty":"standard","question_type":"application","question":"What is $\\mathcal P(\\{a\\})$?","options":["$\\{\\{a\\}\\}$","$\\{\\varnothing,\\{a\\}\\}$","$\\varnothing$","$\\{a,\\varnothing\\}$"],"answer_mode":"server","feedback_revision":"88de6cd7e3fc36e9a87ca124"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q12","difficulty":"standard","question_type":"conceptual","question":"What does forming the singleton $\\{a\\}$ accomplish?","options":["It represents a set with no elements.","It isolates exactly one object as a set element.","It collects all objects satisfying a condition.","It makes two different elements count as one by notation alone."],"answer_mode":"server","feedback_revision":"efb2b895af7601ae7ffb07f1"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q13","difficulty":"standard","question_type":"conceptual","question":"Which mistake involving a singleton set $\\{a\\}$ should be avoided?","options":["Writing $\\{a\\}$ for a one-element set, under all circumstances whatsoever.","Saying $|\\{a\\}|=1$","Confusing the element $a$ with the singleton $\\{a\\}$","Recognising $\\{\\varnothing\\}$ as non-empty"],"answer_mode":"server","feedback_revision":"e5c625588d2c0b5c021b2d45"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q14","difficulty":"standard","question_type":"application","question":"If $x\\in\\{a\\}$, what must be true?","options":["$x\\ne a$","$x=a$","$x=\\{a\\}$ always","$\\{x\\}=a$ always"],"answer_mode":"server","feedback_revision":"e1fd7817c1005435d8b29c99"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q15","difficulty":"challenge","question_type":"conceptual","question":"What does $\\{a\\}\\subseteq A$ tell you about $a$?","options":["It means $a\\in A$.","It means $A\\in a$.","It means $A=\\{a\\}$ only.","It means $a$ is the only element of $A$."],"answer_mode":"server","feedback_revision":"ebcdf6c2434ef07a6c248861"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q16","difficulty":"challenge","question_type":"application","question":"Which statement correctly treats $\\varnothing$ as the single element of $\\{\\varnothing\\}$?","options":["$\\{\\varnothing\\}\\in\\varnothing$","$\\varnothing=\\{\\varnothing\\}$","$\\{\\varnothing\\}$ has cardinality $0$","$\\varnothing\\in\\{\\varnothing\\}$"],"answer_mode":"server","feedback_revision":"0f6ec02892f381001075eb0a"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q17","difficulty":"challenge","question_type":"conceptual","question":"Which statement best captures a subtle point about singleton sets?","options":["A singleton can contain only numbers.","A singleton must contain the number $1$.","A singleton is always equal to its unique element.","A singleton may contain any kind of object, including a set."],"answer_mode":"server","feedback_revision":"dec81ff1b77cd539e9329e6c"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q18","difficulty":"challenge","question_type":"application","question":"Let $A=\\{2\\}$. Which statement is correct?","options":["$2\\subseteq A$ and $\\{2\\}\\in A$","$A$ has two elements","$A=2$","$2\\in A$ and $\\{2\\}\\subseteq A$"],"answer_mode":"server","feedback_revision":"10271a1c86bb14b4c6aed409"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q19","difficulty":"challenge","question_type":"application","question":"Which set is a singleton even though its displayed element is itself a set?","options":["$\\{1,2\\}$","$\\varnothing$","$\\{1,\\{2\\}\\}$","$\\{\\{1,2\\}\\}$"],"answer_mode":"server","feedback_revision":"73bd3afb0f6586eb56931850"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q20","difficulty":"challenge","question_type":"conceptual","question":"Why is $\\{a,a\\}$ a singleton?","options":["Because every set with braces is a singleton.","Because $a$ and $a$ are treated as two different elements, for every possible choice of input.","Because repeated occurrences of the same element do not create distinct set elements.","Because the second $a$ is ignored only when $a=0$."],"answer_mode":"server","feedback_revision":"6fad4b6496e3941b29579fc8"}]}}