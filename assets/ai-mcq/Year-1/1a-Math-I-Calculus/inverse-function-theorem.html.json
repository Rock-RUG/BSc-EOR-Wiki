],"answer_mode":"server","feedback_revision":"516869abd10c771e52bdcc42"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_003","difficulty":"basic","question_type":"application","question":"If $f'(x_0) = 2$ and $y_0 = f(x_0)$, what is $(f^{-1})'(y_0)$?","options":["$\\frac{1}{2}$","$2$","$0$","$-2$"],"answer_mode":"server","feedback_revision":"a860ae76858fd83123898ae4"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_004","difficulty":"basic","question_type":"application","question":"If $f'(x_0) = 5$ and $y_0 = f(x_0)$, what does the formula give for $(f^{-1})'(y_0)$?","options":["$5$","$-5$","$\\frac{1}{5}$","$0$"],"answer_mode":"server","feedback_revision":"a57cba4ed0fe52821e0c6234"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_005","difficulty":"standard","question_type":"conceptual","question":"Which condition on $f'(x)$ is required in the Inverse Function Theorem?","options":["$f'(x)\\ \\neq 0$","$f'(x) = 0$","$f'(x) = 1$ always.","$f'(x)$ must be undefined."],"answer_mode":"server","feedback_revision":"fe654fbfac489d57e87c7a8f"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_006","difficulty":"standard","question_type":"conceptual","question":"Which additional assumption about $f^{-1}$ appears in the Inverse Function Theorem?","options":["$f^{-1}$ is continuous at $y$.","$f^{-1}$ is constant at $y$.","$f^{-1}$ is not defined at $y$.","$f^{-1}$ has derivative $0$ at $y$."],"answer_mode":"server","feedback_revision":"5531974e38891ec5f3fadc0e"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_007","difficulty":"standard","question_type":"application","question":"Suppose $f'(f^{-1}(y)) = 4$. What is $(f^{-1})'(y)$?","options":["$4$","$-4$","$\\frac{1}{y}$","$\\frac{1}{4}$"],"answer_mode":"server","feedback_revision":"c09a342427cd73f1b242fcc2"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_008","difficulty":"standard","question_type":"application","question":"If $f(x_0) = y_0$ and $f'(x_0) = -3$, which value does the Inverse Function Theorem give for $(f^{-1})'(y_0)$?","options":["$3$","$-\\frac{1}{3}$","$-3$","$\\frac{1}{3}$"],"answer_mode":"server","feedback_revision":"83b6b1e46e6d01f0c7032de0"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_009","difficulty":"challenge","question_type":"conceptual","question":"At what kind of point can the inverse function theorem fail to apply?","options":["The theorem requires $f'(x) = 0$.","The theorem does not require $f$ to be invertible.","The theorem proves $f^{-1}$ is continuous without assumptions.","The theorem cannot be applied at a point where $f'(x) = 0$."],"answer_mode":"server","feedback_revision":"92b1f187ab32f0f6b1edbed0"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_010","difficulty":"challenge","question_type":"conceptual","question":"Which statement best connects the Inverse Function Theorem with the prerequisite concept of inverse functions?","options":["The derivative of $f^{-1}$ is evaluated at $x$, where $x = f(y)$.","The derivative of $f^{-1}$ is evaluated at $y$, where $y = f(x)$.","The inverse function is unnecessary in the formula.","The theorem applies even when no inverse exists."],"answer_mode":"server","feedback_revision":"b19b13993f3a344986171944"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_011","difficulty":"challenge","question_type":"application","question":"Let $f$ satisfy the Inverse Function Theorem assumptions at $x = 2$, with $f(2) = 7$ and $f'(2) = \\frac{1}{3}$. What is $(f^{-1})'(7)$?","options":["$3$","$\\frac{1}{3}$","$7$","$2$"],"answer_mode":"server","feedback_revision":"4d12b66d616281799016793e"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_012","difficulty":"challenge","question_type":"application","question":"If $f'(x_0)=0$, which inverse-function-theorem conclusion is justified at $y_0=f(x_0)$?","options":["Zero derivative makes the inverse derivative zero.","The theorem gives no derivative formula at this point.","Any inverse has derivative one at $y_0$.","The inverse derivative equals $f'(x_0)$."],"answer_mode":"server","feedback_revision":"a5d7b567f8bfd8f56aee52c4"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_013","difficulty":"basic","question_type":"conceptual","question":"What does the formula for $(f^{-1})'(y)$ use from the original function?","options":["The value $f(y)$","The second derivative of $f^{-1}$, in every case without exception.","The maximum of $f$ on $X$","The reciprocal of $f'$ at the corresponding input"],"answer_mode":"server","feedback_revision":"f93d1fa6e9f37015c7aa13ba"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_014","difficulty":"basic","question_type":"conceptual","question":"Which point of $f$ corresponds to the point $y$ of $f^{-1}$?","options":["$x=f(y)$","$x=y^{-1}$","$x=f'(y)$","$x=f^{-1}(y)$"],"answer_mode":"server","feedback_revision":"54389f6e40ad8145dbea5e45"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_015","difficulty":"basic","question_type":"conceptual","question":"Why must $f'(x)\\neq0$ appear in the Inverse Function Theorem?","options":["It forces $f$ to be constant","It makes $f^{-1}$ discontinuous","The reciprocal $1/f'(x)$ must be defined","It removes the need for invertibility"],"answer_mode":"server","feedback_revision":"dbd094bbe708663e09f0c73b"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_016","difficulty":"basic","question_type":"application","question":"If $f'(x_0)=10$ and $y_0=f(x_0)$, what is $(f^{-1})'(y_0)$?","options":["$1/10$","$10$","$-10$","$0$"],"answer_mode":"server","feedback_revision":"fbdb7bb8de593d7fefed6efa"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_017","difficulty":"basic","question_type":"application","question":"If $f'(x_0)=-4$ and $y_0=f(x_0)$, what is $(f^{-1})'(y_0)$?","options":["$1/4$","$4$","$-1/4$","$-4$"],"answer_mode":"server","feedback_revision":"5206cb13b7aecb45a1c2e05d"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_018","difficulty":"basic","question_type":"application","question":"If $f^{-1}(9)=2$ and $f'(2)=6$, what is $(f^{-1})'(9)$?","options":["$6$","$2/9$","$1/6$","$9/2$"],"answer_mode":"server","feedback_revision":"04dc5c22ac7cbb3c0d7cf697"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_019","difficulty":"standard","question_type":"conceptual","question":"Which assumptions are needed before concluding differentiability of $f^{-1}$ at $y$?","options":["Only that $f'(x)=0$","Only that $f$ is defined at one point, in all instances without exception.","Invertibility, differentiability of $f$ at $x$, $f'(x)\\neq0$, and continuity of $f^{-1}$ at $y$","Only that $y$ is a real number"],"answer_mode":"server","feedback_revision":"abb9c985923b609387bcbc61"},{"id":"year_1_1a_math_i_calculus_inverse_function_theorem_2c26d705_020","difficulty":"standard","question_type":"application","question":"Suppose $f^{-1}(y)=3$ and $f'(3)=1/5$. What is $(f^{-1})'(y)$?","options":["$5$","$1/5$","$3/5$","$0$"],"answer_mode":"server","feedback_revision":"cfec9ee16990aa75718b7d06"}]}}