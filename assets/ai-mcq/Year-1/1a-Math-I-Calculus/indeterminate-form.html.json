th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1a-Math-I-Calculus/indeterminate-form.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/indeterminate-form.html","questions":[{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_008","difficulty":"standard","question_type":"application","question":"What is the value of $\\displaystyle\\lim_{x\\to +\\infty}\\mathrm{e}^{-x}x$?","options":["$1$","$\\infty$","It does not exist.","$0$"],"answer_mode":"server","feedback_revision":"b5b4ee0bb01ccea856d13449","time_limit":30},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_013","difficulty":"basic","question_type":"conceptual","question":"Why is $1^\\infty$ called an indeterminate form?","options":["It always equals $1$ as a limit","It does not by itself determine the limiting value","It always diverges to $+\\infty$","It is not one of the listed symbolic forms"],"answer_mode":"server","feedback_revision":"8bc143acaf3a1b6ce2f464ce","time_limit":25},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_017","difficulty":"basic","question_type":"application","question":"What symbolic form appears in $\\displaystyle\\lim_{x\\to+\\infty}\\frac{x}{x+1}$ before further analysis?","options":["$\\dfrac{0}{0}$","$\\dfrac{\\infty}{\\infty}$","$0\\times\\infty$","$0^0$"],"answer_mode":"server","feedback_revision":"eb98684f7c43de7d83c16786","time_limit":20},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_020","difficulty":"standard","question_type":"application","question":"The form of $\\displaystyle\\lim_{x\\to+\\infty}\\frac{x+1}{x}$ is $\\infty/\\infty$. What is the limit?","options":["$0$","$1$","$+\\infty$","It cannot be discussed because the form is indeterminate"],"answer_mode":"server","feedback_revision":"c54d05a6acc353a348359d20","time_limit":30},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_009_curated20261027_001","difficulty":"standard","question_type":"conceptual","question":"Direct use of the limit laws on $\\lim_{x\\to a}\\frac{f(x)}{g(x)}$ gives the form $\\frac{0}{0}$. Which conclusion is valid?","options":["The limit is $0$, because the numerator tends to $0$.","The limit is $1$, because the numerator and denominator agree.","The limit does not exist, because division by $0$ is undefined.","The form alone does not determine the limit."],"answer_mode":"server","feedback_revision":"98e99bcba9cb330f08f62296","time_limit":35},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_011_curated20261027_002","difficulty":"standard","question_type":"application","question":"As $x\\to0$, both $\\dfrac{x}{x}$ and $\\dfrac{x^2}{x}$ have the form $\\dfrac{0}{0}$. What are their limits?","options":["$0$ and $1$","$1$ and $1$","$1$ and $0$","Both have no limit"],"answer_mode":"server","feedback_revision":"f57d013488afe0c4c99f6f25","time_limit":30},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_014_curated20261027_003","difficulty":"basic","question_type":"conceptual","question":"Which of these limit forms is not indeterminate?","options":["$\\infty-\\infty$","$\\dfrac{0}{\\infty}$","$0^0$","$\\dfrac{\\infty}{\\infty}$"],"answer_mode":"server","feedback_revision":"c028dee9d1856f9c80d146d3","time_limit":20},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_topup20261028_001","difficulty":"standard","question_type":"application","question":"Let $f(x)=\\sqrt{x^2+x}-x$ for $x>0$. Both $\\sqrt{x^2+x}$ and $x$ tend to $+\\infty$ as $x\\to+\\infty$. What is $\\displaystyle\\lim_{x\\to+\\infty}f(x)$?","options":["$0$","$\\frac{1}{2}$","$1$","$+\\infty$"],"answer_mode":"server","feedback_revision":"17c0cd12b68bbbc363c9aca6","time_limit":30},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_topup20261028_002","difficulty":"standard","question_type":"application","question":"Let $f(x)=x^{1/\\ln x}$ for $0<x<1$. As $x\\to0^{+}$, the base $x$ tends to $0$ and the exponent $1/\\ln x$ tends to $0$, so the limit has the form $0^0$. What is $\\displaystyle\\lim_{x\\to0^{+}}f(x)$?","options":["$0$","$1$","It does not exist, since $0^0$ is undefined","$\\mathrm{e}$"],"answer_mode":"server","feedback_revision":"92df7b62204fe51bcb1e6e9a","time_limit":35}]}}