on":"cf7a5794a2497fbcc56aa4f9"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_003","difficulty":"basic","question_type":"application","question":"What indeterminate form is associated with $\\lim_{x\\to 0}\\frac{\\sin x}{x}$?","options":["$\\dfrac{\\infty}{\\infty}$","$0\\times\\infty$","$1^\\infty$","$\\dfrac{0}{0}$"],"answer_mode":"server","feedback_revision":"609f68c8987da7b4f6e08637"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_004","difficulty":"basic","question_type":"application","question":"What is the value of $\\displaystyle\\lim_{x\\to 0}\\frac{\\sin x}{x}$?","options":["$1$","$0$","$\\infty$","It diverges."],"answer_mode":"server","feedback_revision":"4283cfd2a7a2082df11acb34"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_005","difficulty":"standard","question_type":"conceptual","question":"What does an indeterminate form tell you about a limit problem?","options":["The limit must be $0$.","The limit must diverge.","The limit has already been determined.","Further analysis is required."],"answer_mode":"server","feedback_revision":"6dc4babbde09ded8306c57bf"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_006","difficulty":"standard","question_type":"conceptual","question":"Do two limits sharing the same indeterminate form (such as $0/0$) always have the same value?","options":["Every expression with the same symbolic form has the same limit.","Different expressions with the same symbolic form may have different limits.","An indeterminate form determines divergence.","Algebraic manipulation is never useful."],"answer_mode":"server","feedback_revision":"f4de32d94a45db9315ba515d"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_007","difficulty":"standard","question_type":"application","question":"What indeterminate form is associated with $\\lim_{x\\to +\\infty}\\mathrm{e}^{-x}x$?","options":["$\\infty-\\infty$","$0^0$","$0\\times\\infty$","$\\dfrac{0}{0}$"],"answer_mode":"server","feedback_revision":"2b2785cee8f1cd3c0118dc97"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_008","difficulty":"standard","question_type":"application","question":"What is the value of $\\displaystyle\\lim_{x\\to +\\infty}\\mathrm{e}^{-x}x$?","options":["$1$","$\\infty$","It does not exist.","$0$"],"answer_mode":"server","feedback_revision":"69a7b6b8be59772a37b8c16d"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_009","difficulty":"challenge","question_type":"conceptual","question":"Which conclusion is valid when direct limit-law substitution gives $\\dfrac{0}{0}$?","options":["The limit must be $0$.","The limit must be $1$.","The limit must diverge under the stated limiting assumptions.","The symbolic form alone does not determine the limit."],"answer_mode":"server","feedback_revision":"611f2e1b0ac228d11878636b"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_010","difficulty":"challenge","question_type":"conceptual","question":"Which list contains only forms that are typical indeterminate forms?","options":["$0+0$, $1+\\infty$, and $\\infty^1$","$0^0$, $1^\\infty$, and $\\infty^0$","$\\dfrac{1}{0}$, $0+\\infty$, and $2^0$","$1^0$, $\\infty+\\infty$, and $0+1$"],"answer_mode":"server","feedback_revision":"a85070c556a55b8b1549a931"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_011","difficulty":"challenge","question_type":"application","question":"Both expressions have direct form $\\dfrac{0}{0}$ as $x\\to 0$: $\\dfrac{x}{x}$ and $\\dfrac{x^2}{x}$. What are their limits?","options":["$0$ and $1$","$1$ and $1$","$1$ and $0$","Both diverge."],"answer_mode":"server","feedback_revision":"0ff50e4c14368b6ad33daff1"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_012","difficulty":"challenge","question_type":"application","question":"A student sees the form $0\\times\\infty$ and concludes that the limit must diverge. What is the best correction?","options":["That form always equals $0$.","That form is indeterminate; the limit needs further analysis.","That form always equals $\\infty$.","That form is not in the list of typical indeterminate forms."],"answer_mode":"server","feedback_revision":"9fc7d414129082e2fa9468f5"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_013","difficulty":"basic","question_type":"conceptual","question":"Why is $1^\\infty$ called an indeterminate form?","options":["It always equals $1$ as a limit","It does not by itself determine the limiting value","It always diverges to $+\\infty$","It is not one of the listed symbolic forms"],"answer_mode":"server","feedback_revision":"ffa0e61c534787cf79d0db37"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_014","difficulty":"basic","question_type":"conceptual","question":"Which expression is a typical indeterminate form?","options":["$1+\\infty$","$2^0$","$\\infty-\\infty$","$0+0$"],"answer_mode":"server","feedback_revision":"1b0baa8e32083ab72388405c"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_015","difficulty":"basic","question_type":"conceptual","question":"What is usually needed after direct substitution gives an indeterminate form?","options":["Immediate declaration that the limit diverges","Further analysis such as algebraic manipulation","Replacement of the limit by $0$","Ignoring the original expression"],"answer_mode":"server","feedback_revision":"c1c096b3636d11c5969bab27"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_016","difficulty":"basic","question_type":"application","question":"What symbolic form appears in $\\displaystyle\\lim_{x\\to 1}\\frac{x^2-1}{x-1}$ before simplification?","options":["$\\dfrac{\\infty}{\\infty}$","$\\dfrac{0}{0}$","$1^\\infty$","$\\infty-\\infty$"],"answer_mode":"server","feedback_revision":"e3496ce60a5f9fcea9f8bf28"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_017","difficulty":"basic","question_type":"application","question":"What symbolic form appears in $\\displaystyle\\lim_{x\\to+\\infty}\\frac{x}{x+1}$ before further analysis?","options":["$\\dfrac{0}{0}$","$\\dfrac{\\infty}{\\infty}$","$0\\times\\infty$","$0^0$"],"answer_mode":"server","feedback_revision":"eb98684f7c43de7d83c16786"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_018","difficulty":"basic","question_type":"application","question":"What symbolic form appears in $\\displaystyle\\lim_{x\\to+\\infty} x^2\\mathrm e^{-x}$?","options":["$\\infty-\\infty$","$0\\times\\infty$","$1^\\infty$","$\\dfrac{0}{0}$"],"answer_mode":"server","feedback_revision":"d3d7efa652cb687e26ede46f"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_019","difficulty":"standard","question_type":"conceptual","question":"Why can two limits with the same indeterminate form have different answers?","options":["The symbolic form uniquely fixes the limit.","Every indeterminate form must diverge","The form lacks information about the rates involved.","Every indeterminate form must equal $1$"],"answer_mode":"server","feedback_revision":"9f1c6c8c355343ae611dabf6"},{"id":"year_1_1a_math_i_calculus_indeterminate_form_a4830cbc_020","difficulty":"standard","question_type":"application","question":"The form of $\\displaystyle\\lim_{x\\to+\\infty}\\frac{x+1}{x}$ is $\\infty/\\infty$. What is the limit?","options":["$0$","$1$","$+\\infty$","It cannot be discussed because the form is indeterminate"],"answer_mode":"server","feedback_revision":"8c8ce77d891afe6f40e17471"}]}}