th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1a-Math-I-Calculus/bounded-function.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/bounded-function.html","questions":[{"id":"year_1_1a_math_i_calculus_bounded_function_816f3996_001","difficulty":"basic","question_type":"conceptual","question":"What does it mean for $f\\colon X\\to\\mathbb{R}$ to be bounded?","options":["Some $M$ bounds $|f(x)|$ for all $x\\in X$.","For each $x\\in X$ some $M$ bounds $|f(x)|$.","Some $M$ has $f(x)\\le M$ for all $x\\in X$.","Some $M$ bounds $|x|$ for all $x\\in X$."],"answer_mode":"server","feedback_revision":"a0ec1791cd63d87b485020a3","time_limit":35},{"id":"year_1_1a_math_i_calculus_bounded_function_816f3996_002","difficulty":"basic","question_type":"conceptual","question":"What does bounded from above mean for $f\\colon X\\to\\mathbb{R}$?","options":["There is $M$ such that $f(x) \\ge M$ for all $x\\in X$","$f$ has no upper bound","$f$ takes only one value","There is $M$ such that $f(x) \\le M$ for all $x\\in X$"],"answer_mode":"server","feedback_revision":"98c7ab97810b64de711126bd","time_limit":30},{"id":"year_1_1a_math_i_calculus_bounded_function_816f3996_003","difficulty":"basic","question_type":"application","question":"Which example is bounded on $\\mathbb{R}$?","options":["$f(x) = \\sin x$","$f(x) = x$","$f(x) = x^2$","$f(x) = \\frac{1}{x}$ on $\\mathbb{R}$"],"answer_mode":"server","feedback_revision":"cd401bd159770773fe36feda","time_limit":20},{"id":"expansion_005_bounded_function_001","difficulty":"basic","question_type":"conceptual","question":"What does it mean for $f\\colon X\\to\\mathbb{R}$ to be bounded from below?","options":["There is a real $M$ such that $f(x)\\le M$ for all $x\\in X$.","There is a real $M$ such that $f(x)\\ge M$ for all $x\\in X$.","$f(x)=0$ for all $x\\in X$.","$|f(x)|$ increases without bound."],"answer_mode":"server","feedback_revision":"0ee98b7ce0a752a8a290031f","time_limit":35},{"id":"expansion_005_bounded_function_005","difficulty":"basic","question_type":"application","question":"Is $f(x)=x$ bounded on $[0,1]$, and if so by what?","options":["It is unbounded on $[0,1]$.","It is bounded only from below, not from above.","It is bounded, for example by $M=1$.","It has no range."],"answer_mode":"server","feedback_revision":"ccd6f795ebc560c4b480e126","time_limit":25},{"id":"year_1_1a_math_i_calculus_bounded_function_816f3996_curated20261026_001","difficulty":"standard","question_type":"application","question":"Let $f\\colon\\mathbb{R}\\setminus\\{0,1,2\\}\\to\\mathbb{R}$ be $f(x)=\\dfrac{|x|}{x(x-1)(x-2)}$. On which listed interval is $f$ bounded?","options":["$(-1,0)$","$(0,1)$","$(1,2)$","$(2,3)$"],"answer_mode":"server","feedback_revision":"6efea78f4e6113fb8f66ffd7","time_limit":30},{"id":"year_1_1a_math_i_calculus_bounded_function_816f3996_curated20261026_002","difficulty":"basic","question_type":"conceptual","question":"Let $f\\colon X\\to\\mathbb{R}$ be bounded and let $Y\\subseteq X$. What is guaranteed for the restriction of $f$ to $Y$?","options":["Every magnitude bound valid on $X$ is still valid on $Y$.","Every magnitude bound must become strictly smaller on $Y$.","The restriction is bounded only if $Y$ is a finite set.","The restriction must attain a maximum value on $Y$."],"answer_mode":"server","feedback_revision":"516bce96260b0a13d3ecf46d","time_limit":35},{"id":"year_1_1a_math_i_calculus_bounded_function_816f3996_curated20261026_003","difficulty":"basic","question_type":"application","question":"If $|f(x)| \\le 3$ and $|g(x)| \\le 2$ for all $x\\in X$, what can be concluded about $f+g$?","options":["$f+g$ is bounded.","The least nonnegative bound for $|f+g|$ must be $5$.","$f+g$ is bounded only if $f$ and $g$ have the same bound.","$f+g$ may be unbounded because the signs can differ."],"answer_mode":"server","feedback_revision":"fea4b8e0b676e9a7fb703f4a","time_limit":35},{"id":"year_1_1a_math_i_calculus_bounded_function_816f3996_curated20261026_004","difficulty":"basic","question_type":"application","question":"On a nonempty set $X$, assume $|f(x)|\\le4$ for every $x\\in X$. Which listed bound for $|2f(x)|$ is guaranteed for every such $f$?","options":["$2$","$8$","$4$","$6$"],"answer_mode":"server","feedback_revision":"17c8322064ce510dd5e6f080","time_limit":25},{"id":"year_1_1a_math_i_calculus_bounded_function_816f3996_curated20261026_005","difficulty":"basic","question_type":"conceptual","question":"Why does the definition of boundedness use $|f(x)| \\le M$ rather than only $f(x) \\le M$?","options":["It controls only the upper behaviour of $f$.","It bounds the inputs $x$ as well as the outputs.","It controls both upper and lower behaviour.","It forces the outputs $f(x)$ to be non-negative."],"answer_mode":"server","feedback_revision":"9bbdcf73d17628025613db66","time_limit":30},{"id":"year_1_1a_math_i_calculus_bounded_function_816f3996_curated20261026_006","difficulty":"basic","question_type":"application","question":"A function on a nonempty domain satisfies $-2\\le f(x)\\le5$ everywhere. Which nonnegative $M$ is guaranteed to satisfy $|f(x)|\\le M$?","options":["$M = 2$","$M = 3$","$M = 5$","$M = -5$"],"answer_mode":"server","feedback_revision":"28cd9dd12873f000b238d063","time_limit":25},{"id":"year_1_1a_math_i_calculus_bounded_function_816f3996_curated20261026_007","difficulty":"basic","question_type":"application","question":"Which function is bounded from below on $\\mathbb{R}$ but not bounded?","options":["$f(x) = \\sin x$","$f(x) = x^2$","$f(x) = -x^2$","$f(x) = x^3$"],"answer_mode":"server","feedback_revision":"9f0ef685b82dc84cca8e687b","time_limit":20},{"id":"expansion_005_bounded_function_curated20261026_008","difficulty":"basic","question_type":"conceptual","question":"For $f\\colon X\\to\\mathbb{R}$, which statement is equivalent to $f$ being unbounded?","options":["Some $x$ has $|f(x)|>M$ for every real $M$.","No real $M$ bounds $|f(x)|$ for all $x$.","No real $M$ satisfies $f(x)\\le M$ for all $x$.","The domain $X$ contains arbitrarily large real numbers."],"answer_mode":"server","feedback_revision":"88ca15a7631d6a310c0d9a03","time_limit":35},{"id":"expansion_005_bounded_function_curated20261026_009","difficulty":"basic","question_type":"conceptual","question":"If $f$ and $g$ are bounded on $X$, is $fg$ bounded?","options":["Yes; $|fg|\\le M_fM_g$","No, never","Only if $f=g$","Only on finite domains"],"answer_mode":"server","feedback_revision":"e33dc87e9fbf218fc304a2d9","time_limit":25},{"id":"expansion_005_bounded_function_curated20261026_010","difficulty":"basic","question_type":"application","question":"Which example shows a bounded function that does not attain its supremum?","options":["$f(x)=x$ on $(0,1)$: supremum $1$ is not attained","$f(x)=1$ on $\\mathbb{R}$: supremum $1$ is attained","$f(x)=x^2$ on $[0,1]$: supremum $1$ is attained","$f(x)=\\sin x$ on $\\mathbb{R}$: supremum $1$ is attained"],"answer_mode":"server","feedback_revision":"62f48680a1503017fb5d8dfb","time_limit":35}]}}