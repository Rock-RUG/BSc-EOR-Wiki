_mode":"server","feedback_revision":"c7ab5ed55562b67cd45a718d"},{"id":"year_1_1a_math_i_calculus_multiplication_and_product_27e68640_009","difficulty":"challenge","question_type":"conceptual","question":"Which statement correctly contrasts $0$ and $1$ for multiplication?","options":["$0$ and $1$ are both absorbing","$1$ is absorbing, while $0$ acts as an identity","$0$ has no role in multiplication","$0$ is absorbing, $1$ is the identity ($n\\times1=n$)"],"answer_mode":"server","feedback_revision":"41b00fdf934a43a862c00bce"},{"id":"year_1_1a_math_i_calculus_multiplication_and_product_27e68640_010","difficulty":"challenge","question_type":"conceptual","question":"Which statement correctly distinguishes associativity from distributivity?","options":["Associativity regroups factors; distributivity connects multiplication with addition.","Associativity swaps factors; distributivity supplies the multiplicative identity.","Associativity removes zero; distributivity reverses the signs of both factors.","Associativity changes products into sums; distributivity only changes parentheses."],"answer_mode":"server","feedback_revision":"6d05c2cc247c98709cacf1cb"},{"id":"year_1_1a_math_i_calculus_multiplication_and_product_27e68640_011","difficulty":"challenge","question_type":"application","question":"Using $7\\times19=7(20-1)\\text{,}$ what value follows from distributivity?","options":["$140$","$126$","$137$","$133$"],"answer_mode":"server","feedback_revision":"a45369bdee6cf4725c851698"},{"id":"year_1_1a_math_i_calculus_multiplication_and_product_27e68640_012","difficulty":"challenge","question_type":"application","question":"Which expression is justified by the distributive law?","options":["$(2+3)4 = 2\\times4+3\\times4$","$(2+3)4 = 2+3\\times4$","$(2+3)4 = 2\\times3+4$","$(2+3)4 = 2\\times3\\times4$"],"answer_mode":"server","feedback_revision":"84567be2a06c84020140add4"},{"id":"expansion_pack_050_multiplication_and_product_add_001","difficulty":"basic","question_type":"conce