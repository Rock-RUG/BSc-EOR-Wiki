revision":"6ec6bc47700a9b0bd3475354"},{"id":"year_1_1a_math_i_calculus_definite_integral_b3773620_003","difficulty":"basic","question_type":"application","question":"Which value is correct?","options":["$\\int_0^1 x\\,\\mathrm{d}x = \\frac{1}{2}$","$\\int_0^1 x\\,\\mathrm{d}x = 1$","$\\int_0^1 x\\,\\mathrm{d}x = 0$","$\\int_0^1 x\\,\\mathrm{d}x = 2$"],"answer_mode":"server","feedback_revision":"56a1ae5cdf73a805f1943992"},{"id":"year_1_1a_math_i_calculus_definite_integral_b3773620_004","difficulty":"basic","question_type":"application","question":"What is $\\int_{-1}^{1} x\\,\\mathrm{d}x$?","options":["$\\int_{-1}^1 x\\,\\mathrm{d}x = 1$","$\\int_{-1}^1 x\\,\\mathrm{d}x = 0$","$\\int_{-1}^1 x\\,\\mathrm{d}x = -1$","$\\int_{-1}^1 x\\,\\mathrm{d}x = \\frac{1}{2}$"],"answer_mode":"server","feedback_revision":"d5dbca6ac130ddf44c4c4bf4"},{"id":"year_1_1a_math_i_calculus_definite_integral_b3773620_005","difficulty":"standard","question_type":"conceptual","question":"Which statement describes the role of the variable in $\\int_a^b f(x)\\,\\mathrm{d}x$?","options":["The value becomes a function of the new variable.","The value changes sign whenever the variable name changes.","The variable name determines whether $f$ is integrable.","The value is unchanged if $x$ is replaced by another variable."],"answer_mode":"server","feedback_revision":"6c3d4746a61e7321900e1748"},{"id":"year_1_1a_math_i_calculus_definite_integral_b3773620_006","difficulty":"standard","question_type":"conceptual","question":"What interpretation is given for the definite integral?","options":["Accumulated value and net area over an interval.","It is only a test for countability.","It is a derivative at a single point.","It is the same as the empty set."],"answer_mode":"server","feedback_revision":"0290e574b1d537ebe6454918"},{"id":"year_1_1a_math_i_calculus_definite_integral_b3773620_007","difficulty":"standard","question_type":"application","question":"If $\\int_a^b f(x)\\,\\mathrm{d}x = 5$, what is $\\int_a^b f(y)\\,\\mathrm{d}y$?","options":["$0$","$y$","$5y$","$5$"],"answer_mode":"server","feedback_revision":"a5260993a0c4d0ebd210aef1"},{"id":"year_1_1a_math_i_calculus_definite_integral_b3773620_008","difficulty":"standard","question_type":"application","question":"Which equality expresses the additive behaviour over a subinterval $[a,c]$ and $[c,b]$?","options":["$\\int_a^b f(x)\\,\\mathrm{d}x = \\int_a^c f(x)\\,\\mathrm{d}x+\\int_c^b f(x)\\,\\mathrm{d}x$","$\\int_a^b f(x)\\,\\mathrm{d}x = \\int_a^c f(x)\\,\\mathrm{d}x-\\int_c^b f(x)\\,\\mathrm{d}x$","$\\int_a^b f(x)\\,\\mathrm{d}x = f(a)+f(b)$","$\\int_a^b f(x)\\,\\mathrm{d}x = f(c)$"],"answer_mode":"server","feedback_revision":"b3b27730463fc344a27c7e67"},{"id":"year_1_1a_math_i_calculus_definite_integral_b3773620_009","difficulty":"challenge","question_type":"conceptual","question":"Which statement correctly reflects invariance under partition refinement?","options":["Refining the partition always doubles the definite integral.","Refining the partition changes the dummy variable into a function.","Refining the partition makes every function non-integrable.","Refining the partition does not change the value of the definite integral."],"answer_mode":"server","feedback_revision":"c208c39a9f2af0230c85493d"},{"id":"year_1_1a_math_i_calculus_definite_integral_b3773620_010","difficulty":"challenge","question_type":"conceptual","question":"Which warning is consistent with the definition?","options":["Every formula has a definite integral on every interval.","The definite integral is defined before choosing any interval.","Without Riemann integrability on $[a,b]$, the integral isn't guaranteed.","The definite integral is always a function of the integration variable."],"answer_mode":"server","feedback_revision":"f188302ceeab902eabf9dcdf"},{"id":"year_1_1a_math_i_calculus_definite_integral_b3773620_011","difficulty":"challenge","question_type":"application","question":"If $\\int_0^1 x\\,\\mathrm{d}x = \\frac{1}{2}$, which expression has the same value by dummy-variable invariance?","options":["$\\int_0^1 y\\,\\mathrm{d}x$","$\\int_0^1 x\\,\\mathrm{d}y$","$\\int_0^1 y\\,\\mathrm{d}y$","$\\int_0^1 1\\,\\mathrm{d}x$"],"answer_mode":"server","feedback_revision":"723f03d9460d85be64892fe7"},{"id":"year_1_1a_math_i_calculus_definite_integral_b3773620_012","difficulty":"challenge","question_type":"application","question":"Suppose an integrable function has $\\int_a^c f(x)\\,\\mathrm{d}x = 2$ and $\\int_c^b f(x)\\,\\mathrm{d}x = 3$. What is $\\int_a^b f(x)\\,\\mathrm{d}x$ by additivity?","options":["$5$","$1$","$6$","$0$"],"answer_mode":"server","feedback_revision":"59c4899819c74d8d2e0391a3"},{"id":"expansion_pack_013_definite_integral_new_001","difficulty":"basic","question_type":"conceptual","question":"What does the notation $\\int_a^b f(x)\\,\\mathrm{d}x$ represent?","options":["The derivative of $f$ at $a$.","A function of $x$ after integration.","A definite integral over $[a,b]$.","A partition of $\\mathbb{R}$ only."],"answer_mode":"server","feedback_revision":"59ca535d98f604d0d691051c"},{"id":"expansion_pack_013_definite_integral_new_002","difficulty":"basic","question_type":"conceptual","question":"Why is $x$ called a dummy variable in a definite integral?","options":["It must equal the lower endpoint.","It determines the value independently of $f$.","It makes the integral a function of $x$.","Renaming it does not change the integral's value."],"answer_mode":"server","feedback_revision":"69b4598d12f124ebc7cf6142"},{"id":"expansion_pack_013_definite_integral_new_003","difficulty":"basic","question_type":"conceptual","question":"Which condition on $f$ is needed for $\\int_a^b f(x)\\,\\mathrm{d}x$?","options":["$f$ is Riemann integrable on $[a,b]$.","$f$ is undefined on $[a,b]$.","$f$ is uncountable.","$f$ must be a set."],"answer_mode":"server","feedback_revision":"6a5aa44a012dc426d1d930f5"},{"id":"expansion_pack_013_definite_integral_new_004","difficulty":"basic","question_type":"application","question":"If $\\int_2^5 f(x)\\,\\mathrm{d}x=7$, what is $\\int_2^5 f(t)\\,\\mathrm{d}t$?","options":["$7t$","$0$","$t$","$7$"],"answer_mode":"server","feedback_revision":"2fd766256b883a9055d3a203"},{"id":"expansion_pack_013_definite_integral_new_005","difficulty":"basic","question_type":"application","question":"What are the lower and upper bounds in $\\int_0^1 x\\,\\mathrm{d}x$?","options":["Lower bound $0$, upper bound $1$.","Lower bound $1$, upper bound $0$.","Both bounds are $x$.","There are no bounds."],"answer_mode":"server","feedback_revision":"5c163e0bd56a3aa91dbe2ce2"},{"id":"expansion_pack_013_definite_integral_new_006","difficulty":"basic","question_type":"application","question":"Which expression is a real number rather than a function of $x$?","options":["$f(x)$","$x+a$","$\\int_a^b f(x)\\,\\mathrm{d}x$","$f'(x)$"],"answer_mode":"server","feedback_revision":"6850944e25dd0636502739e9"},{"id":"expansion_pack_013_definite_integral_new_007","difficulty":"standard","question_type":"conceptual","question":"What does a definite integral encode geometrically?","options":["Only the value of $f$ at one endpoint.","Net area over an interval.","The number of rational inputs.","The derivative at the midpoint."],"answer_mode":"server","feedback_revision":"79a0441add5ea0b586ad11d7"},{"id":"expansion_pack_013_definite_integral_new_008","difficulty":"standard","question_type":"application","question":"If $\\int_a^c f(x)\\,\\mathrm{d}x=2$ and $\\int_c^b f(x)\\,\\mathrm{d}x=3$, what is $\\int_a^b f(x)\\,\\mathrm{d}x$?","options":["$1$","$5$","$6$","$0$"],"answer_mode":"server","feedback_revision":"0704ed0d8e37ebea4de33bfc"}]}}