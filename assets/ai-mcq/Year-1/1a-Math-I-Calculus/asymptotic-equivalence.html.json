r_mode":"server","feedback_revision":"d4c9e21260b53de989e982a5"},{"id":"year_1_1a_math_i_calculus_asymptotic_equivalence_3eb0a15f_012","difficulty":"challenge","question_type":"application","question":"If $\\ln(1+x)\\sim x$ as $x\\to 0$, what is the asymptotically equivalent denominator for $\\frac{\\sin x}{\\ln(1+x)}$ near $0$?","options":["$1$","$x^2$","$x$","$\\ln x$"],"answer_mode":"server","feedback_revision":"a5f384fd6db5623126a1aba8"},{"id":"expansion_004_asymptotic_equivalence_001","difficulty":"basic","question_type":"conceptual","question":"What ratio condition is required for $f(x)\\sim g(x)$ as $x\\to a$?","options":["$\\lim_{x\\to a}(f(x)-g(x))=1$","$\\lim_{x\\to a}\\frac{f(x)}{g(x)}=1$","$\\lim_{x\\to a}f(x)=a$","$f(x)=g(x)$ for every $x$"],"answer_mode":"server","feedback_revision":"7c4df380170b6968fe60d9f6"},{"id":"expansion_004_asymptotic_equivalence_002","difficulty":"basic","question_type":"conceptual","question":"Which property says that $f\\sim g$ implies $g\\sim f$?","options":["Transitivity","Commutativity of addition","Symmetry","Boundedness"],"answer_mode":"server","feedback_revision":"526cc713ac77561d39ea651b"},{"id":"expansion_004_asymptotic_equivalence_003","difficulty":"basic","question_type":"conceptual","question":"What does asymptotic equivalence compare most directly?","options":["Only absolute difference","Relative behaviour through a ratio","Only the signs of the functions","Only values at $x=0$"],"answer_mode":"server","feedback_revision":"934abcea33ddde0ea13cb17b"},{"id":"expansion_004_asymptotic_equivalence_004","difficulty":"basic","question_type":"application","question":"Which equivalence is a standard example as $x\\to0$?","options":["$\\sin x\\sim 1$","$x\\sim x^2$","$\\sin x\\sim x$","$\\ln(1+x)\\sim 1$"],"answer_mode":"server","feedback_revision":"3e69d9a5ccb38ee08cb9f63e"},{"id":"expansion_004_asymptotic_equivalence_005","difficulty":"basic","question_type":"application","question":"If $\\lim_{x\\to a}\\frac{f(x)}{g(x)}=1$, which ratio condition also follows when the quotient is defined near $a$?","options":["$\\lim_{x\\to a}\\frac{g(x)}{f(x)}=0$","$\\lim_{x\\to a}\\frac{f(x)}{g(x)}=0$","$\\lim_{x\\to a}\\frac{g(x)}{f(x)}=1$","$\\lim_{x\\to a}(f(x)+g(x))=1$"],"answer_mode":"server","feedback_revision":"f9d4ad980ccb3fcdb70aed4e"},{"id":"expansion_004_asymptotic_equivalence_007","difficulty":"standard","question_type":"conceptual","question":"Where may equivalent functions be substituted?","options":["In sums where cancellation has not been checked","In every equation between the original functions","In inequalities between arbitrary sets","In limits involving products or quotients"],"answer_mode":"server","feedback_revision":"55fe872e85c4a4f116c69816"},{"id":"expansion_004_asymptotic_equivalence_008","difficulty":"standard","question_type":"application","question":"If $f\\sim g$ and $g\\sim h$ as $x\\to a$, what follows?","options":["$f\\sim h$ as $x\\to a$","$f=h$ for every $x$","$f\\not\\sim h$","$f/g\\to0$"],"answer_mode":"server","feedback_revision":"d4591c5025f66f0ca2e26a8e"},{"id":"repair_asymptotic_equivalence_001","difficulty":"basic","question_type":"application","question":"Let $f(x)=x+x^2$ and $g(x)=x$. What is the correct conclusion as $x\\to0$?","options":["$f(x)\\not\\sim g(x)$, because $f(x)\\neq g(x)$ for all nearby $x\\neq0$.","$f(x)\\sim g(x)$, because $\\dfrac{f(x)}{g(x)}=1+x\\to1$.","$f(x)\\sim g(x)$, because $f(0)=g(0)$.","$f(x)\\not\\sim g(x)$, because both functions tend to $0$."],"answer_mode":"server","feedback_revision":"ac306ad0e7001629cb76221e"}]}}