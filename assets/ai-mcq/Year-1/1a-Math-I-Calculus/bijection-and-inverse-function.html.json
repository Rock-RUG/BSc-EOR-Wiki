aint"],"answer_mode":"server","feedback_revision":"06233eb0315a5db58280c8eb"},{"id":"expansion_005_bijection_and_inverse_function_007","difficulty":"standard","question_type":"conceptual","question":"What does composing a bijection with its inverse recover?","options":["A constant function","The square of the function, which is wrong","The identity function on the appropriate set","A non-injective function"],"answer_mode":"server","feedback_revision":"f76fdac6757bfb5e860b9783"},{"id":"expansion_005_bijection_and_inverse_function_008","difficulty":"standard","question_type":"conceptual","question":"The graph of $f^{-1}$ is the graph of $f$ reflected across which line?","options":["$y=x$","the $x$-axis","the $y$-axis","$y=-x$"],"answer_mode":"server","feedback_revision":"4da43ef90245f2eb33e68f22"}]}}