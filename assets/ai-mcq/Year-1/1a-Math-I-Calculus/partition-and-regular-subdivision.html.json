ck_revision":"fff696d1836646bab2f12251","time_limit":35},{"id":"year_1_1a_math_i_calculus_partition_and_regular_subdivision_fff8c78c_007_curated20261027_002","difficulty":"basic","question_type":"application","question":"Let $P=\\{0,\\,0.2,\\,0.5,\\,1\\}$ be a partition of $[0,1]$. What is its mesh $\\lVert P\\rVert$?","options":["$0.5$","$0.2$","$\\frac{1}{3}$","$\\frac{1}{4}$"],"answer_mode":"server","feedback_revision":"2f6711e18e11a2f3d2e6bb2c","time_limit":20},{"id":"year_1_1a_math_i_calculus_partition_and_regular_subdivision_fff8c78c_008_curated20261027_003","difficulty":"basic","question_type":"application","question":"Which set of points is a partition of $[0,1]$ but not a regular subdivision?","options":["$\\{0,\\tfrac{1}{2},1\\}$","$\\{0,1\\}$","$\\{0,\\tfrac{1}{2}\\}$","$\\{0,\\tfrac{1}{4},1\\}$"],"answer_mode":"server","feedback_revision":"90e161462632036481a73be8","time_limit":20},{"id":"year_1_1a_math_i_calculus_partition_and_regular_subdivision_fff8c78c_010_curated20261027_004","difficulty":"standard","question_type":"application","question":"For each $n\\ge2$, let $P_n$ be a partition of $[0,1]$ with $n+1$ points and $x_1=\\frac{1}{2}$. What happens to the mesh $\\lVert P_n\\rVert$ as $n\\to\\infty$?","options":["$\\lVert P_n\\rVert=\\frac{1}{2}$ for every $n$, so it does not tend to $0$.","$\\lVert P_n\\rVert\\to0$, because the number of points tends to infinity.","$\\lVert P_n\\rVert=\\frac{1}{n}$, the length of each piece.","$\\lVert P_n\\rVert$ cannot be found without knowing the points $x_2,\\dots,x_{n-1}$."],"answer_mode":"server","feedback_revision":"8ed8d821c3cc68593e565b02","time_limit":40},{"id":"year_1_1a_math_i_calculus_partition_and_regular_subdivision_fff8c78c_011_curated20261027_005","difficulty":"basic","question_type":"conceptual","question":"Let $P=\\{0,\\tfrac{1}{2},1\\}$, a partition of $[0,1]$. Which statement is true?","options":["$P$ has $3$ points and $2$ subintervals, $[0,\\tfrac{1}{2}]$ and $[\\tfrac{1}{2},1]$, which share $\\tfrac{1}{2}$.","$P$ is not a partition, because $\\tfrac{1}{2}$ lies in both $[0,\\tfrac{1}{2}]$ and $[\\tfrac{1}{2},1]$.","$P$ has $3$ subintervals, one for each of its points.","Its subintervals are $[0,\\tfrac{1}{2})$ and $[\\tfrac{1}{2},1]$, so $\\tfrac{1}{2}$ lies in only one of them."],"answer_mode":"server","feedback_revision":"23f22183c2484e89e63ac983","time_limit":40},{"id":"year_1_1a_math_i_calculus_partition_and_regular_subdivision_fff8c78c_topup20261028_001","difficulty":"basic","question_type":"application","question":"Let $P=\\{x_0,x_1,x_2,x_3,x_4\\}$ with $x_0<x_1<x_2<x_3<x_4$ be the regular subdivision of $[2,8]$ into $4$ subintervals. What is $x_3$?","options":["$4.5$","$5$","$6.5$","$6$"],"answer_mode":"server","feedback_revision":"d6f11dc4fd870209446cff01","time_limit":25},{"id":"year_1_1a_math_i_calculus_partition_and_regular_subdivision_fff8c78c_topup20261028_002","difficulty":"standard","question_type":"conceptual","question":"Let $a<b$ and $n\\ge2$, and let $P$ be any partition of $[a,b]$ into $n$ subintervals, with mesh $\\lVert P\\rVert$. Which statement holds for every such $P$?","options":["$\\lVert P\\rVert=\\frac{b-a}{n}$","$\\lVert P\\rVert\\ge\\frac{b-a}{n}$","$\\lVert P\\rVert\\le\\frac{b-a}{n}$","$\\lVert P\\rVert$ can be any number in $(0,b-a)$"],"answer_mode":"server","feedback_revision":"ba4270de0486203a7edabbb7","time_limit":35}]}}