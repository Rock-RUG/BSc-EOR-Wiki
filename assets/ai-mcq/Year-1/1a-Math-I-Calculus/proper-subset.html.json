{"version":"ai-mcq-bank-v2-la-batch15-high-quality-rewritten-affected-2026-05-22-stem-fixed-inequality-rendering-fixed-student-facing-qc-2026-05-31-pt-foundations-2026-06-11-pt-batch2-foundations-counting-2026-06-11-pt-batch3-counting-probability-rules-2026-06-11-pt-batch4-conditioning-2026-06-11-pt-batch5-random-variables-2026-06-11-pt-batch6-discrete-distributions-2026-06-11-pt-batch7-distribution-foundations-2026-06-11-pt-batch8-continuous-expectation-2026-06-11-pt-batch9-non-week7-expectation-transform-2026-06-11-pt-batch10-non-week7-process-summary-2026-06-11-pt-batch11-non-week7-final-summary-shape-2026-06-11-quality-round1-2026-06-14-quality-round2-2026-06-14-quality-round3-2026-06-14-quality-round4-deep-2026-06-14+quality-round5-difficulty-2026-06-14+quality-round6-expression-2026-06-14+quality-round7-answer-cue-2026-06-14+quality-round8-answer-shape-2026-06-14+quality-round9-answer-position-2026-06-14+quality-round10-template-padding-2026-06-14+quality-round11-generic-stems-2026-06-14+quality-round12-deterministic-cleanup-2026-06-15+quality-pilot-deep-rework-2026-06-15","concept_id":"Year-1/1a-Math-I-Calculus/proper-subset.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/proper-subset.html","questions":[{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_001","difficulty":"basic","question_type":"conceptual","question":"What does $A\\subset B$ mean for sets $A$ and $B$?","options":["$B\\subseteq A$ and $A\\ne B$.","$A = B$.","$A$ and $B$ have no elements in common.","$A\\subseteq B$ and $A\\ne B$."],"answer_mode":"server","feedback_revision":"eace435289ad1290367bf645"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_002","difficulty":"basic","question_type":"conceptual","question":"Which notation is used for proper subset?","options":["$A = B$ only.","$A\\in B$ only.","$A\\subset B$ or $A\\subsetneq B$.","$A+B$."],"answer_mode":"server","feedback_revision":"40cef250a41958d5814b79ea"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_003","difficulty":"basic","question_type":"application","question":"Which inclusion is a proper-subset relation?","options":["$\\{1,2,3\\}\\subset\\{1,2\\}$.","$\\{1,2\\}\\subset\\{1,2,3\\}$.","$\\{1,2\\}\\subset\\{1,2\\}$.","$\\{3\\}\\subset\\{1,2\\}$."],"answer_mode":"server","feedback_revision":"df0ae19acb6618887e1ca551"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_004","difficulty":"basic","question_type":"application","question":"Is $\\{1,2\\}$ a proper subset of $\\{1,2\\}$?","options":["Yes, because every element is contained in itself.","Yes, because both sets are finite.","No, because a set is not a proper subset of itself.","No, because $1$ is not in the set."],"answer_mode":"server","feedback_revision":"cdab23b5339abaebdf628b70"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_005","difficulty":"standard","question_type":"conceptual","question":"Which statement correctly compares subset and proper subset?","options":["Every subset is a proper subset.","No proper subset is a subset.","Subset and proper subset mean exactly the same thing, irrespective of the particular case.","Every proper subset is a subset, but not every subset is a proper subset."],"answer_mode":"server","feedback_revision":"c84746ff589775a14f92c073"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_006","difficulty":"standard","question_type":"conceptual","question":"What extra information is needed beyond $A\\subseteq B$ to conclude $A\\subset B$?","options":["$A\\ne B$.","$A\\in B$.","$B\\subseteq A$.","$A$ must be infinite."],"answer_mode":"server","feedback_revision":"dab0b38d067cc6ba7e292c5c"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_007","difficulty":"standard","question_type":"application","question":"Let $A = \\{1\\}$, $B = \\{1,2\\}$, and $C = \\{1,2,3\\}$. Which conclusion follows from $A\\subset B$ and $B\\subset C$?","options":["$A\\subset C$.","$C\\subset A$.","$A = C$.","$B\\subset A$."],"answer_mode":"server","feedback_revision":"4f38525e059ed3c4e4e28331"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_008","difficulty":"standard","question_type":"application","question":"Which pair satisfies $A\\subseteq B$ but not $A\\subset B$?","options":["$A = \\{1\\}$ and $B = \\{1,2\\}$.","$A = \\{3\\}$ and $B = \\{1,2\\}$.","$A = \\{1,2,3\\}$ and $B = \\{1,2\\}$.","$A = \\{1,2\\}$ and $B = \\{1,2\\}$."],"answer_mode":"server","feedback_revision":"189f43933cb84c393e3a8c87"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_009","difficulty":"challenge","question_type":"conceptual","question":"Why is $A\\ne B$ essential for proper subset?","options":["It ensures $A$ has more elements than $B$.","It distinguishes strict inclusion from equality.","It makes $A$ and $B$ disjoint.","It requires $B$ to be empty."],"answer_mode":"server","feedback_revision":"caef1105a39938cb2666a4a0"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_010","difficulty":"challenge","question_type":"conceptual","question":"How is $\\varnothing$ related to a nonempty set?","options":["$\\varnothing$ is a proper subset of any nonempty set.","$\\varnothing$ is a proper subset of itself.","$\\varnothing$ is not a subset of any set.","$\\varnothing$ contains every element of every nonempty set."],"answer_mode":"server","feedback_revision":"362a5e6ff0e962ef30ca54ac"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_011","difficulty":"challenge","question_type":"application","question":"Let $A = \\{x\\in\\mathbb{R}:x = 0\\}$ and $B = \\{x\\in\\mathbb{R}:x^2 = 0\\}$. Which statement is true?","options":["$A\\subset B$ because the descriptions look different.","$A\\subseteq B$ but $A$ is not a proper subset of $B$.","$B\\subset A$ but not $A\\subseteq B$.","$A$ and $B$ are disjoint."],"answer_mode":"server","feedback_revision":"8be7b3c883ce7c667f1192ef"},{"id":"year_1_1a_math_i_calculus_proper_subset_eb1ef3a5_012","difficulty":"challenge","question_type":"application","question":"Suppose $A\\subset B$ and $B\\subseteq A$. What must be wrong?","options":["Nothing is wrong; this always happens for proper subsets, in every case without exception.","$A$ must be empty and $B$ must be empty.","$A$ must contain an element not in $B$.","They cannot both hold: $A\\subset B$ gives $A\\ne B$, but $A\\subseteq B$ and $B\\subseteq A$ give $A=B$."],"answer_mode":"server","feedback_revision":"c6a15d884530638d8eae4971"},{"id":"proper_subset_new_013","difficulty":"standard","question_type":"conceptual","question":"To show $A\\subsetneq B$ rather than only $A\\subseteq B$, what must you exhibit?","options":["An element of $B$ that is not in $A$","An element of $A$ that is not in $B$","that $A=B$","that $A\\cap B=\\varnothing$"],"answer_mode":"server","feedback_revision":"a0c3f9cfaf3469bcd92c4d6b"},{"id":"proper_subset_new_014","difficulty":"basic","question_type":"conceptual","question":"What does proper inclusion distinguish?","options":["Union from intersection","Elements from sets","Equality from strict containment","Functions from sequences"],"answer_mode":"server","feedback_revision":"c76ec154cbd0ae1d97bd864b"},{"id":"proper_subset_new_015","difficulty":"standard","question_type":"application","question":"How many proper subsets does $\\{a,b\\}$ have?","options":["$3$","$4$","$2$","$1$"],"answer_mode":"server","feedback_revision":"18d45d384c33363c6893539e"},{"id":"proper_subset_new_016","difficulty":"standard","question_type":"conceptual","question":"If $A\\subsetneq B$ for finite sets, how do their sizes compare?","options":["$|A|<|B|$","$|A|=|B|$","$|A|>|B|$","$|A|\\le|B|$, with equality possible"],"answer_mode":"server","feedback_revision":"5918891e5bd9e7c7e1718df9"},{"id":"proper_subset_new_017","difficulty":"basic","question_type":"application","question":"Let $A=\\varnothing$ and $B=\\{0\\}$. Which statement is correct?","options":["$B\\subset A$","$A\\subset B$","$A=B$","$A$ is not a subset of $B$"],"answer_mode":"server","feedback_revision":"5110b3c3b99f8cbfff3fbaf4"},{"id":"proper_subset_new_018","difficulty":"basic","question_type":"application","question":"Let $A=\\{1,3\\}$ and $B=\\{1,2,3\\}$. Which element shows that $A\\ne B$?","options":["$1$","$2$","$3$","No such element exists"],"answer_mode":"server","feedback_revision":"d6027ff6a7c3feabe75119c3"},{"id":"proper_subset_new_019","difficulty":"challenge","question_type":"conceptual","question":"Can both $A\\subsetneq B$ and $B\\subsetneq A$ hold?","options":["No; both together force A=B.","Yes, for any two sets","Only for finite sets","Only when $A=\\varnothing$"],"answer_mode":"server","feedback_revision":"369d71ff7769f00a5fc4a01b"},{"id":"proper_subset_new_020","difficulty":"standard","question_type":"conceptual","question":"Which symbol permits $A=B$: $\\subseteq$ or $\\subsetneq$?","options":["$\\subseteq$ allows $A=B$; $\\subsetneq$ does not","$\\subsetneq$ allows $A=B$; $\\subseteq$ does not","both allow $A=B$","neither allows $A=B$"],"answer_mode":"server","feedback_revision":"6dc80986c939b8697f9eaf59"}]}}