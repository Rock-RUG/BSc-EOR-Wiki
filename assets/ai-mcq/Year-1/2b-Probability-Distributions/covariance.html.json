th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/2b-Probability-Distributions/covariance.html","concept":{"concept_id":"Year-1/2b-Probability-Distributions/covariance.html","questions":[{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_001","difficulty":"basic","question_type":"conceptual","question":"For square-integrable $X$ and $Y$, which expression defines $\\operatorname{Cov}(X,Y)$?","options":["$\\mathbb{E}[XY]$","$\\mathbb{E}[(X-\\mathbb{E}X)(Y-\\mathbb{E}Y)]$","$\\mathbb{E}[X-\\mathbb{E}X]\\;\\mathbb{E}[Y-\\mathbb{E}Y]$","$\\operatorname{Var}(X)\\operatorname{Var}(Y)$"],"answer_mode":"server","feedback_revision":"2ab4e00f5c3208181abcec36","time_limit":20},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_002","difficulty":"basic","question_type":"conceptual","question":"For square-integrable random variables $X$ and $Y$, what does $\\operatorname{Cov}(X,Y)>0$ indicate?","options":["Same-direction deviations outweigh opposite-direction deviations in the average centred product","One variable must be an exact increasing affine function of the other variable","Both variables must take positive values whenever their joint probability is positive","The variables must be independent because their average centred product is positive"],"answer_mode":"server","feedback_revision":"55d3424128bf4156524e53cd","time_limit":30},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_003","difficulty":"basic","question_type":"conceptual","question":"Let $X$ and $Y$ be square-integrable with $\\operatorname{Cov}(X,Y)>0$, and let $b,d$ be real constants. Which condition makes $\\operatorname{Cov}(7+bX,-4+dY)<0$?","options":["$b+d<0$","$b<0\\text{ or }d<0$","$b\\ne d$","$bd<0$"],"answer_mode":"server","feedback_revision":"f42152af5047b90cdbd76bc8","time_limit":25},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_004","difficulty":"basic","question_type":"conceptual","question":"For square-integrable $X$ and $Y$, why does expanding the centred square for $\\operatorname{Var}(X+Y)$ give $2\\operatorname{Cov}(X,Y)$?","options":["Each centred square contributes its own variance to the covariance term","Independence is required to make the two centred cross products equal","The expansion contains two centred cross products with equal expectations","Multiplication of a random variable by two doubles its variance"],"answer_mode":"server","feedback_revision":"b1f0fbee2bed29d8221cd55d","time_limit":30},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_005","difficulty":"basic","question_type":"conceptual","question":"For $X$ uniform on $\\{-1,0,1\\}$ and $Y=X^2$, what are the covariance and the dependence of $X$ and $Y$?","options":["Covariance $0$, yet $X$ and $Y$ are dependent","Covariance $0$, so $X$ and $Y$ are independent","Positive covariance, as $Y$ grows with $|X|$","Covariance $\\tfrac{2}{3}$, equal to $\\mathbb{E}[X^2]$"],"answer_mode":"server","feedback_revision":"d019fc3ed96043dd22f4854b","time_limit":40},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_006","difficulty":"basic","question_type":"application","question":"Suppose $\\mathbb{E}[XY]=5$, $\\mathbb{E}X=2$ and $\\mathbb{E}Y=3$. What is $\\operatorname{Cov}(X,Y)$?","options":["$5$","$1$","$11$","$-1$"],"answer_mode":"server","feedback_revision":"1a2778e64149e8543c75d640","time_limit":20},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_008","difficulty":"basic","question_type":"application","question":"With $\\operatorname{Var}X=4$, $\\operatorname{Var}Y=9$ and $\\operatorname{Cov}(X,Y)=2$, compute the variance of the difference $X-Y$.","options":["$17$","$13$","$9$","$11$"],"answer_mode":"server","feedback_revision":"e762b4bf2a40bf8fd07940e2","time_limit":25},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_010","difficulty":"basic","question_type":"application","question":"A variable $X$ has variance $5$. Find the covariance between $X$ and $3-X$.","options":["$5$","$-5$","$-15$","$0$"],"answer_mode":"server","feedback_revision":"b578ad2b71f492ec4aba8f3a","time_limit":25},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_011","difficulty":"standard","question_type":"conceptual","question":"For square-integrable random variables $X$ and $Y$, what is $\\operatorname{Cov}(X+Y,X-Y)$?","options":["$\\operatorname{Var}X+\\operatorname{Var}Y$","$0$ for all such $X$ and $Y$","$\\operatorname{Var}X-\\operatorname{Var}Y-2\\operatorname{Cov}(X,Y)$","$\\operatorname{Var}X-\\operatorname{Var}Y$"],"answer_mode":"server","feedback_revision":"01f47c8aa92cbdd1c0b60360","time_limit":30},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_012","difficulty":"standard","question_type":"conceptual","question":"Let square-integrable $X$ record length in metres and $Y$ temperature in degrees Celsius. The same observations are recorded as $X'=100X$ in centimetres and $Y'=32+\\tfrac{9}{5}Y$ in degrees Fahrenheit. How does their covariance change?","options":["It is multiplied by $180$","It remains unchanged","It grows by the factor $180^2$","It is rescaled by $\\tfrac{500}{9}$"],"answer_mode":"server","feedback_revision":"f5a6257b52c30c47233ddd76","time_limit":35},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_013","difficulty":"standard","question_type":"conceptual","question":"Square-integrable $X,Y,Z$ satisfy $\\operatorname{Cov}(X,Y)=\\operatorname{Cov}(X,Z)=0$. Which covariance must also be zero?","options":["$\\operatorname{Cov}(X,YZ)$","$\\operatorname{Cov}(X^2,Y)$","$\\operatorname{Cov}(X,2Y-3Z+1)$","$\\operatorname{Cov}(Y,Z)$"],"answer_mode":"server","feedback_revision":"e44ae083331717ea13991511","time_limit":30},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_014","difficulty":"standard","question_type":"application","question":"$X_1,X_2,X_3$ each have variance $1$ and every pair has covariance $0.5$. What is $\\operatorname{Var}(X_1+X_2+X_3)$?","options":["$3$","$4.5$","$9$","$6$"],"answer_mode":"server","feedback_revision":"455f2bf2c5d0c377c64b6c07","time_limit":30},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_015","difficulty":"standard","question_type":"application","question":"Two balls are drawn uniformly at random without replacement from an urn containing $2$ red and $2$ blue balls. For $i=1,2$, let $X_i=1$ if draw $i$ is red and $X_i=0$ otherwise. What is $\\operatorname{Cov}(X_1,X_2)$?","options":["$0$","$-\\tfrac{1}{12}$","$\\tfrac{1}{6}$","$-\\tfrac{1}{4}$"],"answer_mode":"server","feedback_revision":"550e893e99c413b4f14ed012","time_limit":35},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_017","difficulty":"challenge","question_type":"conceptual","question":"Let $X$ have density $f_X(x)=\\tfrac{3}{2}x^{-5/2}$ for $x\\ge1$ and zero otherwise, and let $Y=-X$. How do the moment conditions affect the covariance of this pair?","options":["No finite covariance exists, because the second moment of $X$ diverges","The covariance is zero, because both centred variables have mean zero","The covariance is finite and negative, because both first moments exist","The covariance is positive and infinite, because squared deviations are nonnegative"],"answer_mode":"server","feedback_revision":"c2c7f09dc5a188e1b81375d3","time_limit":40},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_018","difficulty":"challenge","question_type":"conceptual","question":"Suppose $\\operatorname{Var}X=4$, $\\operatorname{Var}Y=9$ and $\\operatorname{Cov}(X,Y)=-6$. Which relationship must hold almost surely for some real constant $c$?","options":["$X$ and $Y$ are independent","$Y=c+\\tfrac{3}{2}X$","$Y=c-X$","$Y=c-\\tfrac{3}{2}X$"],"answer_mode":"server","feedback_revision":"34e78f92aa5d290d298ccf36","time_limit":40},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_019","difficulty":"challenge","question_type":"application","question":"Let $X\\sim\\operatorname{Unif}(0,1)$. What is $\\operatorname{Cov}(X,X^2)$?","options":["$0$","$\\tfrac{1}{4}$","$\\tfrac{1}{12}$","$\\tfrac{1}{6}$"],"answer_mode":"server","feedback_revision":"79035361209a3755f97fa5a0","time_limit":40},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_020","difficulty":"challenge","question_type":"application","question":"Two square-integrable measurements $X$ and $Y$ have variances $1$ and $4$, respectively, and covariance $\\tfrac{1}{2}$. For $0\\le w\\le1$, define their weighted average $A_w=wX+(1-w)Y$. What is the smallest possible value of $\\operatorname{Var}(A_w)$?","options":["$\\tfrac{1}{2}$","$\\tfrac{15}{16}$","$1$","$\\tfrac{3}{2}$"],"answer_mode":"server","feedback_revision":"c1d591b4680fba9e3a243acd","time_limit":40},{"id":"year_1_2b_probability_distributions_covariance_43e4eb87_009_curated20261027_001","difficulty":"standard","question_type":"application","question":"A pair has $p(0,0)=0.3$, $p(0,1)=0.2$, $p(1,0)=0.1$, $p(1,1)=0.4$, with $p(x,y)=\\mathbb{P}(X=x,Y=y)$. What is $\\operatorname{Cov}(X,Y)$?","options":["$0.1$","$0.4$","$0.3$","$-0.1$"],"answer_mode":"server","feedback_revision":"44298481ec77a8d10c099a88","time_limit":30}]}}