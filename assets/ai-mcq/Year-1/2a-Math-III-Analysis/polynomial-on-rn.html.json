th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/2a-Math-III-Analysis/polynomial-on-rn.html","concept":{"concept_id":"Year-1/2a-Math-III-Analysis/polynomial-on-rn.html","questions":[{"id":"year_1_2a_math_iii_analysis_polynomial_on_rn_4c2b2383_001","difficulty":"basic","question_type":"conceptual","question":"What is a polynomial on $\\mathbb{R}^n$?","options":["A real-valued function that is a finite sum of monomials on $\\mathbb{R}^n$","Any function from $\\mathbb{R}^n$ to $\\mathbb{R}$ that has all of its partial derivatives","A sequence of real numbers indexed by $n$","A function whose graph is always a straight line"],"answer_mode":"server","feedback_revision":"afcd20fe9aa22c4a7e54e380","time_limit":30},{"id":"year_1_2a_math_iii_analysis_polynomial_on_rn_4c2b2383_002","difficulty":"basic","question_type":"conceptual","question":"How is the degree of a polynomial on $\\mathbb{R}^n$ determined?","options":["By the smallest total degree among its monomials with nonzero coefficient","By the highest total degree among its monomials with nonzero coefficient","By the highest exponent of a single variable among its monomials","By the sum of the total degrees of all its nonzero monomials"],"answer_mode":"server","feedback_revision":"ab860bd4fdbd5211a935d6f0","time_limit":30},{"id":"year_1_2a_math_iii_analysis_polynomial_on_rn_4c2b2383_004","difficulty":"basic","question_type":"application","question":"Which expression is a polynomial on $\\mathbb{R}^2$?","options":["$\\dfrac{1}{x}+y$","$\\sin(x)+y$","$\\sqrt{x}+y^2$","$x^3+xy+y^2$"],"answer_mode":"server","feedback_revision":"88c5fe1cbfe99d68e8353a5d","time_limit":20},{"id":"year_1_2a_math_iii_analysis_polynomial_on_rn_4c2b2383_007","difficulty":"standard","question_type":"application","question":"Let $p(x,y) = x^2+y$ and $q(x,y) = xy^3$. What is the degree of $p q$?","options":["$2$","$4$","$5$","$6$"],"answer_mode":"server","feedback_revision":"2606d6fe1f8c77b57acb067f","time_limit":30},{"id":"year_1_2a_math_iii_analysis_polynomial_on_rn_7fc3b12c_016","difficulty":"basic","question_type":"application","question":"What is the degree of $f(x,y)=x^3y+xy^2+1$?","options":["$2$","$3$","$4$","$5$"],"answer_mode":"server","feedback_revision":"ff69998fa170086d72543066","time_limit":20},{"id":"year_1_2a_math_iii_analysis_polynomial_on_rn_4c2b2383_011_curated20261027_001","difficulty":"standard","question_type":"application","question":"Let $p(x,y)=x^3+y$ and $q(x,y)=-x^3+xy$. What is the degree of $p+q$?","options":["$2$","$3$","$5$","$1$"],"answer_mode":"server","feedback_revision":"b1a1a39dcc351e63e7b891bb","time_limit":30},{"id":"year_1_2a_math_iii_analysis_polynomial_on_rn_4c2b2383_012_curated20261027_002","difficulty":"standard","question_type":"application","question":"Let $f(x,y)=x^3+xy+y^2$. Which of the following partial derivatives is identically zero?","options":["$\\dfrac{\\partial^3 f}{\\partial y^3}$","$\\dfrac{\\partial^3 f}{\\partial x^3}$","$\\dfrac{\\partial^2 f}{\\partial y^2}$","$\\dfrac{\\partial^2 f}{\\partial x\\,\\partial y}$"],"answer_mode":"server","feedback_revision":"6b980d69cdde21043fbb8df3","time_limit":30},{"id":"year_1_2a_math_iii_analysis_polynomial_on_rn_4c2b2383_topup20261028_001","difficulty":"standard","question_type":"conceptual","question":"Let $P$ and $Q$ be polynomials on $\\mathbb{R}^2$ with $\\deg P=3$ and $\\deg Q=5$. What is the degree of $P+Q$?","options":["It is exactly $5$, since $P$ has no monomial of total degree $5$ to cancel.","It is at most $5$ and may be lower, since top-degree terms can cancel.","It is exactly $8$, since the degrees of the two summands add up.","It depends on signs: a negative coefficient in $Q$ can make it drop below $5$."],"answer_mode":"server","feedback_revision":"f47ef20129b4e37c57a159b0","time_limit":45},{"id":"year_1_2a_math_iii_analysis_polynomial_on_rn_4c2b2383_topup20261028_002","difficulty":"standard","question_type":"application","question":"Which of the following formulas defines a polynomial on $\\mathbb{R}^2$?","options":["$f(x,y)=\\sqrt{x^2}+y$","$f(x,y)=|x|^2+y$","$f(x,y)=\\dfrac{x^2-y^2}{x-y}$","$f(x,y)=|x|^3+y$"],"answer_mode":"server","feedback_revision":"7bf59590807f3c0c225aef88","time_limit":30}]}}