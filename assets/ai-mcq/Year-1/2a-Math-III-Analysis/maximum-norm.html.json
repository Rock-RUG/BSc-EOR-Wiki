ack_revision":"ab867a71c41b626386804a76","time_limit":40},{"id":"year_1_2a_math_iii_analysis_maximum_norm_42fb0bd9_013","difficulty":"basic","question_type":"conceptual","question":"How is the maximum norm of $\\boldsymbol{x}=(x_1,\\ldots,x_n)$ defined?","options":["$\\|\\boldsymbol{x}\\|_\\infty=\\sum_{i=1}^n |x_i|$","$\\|\\boldsymbol{x}\\|_\\infty=\\sqrt{x_1^2+\\cdots+x_n^2}$","$\\|\\boldsymbol{x}\\|_\\infty=\\min_{1\\le i\\le n}|x_i|$","$\\|\\boldsymbol{x}\\|_\\infty=\\max_{1\\le i\\le n}|x_i|$"],"answer_mode":"server","feedback_revision":"9a2b070d861493d29ed15f2e","time_limit":20},{"id":"year_1_2a_math_iii_analysis_maximum_norm_42fb0bd9_016","difficulty":"basic","question_type":"application","question":"What is $\\|(3,-5,2)\\|_\\infty$?","options":["$10$","$3$","$\\sqrt{38}$","$5$"],"answer_mode":"server","feedback_revision":"27acfd1af8abdccc96eac419","time_limit":20},{"id":"year_1_2a_math_iii_analysis_maximum_norm_42fb0bd9_017","difficulty":"basic","question_type":"application","question":"What is $d_\\infty((1,4),(3,-1))$?","options":["$5$","$2$","$7$","$\\sqrt{29}$"],"answer_mode":"server","feedback_revision":"8c0628c9409b3219b4250078","time_limit":20},{"id":"year_1_2a_math_iii_analysis_maximum_norm_42fb0bd9_018","difficulty":"basic","question_type":"application","question":"Which point lies in the closed unit ball for $\\|\\cdot\\|_\\infty$ in $\\mathbb{R}^2$?","options":["$(1,-\\frac{1}{2})$","$(2,0)$","$(0,-3)$","$(\\frac{1}{2},2)$"],"answer_mode":"server","feedback_revision":"44a387c47decd240ab586e4a","time_limit":20},{"id":"year_1_2a_math_iii_analysis_maximum_norm_42fb0bd9_019","difficulty":"standard","question_type":"conceptual","question":"How is the maximum norm related to the family of $p$-norms?","options":["It is the case $p=1$.","It is the case $p=2$ only.","It is completely unrelated to the $p$-norms.","It is the limiting case as $p\\to+\\infty$."],"answer_mode":"server","feedback_revision":"2b1a4a1b681e4e5d308e0b7d","time_limit":30},{"id":"year_1_2a_math_iii_analysis_maximum_norm_23ce4966_001_curated20261027_001","difficulty":"challenge","question_type":"conceptual","question":"Let $(\\boldsymbol{x}_k)$ be a sequence in $\\mathbb{R}^n$ and $\\boldsymbol{x}\\in\\mathbb{R}^n$. What does $d_\\infty(\\boldsymbol{x}_k,\\boldsymbol{x})\\to0$ as $k\\to\\infty$ mean for the coordinates?","options":["Every coordinate sequence $(x_{k,i})_k$ converges to $x_i$, for each $i=1,\\dots,n$.","At least one coordinate sequence $(x_{k,i})_k$ converges to the corresponding $x_i$.","The sum of the coordinates of $\\boldsymbol{x}_k$ converges to the sum of the coordinates of $\\boldsymbol{x}$.","$\\|\\boldsymbol{x}_k\\|_\\infty\\to\\|\\boldsymbol{x}\\|_\\infty$, the largest absolute coordinates converge."],"answer_mode":"server","feedback_revision":"3ac05a1f850bbb494b9db28a","time_limit":40},{"id":"year_1_2a_math_iii_analysis_maximum_norm_23ce4966_010_curated20261027_002","difficulty":"standard","question_type":"conceptual","question":"A point $\\boldsymbol{x}\\in\\mathbb{R}^n$ satisfies $\\|\\boldsymbol{x}\\|_2\\le1$. Which conclusion about its maximum norm always follows?","options":["$\\|\\boldsymbol{x}\\|_\\infty\\le1$.","$\\|\\boldsymbol{x}\\|_\\infty\\ge1$.","$\\|\\boldsymbol{x}\\|_\\infty\\le1/\\sqrt{n}$.","$\\|\\boldsymbol{x}\\|_\\infty=\\|\\boldsymbol{x}\\|_2$."],"answer_mode":"server","feedback_revision":"8d3dc52297573a115dc4ebf1","time_limit":30}]}}