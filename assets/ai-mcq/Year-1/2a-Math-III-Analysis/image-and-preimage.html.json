th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/2a-Math-III-Analysis/image-and-preimage.html","concept":{"concept_id":"Year-1/2a-Math-III-Analysis/image-and-preimage.html","questions":[{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_001","difficulty":"basic","question_type":"conceptual","question":"What is the image $\\boldsymbol{f}(\\boldsymbol{C})$ of a set $\\boldsymbol{C}\\subseteq\\boldsymbol{X}$?","options":["The set of outputs $\\boldsymbol{y}$ obtained as $\\boldsymbol{y} = \\boldsymbol{f}(\\boldsymbol{x})$ for some $\\boldsymbol{x}\\in\\boldsymbol{C}$.","The set of all inputs in $\\boldsymbol{X}$ that are not in $\\boldsymbol{C}$, so that $\\boldsymbol{f}$ avoids $\\boldsymbol{C}$.","The whole codomain $\\boldsymbol{Y}$ regardless of $\\boldsymbol{C}$.","The inverse function of $\\boldsymbol{f}$."],"answer_mode":"server","feedback_revision":"913ebca0e3eb84ecb9350c12","time_limit":35},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_002","difficulty":"basic","question_type":"conceptual","question":"What is the preimage $\\boldsymbol{f}^{-1}(\\boldsymbol{V})$ of a set $\\boldsymbol{V}\\subseteq\\boldsymbol{Y}$?","options":["The set of outputs outside $\\boldsymbol{V}$.","The set of inputs $\\boldsymbol{x}\\in\\boldsymbol{X}$ such that $\\boldsymbol{f}(\\boldsymbol{x})\\in\\boldsymbol{V}$.","Only the points of $\\boldsymbol{V}$ that have unique inputs.","A function that must undo $\\boldsymbol{f}$."],"answer_mode":"server","feedback_revision":"022a3a96ef7420d38c023d68","time_limit":30},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_004","difficulty":"basic","question_type":"application","question":"For $f(x,y) = x+y$, what is the preimage of $\\{0\\}$?","options":["The square $[0,1]\\times[0,1]$.","The line $y = -x$.","The interval $[0,2]$.","The vertical strip $[2,3]\\times\\mathbb{R}$."],"answer_mode":"server","feedback_revision":"b1fa9256ab177037079e83d7","time_limit":25},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_005","difficulty":"standard","question_type":"application","question":"Let $f(x,y)=\\dfrac{1}{x^2+y^4+1}$ on $\\mathbb{R}^2$. For which $V\\subseteq\\mathbb{R}$ is $f\\bigl(f^{-1}(V)\\bigr)\\neq V$?","options":["$V=(0,1]$","$V=(0,1)$","$V=\\{1\\}$","$V=[0,1)$"],"answer_mode":"server","feedback_revision":"86294f230c1fc04201301c3d","time_limit":30},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_006","difficulty":"basic","question_type":"conceptual","question":"Let $\\boldsymbol{f}\\colon\\mathbb{R}^n\\to\\mathbb{R}^n$ and let $\\boldsymbol{A}\\subseteq\\mathbb{R}^n$ be non-empty. Which situation can occur?","options":["$\\boldsymbol{f}^{-1}(\\boldsymbol{A})\\not\\subseteq\\mathbb{R}^n$","$\\boldsymbol{f}^{-1}(\\boldsymbol{A})=\\varnothing$","$\\boldsymbol{f}(\\boldsymbol{A})=\\varnothing$","$\\boldsymbol{f}(\\boldsymbol{A})\\not\\subseteq\\mathbb{R}^n$"],"answer_mode":"server","feedback_revision":"32209915a235b5ad00dbc332","time_limit":20},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_007","difficulty":"standard","question_type":"application","question":"For $f\\colon\\mathbb{R}^2\\to\\mathbb{R}$ with $f(x,y) = x$, what is the image of the disc $\\{(x,y)\\in\\mathbb{R}^2\\colon x^2+y^2 \\leq 1\\}$?","options":["$[-1,1]$","$[0,2]$","$[2,3]$","$\\mathbb{R}^2$"],"answer_mode":"server","feedback_revision":"e710c629e5e0d9f62fbb4d89","time_limit":30},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_010","difficulty":"challenge","question_type":"conceptual","question":"Why does the notation $\\boldsymbol{f}^{-1}(\\boldsymbol{V})$ not require $\\boldsymbol{f}$ to have an inverse function?","options":["It is defined only for bijective $\\boldsymbol{f}$, so an inverse always exists when it is used.","It denotes the outputs $\\boldsymbol{f}(\\boldsymbol{x})$ for $\\boldsymbol{x}\\in\\boldsymbol{V}$, so no inverse is involved.","It denotes the set of inputs mapped into $\\boldsymbol{V}$, not a value of an inverse function.","It requires $\\boldsymbol{f}$ only to be injective, so each point of $\\boldsymbol{V}$ has exactly one preimage."],"answer_mode":"server","feedback_revision":"f23eb87de5bb00a7ec695e87","time_limit":40},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_016","difficulty":"basic","question_type":"application","question":"Let $f\\colon\\mathbb{R}\\to\\mathbb{R}$ be $f(x)=x^2$. What is $f(\\{-1,0,1\\})$?","options":["$\\{-1,0,1\\}$","$\\{0,1\\}$","$\\{1\\}$","$[0,1]$"],"answer_mode":"server","feedback_revision":"5eb637f6495f5f2ea570d745","time_limit":20},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_017","difficulty":"basic","question_type":"application","question":"Let $f\\colon\\mathbb{R}\\to\\mathbb{R}$ be $f(x)=x^2$. What is $f^{-1}(\\{4\\})$?","options":["$\\{4\\}$","$\\{2\\}$","$\\{-2,2\\}$","$\\varnothing$"],"answer_mode":"server","feedback_revision":"c853a3ad8c7284d34cf096a9","time_limit":20},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_018","difficulty":"basic","question_type":"application","question":"Let $f\\colon\\mathbb{R}\\to\\mathbb{R}$ be $f(x)=x+1$. What is $f^{-1}([1,3])$?","options":["$[1,3]$","$[2,4]$","$[0,2]$","$[-1,1]$"],"answer_mode":"server","feedback_revision":"08ed6a4a847dc5423981e6ce","time_limit":20},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_020","difficulty":"standard","question_type":"application","question":"Let $f\\colon\\mathbb{R}^2\\to\\mathbb{R}$ be $f(x,y)=x-y$. Which point lies in $f^{-1}(\\{0\\})$?","options":["$(2,1)$","$(0,1)$","$(2,2)$","$(3,0)$"],"answer_mode":"server","feedback_revision":"2da36c0a95c47bfb8bc76c4f","time_limit":30},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_009_curated20261027_001","difficulty":"challenge","question_type":"application","question":"Let $f\\colon\\mathbb{R}\\to\\mathbb{R}$, $f(x)=x^2$, and $C=[1,2]$. What is $f^{-1}(f(C))$?","options":["$[-2,-1]\\cup[1,2]$","$[1,2]$","$[1,4]$","$[-2,2]$"],"answer_mode":"server","feedback_revision":"40cd26e3f9a6d746faaa5d24","time_limit":40},{"id":"year_1_2a_math_iii_analysis_image_and_preimage_f5155341_014_curated20261027_002","difficulty":"challenge","question_type":"conceptual","question":"Let $f\\colon X\\to Y$ be any function, $C_1,C_2\\subseteq X$ and $V_1\\subseteq Y$, $V_2\\subseteq Y$. Which of the following identities can fail?","options":["$f^{-1}(V_1\\cap V_2)=f^{-1}(V_1)\\cap f^{-1}(V_2)$","$f(C_1\\cup C_2)=f(C_1)\\cup f(C_2)$","$f(C_1\\cap C_2)=f(C_1)\\cap f(C_2)$","$f^{-1}(Y\\setminus V_1)=X\\setminus f^{-1}(V_1)$"],"answer_mode":"server","feedback_revision":"b9090ce042840d13e2dda974","time_limit":40}]}}