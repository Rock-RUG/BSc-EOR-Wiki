th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/2a-Math-III-Analysis/radius-and-interval-of-convergence.html","concept":{"concept_id":"Year-1/2a-Math-III-Analysis/radius-and-interval-of-convergence.html","questions":[{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_003","difficulty":"basic","question_type":"application","question":"A power series is centred at $a = 3$ with radius $R = \\frac{1}{2}$. Which $x$ is certainly inside the open convergence interval?","options":["$x = \\frac{5}{2}$","$x = 3$","$x = \\frac{7}{2}$","$x = 4$"],"answer_mode":"server","feedback_revision":"cf072eb475370e27a0d9aac3","time_limit":25},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_004","difficulty":"basic","question_type":"application","question":"If a power series has centre $a = -2$ and radius $R = 0$, where can it converge?","options":["On $(-2,2)$","Only at $x = -2$","For every $x\\in\\mathbb{R}$","Only at $x = 0$"],"answer_mode":"server","feedback_revision":"a1381da8fd12375a7a7ddbb5","time_limit":25},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_007","difficulty":"standard","question_type":"application","question":"For centre $a = 1$ and radius $R = 2$, which open interval is guaranteed by the radius?","options":["$(-1,3)$","$(1,2)$","$[ -1,3 ]$","$( -2,2 )$"],"answer_mode":"server","feedback_revision":"f7afc2332f14e309ea29b666","time_limit":30},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_008","difficulty":"standard","question_type":"application","question":"A power series centred at $a = 0$ converges for $|x| \\lt 4$ and diverges for $|x| \\gt 4$. What is its radius of convergence?","options":["$0$","$4$","$2$","$8$"],"answer_mode":"server","feedback_revision":"90195eec7397dcd502532dd9","time_limit":30},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_013","difficulty":"challenge","question_type":"conceptual","question":"Power series $\\sum a_nx^n$ and $\\sum b_nx^n$ have radii $R_1$ and $R_2$. Which value is impossible for the radius $R$ of $\\sum(a_n+b_n)x^n$?","options":["$R<\\min\\{R_1,R_2\\}$","$R=R_1$ when $R_1<R_2$","$R=+\\infty$ when $R_1=R_2=1$","$R=R_1=R_2$"],"answer_mode":"server","feedback_revision":"1d591cc9cab3cb004f38b390","time_limit":40},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_014","difficulty":"basic","question_type":"conceptual","question":"For a power series $\\sum c_n(x-a)^n$ with radius of convergence $R$, which set of inputs forms its interval of convergence?","options":["All $x$ at which the series converges","The open interval $(a-R,a+R)$, always","The closed interval $[a-R,a+R]$, always","All $x$ at which it converges absolutely"],"answer_mode":"server","feedback_revision":"5250df981f7c714d58b37a31","time_limit":30},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_015","difficulty":"basic","question_type":"conceptual","question":"What must be checked separately when $0 \\lt R \\lt +\\infty$?","options":["Convergence at every point inside $|x-a| \\lt R$.","Divergence at every point outside $|x-a| \\gt R$.","Convergence at $x=a-R$ and $x=a+R$.","Whether $a$ is a real number."],"answer_mode":"server","feedback_revision":"dfb42f5848c4238627f8e599","time_limit":25},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_016","difficulty":"basic","question_type":"application","question":"If a power series has centre $a=4$ and radius $R=2$, where is convergence guaranteed by the radius?","options":["For $|x-4| \\lt 2$","For $|x-4| \\gt 2$","Only at $x=2$ and $x=6$","For all real $x$"],"answer_mode":"server","feedback_revision":"343453c36ded52400a764288","time_limit":25},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_019","difficulty":"standard","question_type":"conceptual","question":"Why can two power series with the same radius have different intervals of convergence?","options":["They must have different centres.","They may behave differently at the endpoints.","The radius never determines interior convergence.","The interval cannot include the centre."],"answer_mode":"server","feedback_revision":"457f0485666c2b3686128b1e","time_limit":30},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_020","difficulty":"standard","question_type":"application","question":"A power series centered at $0$ has $R=1$ and converges at $x=1$ but diverges at $x=-1$. What is its interval of convergence?","options":["$[-1,1]$","$(-1,1)$","$(-1,1]$","$[-1,1)$"],"answer_mode":"server","feedback_revision":"148b72a46c32e3dd6d9d1556","time_limit":30},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_006_curated20261027_001","difficulty":"basic","question_type":"conceptual","question":"A power series $\\sum c_n(x-a)^n$ has radius of convergence $R$ with $0<R<+\\infty$. According to the definition of $R$, what is known about the series at a point $x$ with $|x-a|>R$?","options":["It diverges.","It may converge or diverge; such points must be tested one by one.","It converges, but only conditionally.","Nothing: the definition only describes the points with $|x-a|<R$."],"answer_mode":"server","feedback_revision":"7c87875898c52f0d403a6db6","time_limit":35},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_010_curated20261027_002","difficulty":"basic","question_type":"conceptual","question":"A power series $\\sum c_n(x-a)^n$ has radius of convergence $R=+\\infty$. What does this say about its interval of convergence?","options":["The series converges at every real $x$.","The series converges only at the centre $a$.","The series converges for $|x-a|<\\infty$, but two endpoints still need separate tests.","The series may still diverge at some real $x$ far enough from $a$."],"answer_mode":"server","feedback_revision":"ded9465b1add60105b9ff182","time_limit":35},{"id":"year_1_2a_math_iii_analysis_radius_and_interval_of_convergence_1dcbdd5a_012_curated20261027_003","difficulty":"standard","question_type":"application","question":"Each of the following power series has centre $0$ and radius of convergence $R=1$. Which one has interval of convergence $[-1,1]$?","options":["$\\sum_{n\\ge1} x^n/n^2$","$\\sum_{n\\ge1} x^n/n$","$\\sum_{n\\ge1} (-x)^n/n$","$\\sum_{n\\ge0} x^n$"],"answer_mode":"server","feedback_revision":"2f876e05dad35e9477a393e5","time_limit":30}]}}