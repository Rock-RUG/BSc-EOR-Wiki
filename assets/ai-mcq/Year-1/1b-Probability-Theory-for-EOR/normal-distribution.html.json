83b364b0c9e"},{"id":"pt_batch8_normal_distribution_003","difficulty":"standard","question_type":"conceptual","question":"For $X\\sim N(\\mu,\\sigma^{2})$, about what fraction of the probability lies within one standard deviation of the mean?","options":["about $50\\%$","about $99.7\\%$","about $68\\%$","about $95\\%$"],"answer_mode":"server","feedback_revision":"ae14264a8ab3d121d1af492b"},{"id":"pt_batch8_normal_distribution_004","difficulty":"basic","question_type":"conceptual","question":"Which two quantities determine a normal distribution?","options":["Its median and mode only","Its sample size and support count","Its first and last observed values","Its mean and variance"],"answer_mode":"server","feedback_revision":"a048374cf1672536af99028c"},{"id":"pt_batch8_normal_distribution_005","difficulty":"basic","question_type":"conceptual","question":"What type of random variable is described by a normal distribution?","options":["A Bernoulli random variable","A finite counting variable","A deterministic variable only","A continuous random variable"],"answer_mode":"server","feedback_revision":"7aabc998a5e4f19f8946ccbe"},{"id":"pt_batch8_normal_distribution_006","difficulty":"basic","question_type":"application","question":"Which situation is often approximated by a normal distribution?","options":["The number of aces in a hand without replacement","The trial number of the first success","Measurement error around a target","A single yes/no outcome"],"answer_mode":"server","feedback_revision":"1d7ab5138486ad9bcb0d8ff2"},{"id":"pt_batch8_normal_distribution_007","difficulty":"basic","question_type":"application","question":"If $X\\sim N(5,4)$, what is the mean of $X$?","options":["$4$","$2$","$9$","$5$"],"answer_mode":"server","feedback_revision":"633ed827d3df8bd0c84bef46"},{"id":"pt_batch8_normal_distribution_008","difficulty":"basic","question_type":"application","question":"If $X\\sim N(5,4)$, what is the variance of $X$?","options":["$5$","$4$","$2$","$20$"],"answer_mode":"server","feedback_revision":"76bf7b122993cb759d854d38"},{"id":"pt_batch8_normal_distribution_009","difficulty":"basic","question_type":"application","question":"Which model is more appropriate for the average of many small independent effects?","options":["A geometric distribution","A hypergeometric distribution","A normal distribution","A degenerate distribution at zero"],"answer_mode":"server","feedback_revision":"c134c49383c493c316f94023"},{"id":"pt_batch8_normal_distribution_010","difficulty":"basic","question_type":"application","question":"If manufacturing deviations from a target are modeled symmetrically around $0$, which normal mean is natural?","options":["$1$","$0$","$-1$","$\\sigma^2$"],"answer_mode":"server","feedback_revision":"8fab003ff9b99e966b3bb2bb"},{"id":"pt_batch8_normal_distribution_011","difficulty":"standard","question_type":"conceptual","question":"What happens when a normal random variable is standardized?","options":["It becomes a Poisson random variable","It loses its density","It becomes a standard normal random variable","It becomes degenerate at its mean"],"answer_mode":"server","feedback_revision":"f76e657acee43886d47c0807"},{"id":"pt_batch8_normal_distribution_012","difficulty":"standard","question_type":"conceptual","question":"What is true about sums of independent normal random variables?","options":["They are normally distributed","They are always uniform","They always have variance zero","They are not random variables"],"answer_mode":"server","feedback_revision":"5dce8bfe98ab4124f4b3682b"},{"id":"pt_batch8_normal_distribution_013","difficulty":"challenge","question_type":"conceptual","question":"If $X\\sim N(\\mu,\\sigma^{2})$ and $a\\neq0$, then $aX+b$ is distributed as:","options":["$N(a\\mu+b,\\ a\\sigma^{2})$","$N(\\mu+b,\\ \\sigma^{2})$","not normal in general","$N(a\\mu+b,\\ a^{2}\\sigma^{2})$"],"answer_mode":"server","feedback_revision":"9514c6a1008da5ee41fd117a"},{"id":"pt_batch8_normal_distribution_014","difficulty":"standard","question_type":"application","question":"If $X\\sim N(10,9)$, what is the standard deviation of $X$?","options":["$3$","$9$","$10$","$19$"],"answer_mode":"server","feedback_revision":"b462ba023400f10f577d1141"},{"id":"pt_batch8_normal_distribution_015","difficulty":"standard","question_type":"application","question":"If $X\\sim N(1,4)$ and $Y\\sim N(3,5)$ are independent, what is the distribution family of $X+Y$?","options":["Uniform","Geometric","Normal","Rayleigh"],"answer_mode":"server","feedback_revision":"5a91213a59421c3b8dee3cec"},{"id":"pt_batch8_normal_distribution_016","difficulty":"standard","question_type":"application","question":"For $X\\sim N(2,16)$, which standardized variable should be standard normal?","options":["$(X-16)/2$","$4(X-2)$","$X+2$","$(X-2)/4$"],"answer_mode":"server","feedback_revision":"dec12600971e8f6784dbc3a4"},{"id":"pt_batch8_normal_distribution_017","difficulty":"challenge","question_type":"conceptual","question":"Why is $\\sigma=0$ excluded from the normal distribution definition?","options":["The mean would no longer be real","The support would become finite","The exponential function would disappear, no matter which values are selected.","The density formula requires a positive spread parameter"],"answer_mode":"server","feedback_revision":"00095521a4bbaaec6455578f"},{"id":"pt_batch8_normal_distribution_018","difficulty":"challenge","question_type":"conceptual","question":"If $X\\sim N(\\mu_1,\\sigma_1^{2})$ and $Y\\sim N(\\mu_2,\\sigma_2^{2})$ are independent, then $X-Y$ is:","options":["$N(\\mu_1-\\mu_2,\\ \\sigma_1^{2}+\\sigma_2^{2})$","$N(\\mu_1-\\mu_2,\\ \\sigma_1^{2}-\\sigma_2^{2})$","$N(\\mu_1+\\mu_2,\\ \\sigma_1^{2}+\\sigma_2^{2})$","$N(\\mu_1-\\mu_2,\\ |\\sigma_1^{2}-\\sigma_2^{2}|)$"],"answer_mode":"server","feedback_revision":"c82a24ab6cc3cc0c062434b0"},{"id":"pt_batch8_normal_distribution_019","difficulty":"challenge","question_type":"application","question":"If two independent normal variables have means $2$ and $5$, what is the mean of their sum?","options":["$10$","$7$","$3$","$25$"],"answer_mode":"server","feedback_revision":"4a0bc6ae90d4bed93f7fae66"},{"id":"pt_batch8_normal_distribution_020","difficulty":"challenge","question_type":"application","question":"A model claims $X\\sim N(0,-1)$. What is wrong?","options":["The mean cannot be zero","The variance parameter cannot be negative","Normal variables cannot be continuous","The distribution must be uniform"],"answer_mode":"server","feedback_revision":"6c46a8b150b3f56642d21f89"}]}}