th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1b-Probability-Theory-for-EOR/random-interval.html","concept":{"concept_id":"Year-1/1b-Probability-Theory-for-EOR/random-interval.html","questions":[{"id":"pt_batch9_random_interval_002","difficulty":"basic","question_type":"conceptual","question":"What condition is assumed for endpoints $A$ and $B$ in $[A,B]$?","options":["$A\\le B$","$A>B$ always","$A=B=0$ only","$A$ and $B$ must be deterministic"],"answer_mode":"server","feedback_revision":"96ce3ae106ea6937ad1d262a","time_limit":25},{"id":"pt_batch9_random_interval_016","difficulty":"standard","question_type":"application","question":"Which event corresponds to fixed value $0$ being inside $[A,B]$?","options":["$A+B=0$","$A\\le0\\le B$","$A=B=0$ only","$0\\le A\\le B$"],"answer_mode":"server","feedback_revision":"1738195692292348b2afafcb","time_limit":30},{"id":"pt_batch9_random_interval_011_curated20261027_001","difficulty":"standard","question_type":"conceptual","question":"Random variables $A\\le B$ and a fixed number $\\theta$ are given; nothing is assumed about the dependence of $A$ and $B$. Which formula for $\\mathbb{P}(A\\le\\theta\\le B)$ is valid for every such $A,B$?","options":["$1-\\mathbb{P}(A>\\theta)-\\mathbb{P}(B<\\theta)$","$\\mathbb{P}(A\\le\\theta)\\,\\mathbb{P}(B\\ge\\theta)$","$\\mathbb{P}(A\\le\\theta)+\\mathbb{P}(B\\ge\\theta)$","$1-\\mathbb{P}(A>\\theta)\\,\\mathbb{P}(B<\\theta)$"],"answer_mode":"server","feedback_revision":"739ca1cd55455faeb1d13b7b","time_limit":30},{"id":"pt_batch9_random_interval_015_curated20261027_002","difficulty":"standard","question_type":"conceptual","question":"A random interval $[A,B]$ has $\\mathbb{P}(A\\le\\theta\\le B)=0.95$ for a fixed number $\\theta$. One run gives the interval $[2,5]$. Which statement is correct?","options":["Either $\\theta\\in[2,5]$ or not; $0.95$ refers to the procedure","$\\theta$ lies in $[2,5]$ with probability $0.95$","$[2,5]$ must contain $\\theta$, since $0.95>0.5$","The coverage is now $0$ or $1$, so $0.95$ was wrong"],"answer_mode":"server","feedback_revision":"4ca8c14e3af8bc2043b2f90b","time_limit":40},{"id":"pt_batch9_random_interval_018_curated20261027_003","difficulty":"standard","question_type":"application","question":"An interval procedure gives $[-1,1]$ with probability $0.7$ and $[1,2]$ with probability $0.3$. The target is $\\theta=0$. Six independent runs gave five intervals that cover $0$. What is the coverage probability?","options":["$0.7$","$5/6$","$0.3$","$1$"],"answer_mode":"server","feedback_revision":"416dcb4f68a39cdfb77cc4f5","time_limit":30},{"id":"year_1_1b_probability_theory_for_eor_random_interval_76d49ee2_topup20261028_001","difficulty":"standard","question_type":"application","question":"Let $X_1,X_2,X_3$ be i.i.d. $\\operatorname{Unif}(0,1)$, with minimum $X_{(1)}$ and maximum $X_{(3)}$. What is the probability that the random interval $[X_{(1)},X_{(3)}]$ contains the fixed number $\\theta=\\tfrac{1}{2}$?","options":["$\\tfrac{7}{8}$","$\\tfrac{3}{4}$","$\\tfrac{49}{64}$","$\\tfrac{63}{64}$"],"answer_mode":"server","feedback_revision":"da5bad47d7e1bde3c0f99523","time_limit":30}]}}