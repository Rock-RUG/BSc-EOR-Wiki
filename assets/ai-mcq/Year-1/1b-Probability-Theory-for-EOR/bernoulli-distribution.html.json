th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1b-Probability-Theory-for-EOR/bernoulli-distribution.html","concept":{"concept_id":"Year-1/1b-Probability-Theory-for-EOR/bernoulli-distribution.html","questions":[{"id":"pt_batch6_bernoulli_distribution_002","difficulty":"basic","question_type":"conceptual","question":"If $X\\sim\\operatorname{Bern}(p)$, what is $P(X=1)$?","options":["$1-p$","$p$","$p(1-p)$","$1/p$"],"answer_mode":"server","feedback_revision":"17a84593c8cb74115e822ca7","time_limit":20},{"id":"pt_batch6_bernoulli_distribution_011","difficulty":"standard","question_type":"conceptual","question":"What is $E[X]$ for $X\\sim\\operatorname{Bern}(p)$?","options":["$p$","$1-p$","$p(1-p)$","$1/p$"],"answer_mode":"server","feedback_revision":"b6e6cc0211015a717e79f9f8","time_limit":30},{"id":"pt_batch6_bernoulli_distribution_012","difficulty":"standard","question_type":"conceptual","question":"For every $p\\in(0,1)$, which formula gives $\\operatorname{Var}(X)$ when $X\\sim\\operatorname{Bern}(p)$?","options":["$p$","$1-p$","$p^2$","$p(1-p)$"],"answer_mode":"server","feedback_revision":"3ac767cc76cad8ee3f085687","time_limit":30},{"id":"pt_batch6_bernoulli_distribution_013","difficulty":"standard","question_type":"conceptual","question":"Why is an indicator random variable Bernoulli?","options":["It takes value $1$ when an event occurs and $0$ otherwise","It counts the successes in $n$ independent trials of the event","It takes the value $P(A)$ on every outcome of the experiment","It counts the trials needed until the event first occurs"],"answer_mode":"server","feedback_revision":"d971f0a6760c4baf8157e482","time_limit":30},{"id":"pt_batch6_bernoulli_distribution_001_curated20261027_001","difficulty":"standard","question_type":"conceptual","question":"For $X\\sim\\operatorname{Bern}(p)$, which formula gives $\\mathbb{E}[X^2]$ for every $p\\in[0,1]$?","options":["$p$","$p^{2}$","$p(1-p)$","$1$"],"answer_mode":"server","feedback_revision":"72e742989ddeeae746fc2e52","time_limit":30},{"id":"pt_batch6_bernoulli_distribution_003_curated20261027_002","difficulty":"basic","question_type":"application","question":"$X\\sim\\operatorname{Bern}(0.3)$ and $Y=1-X$. What is the distribution of $Y$?","options":["$\\operatorname{Bern}(0.7)$","$\\operatorname{Bern}(0.3)$","$\\operatorname{Bern}(0.21)$","$Y$ is not Bernoulli, since it is $1$ on a failure"],"answer_mode":"server","feedback_revision":"2ad8e98a6600d2d24f812b4b","time_limit":25},{"id":"pt_batch6_bernoulli_distribution_004_curated20261027_003","difficulty":"standard","question_type":"application","question":"For $X\\sim\\operatorname{Bern}(p)$ with $p\\in[0,1]$, which value of $p$ makes $\\operatorname{Var}(X)=p(1-p)$ as large as possible?","options":["$1/4$","$1/2$","$0$","$1$"],"answer_mode":"server","feedback_revision":"4498bcd25a90b620a250c1dc","time_limit":30},{"id":"pt_batch6_bernoulli_distribution_017_curated20261027_004","difficulty":"challenge","question_type":"application","question":"$X_1\\sim\\operatorname{Bern}(0.1)$ and $X_2\\sim\\operatorname{Bern}(0.9)$ are independent. Does $X_1+X_2$ have the $\\operatorname{Bin}(2,0.5)$ distribution?","options":["No: $\\mathbb{P}(X_1+X_2=0)=0.09$, while $\\operatorname{Bin}(2,0.5)$ gives $0.25$","Yes: its mean is $1=2\\cdot0.5$, which fixes the binomial","Yes: any sum of independent Bernoulli variables is binomial","No: a sum of two Bernoulli variables is again Bernoulli"],"answer_mode":"server","feedback_revision":"28cf53607c376b19ee6ff95a","time_limit":40},{"id":"pt_batch6_bernoulli_distribution_019_curated20261027_005","difficulty":"basic","question_type":"conceptual","question":"Which statement about $X\\sim\\operatorname{Bern}(1)$ is correct?","options":["$X=1$ with probability $1$, so $\\operatorname{Var}(X)=0$","$X=1$ with probability $1$, so $\\operatorname{Var}(X)=1$","It is not a valid distribution, since $p$ must lie strictly between $0$ and $1$","The formula $p(1-p)$ fails at $p=1$, so $\\operatorname{Var}(X)$ is undefined"],"answer_mode":"server","feedback_revision":"268f6a638cc24c6420ef3e3c","time_limit":35},{"id":"year_1_1b_probability_theory_for_eor_bernoulli_distribution_7e74bae6_topup20261028_001","difficulty":"standard","question_type":"conceptual","question":"A random variable $X$ takes the value $2$ with probability $0.6$ and the value $1$ with probability $0.4$. Which statement is correct?","options":["$X\\sim\\operatorname{Bern}(0.6)$, since it takes two values, so $\\mathbb{E}X=0.6$","$X-1\\sim\\operatorname{Bern}(0.6)$, so $\\mathbb{E}X=1.6$","$X/2\\sim\\operatorname{Bern}(0.6)$, so $\\mathbb{E}X=1.2$","$2-X\\sim\\operatorname{Bern}(0.6)$, so $\\mathbb{E}X=1.4$"],"answer_mode":"server","feedback_revision":"846b958c274d325ee00484b2","time_limit":35},{"id":"year_1_1b_probability_theory_for_eor_bernoulli_distribution_7e74bae6_topup20261028_002","difficulty":"challenge","question_type":"conceptual","question":"Let $X\\sim\\operatorname{Bern}(0.3)$ and let $Y=X$, the same trial recorded twice. Which statement about the distribution of $X+Y$ is correct?","options":["It is $\\operatorname{Bin}(2,0.3)$, since $X$ and $Y$ are both $\\operatorname{Bern}(0.3)$","It is $\\operatorname{Bern}(0.6)$, since the two success probabilities add","It is $\\operatorname{Bin}(2,0.3)$, since $\\operatorname{Var}(X)+\\operatorname{Var}(Y)=2\\cdot0.3\\cdot0.7$","It is not binomial, since $X+Y\\in\\{0,2\\}$ gives $\\mathbb{P}(X+Y=1)=0$"],"answer_mode":"server","feedback_revision":"835be3396173a93e63e63ba5","time_limit":40}]