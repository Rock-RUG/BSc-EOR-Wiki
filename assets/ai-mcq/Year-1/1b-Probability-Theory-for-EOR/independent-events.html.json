th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1b-Probability-Theory-for-EOR/independent-events.html","concept":{"concept_id":"Year-1/1b-Probability-Theory-for-EOR/independent-events.html","questions":[{"id":"pt_batch4_independent_events_001","difficulty":"basic","question_type":"conceptual","question":"When are two events $A$ and $B$ independent?","options":["When $A\\cap B=\\varnothing$ holds in every case","When $P(A)=P(B)$","When $P(A\\cap B)=P(A)P(B)$","When $A\\cup B=S$"],"answer_mode":"server","feedback_revision":"57d52749fa0ef93a9a24e3af","time_limit":20},{"id":"pt_batch4_independent_events_003","difficulty":"basic","question_type":"conceptual","question":"If $P(B)>0$, which condition is equivalent to independence?","options":["$P(A\\mid B)=P(B)$ always","$P(A\\mid B)=0$","$P(A\\mid B)=P(A)$","$P(A\\cup B)=0$"],"answer_mode":"server","feedback_revision":"a191b27d204a82c345eb3df9","time_limit":20},{"id":"pt_batch4_independent_events_004","difficulty":"basic","question_type":"conceptual","question":"Are disjoint nonzero-probability events independent?","options":["No","Yes, always","Only if they have equal probabilities","Only if their union is empty"],"answer_mode":"server","feedback_revision":"3d7ab168ec41ae81c91b7d9f","time_limit":20},{"id":"pt_batch4_independent_events_005","difficulty":"standard","question_type":"conceptual","question":"If $A$ and $B$ are independent, are $A$ and $B^c$ independent?","options":["Yes","No, never","Only if $P(B)=1/2$","Only if they are disjoint"],"answer_mode":"server","feedback_revision":"5e11ef1115cffe6feb85391a","time_limit":30},{"id":"pt_batch4_independent_events_008","difficulty":"basic","question_type":"application","question":"If $P(A)=0.5$, $P(B)=0.4$, and $A,B$ are independent, what is $P(A\\cap B)$?","options":["$0.9$","$0.1$","$0.5$","$0.2$"],"answer_mode":"server","feedback_revision":"fd2abf3439a9abb6d1898d8a","time_limit":25},{"id":"pt_batch4_independent_events_012","difficulty":"standard","question_type":"application","question":"For independent events $A,B$, what is $P(A\\cup B)$?","options":["$P(A)+P(B)-P(A)P(B)$","$P(A)P(B)$","$P(A)+P(B)$","$1$"],"answer_mode":"server","feedback_revision":"7adda42ce324dd7152bdc44f","time_limit":30},{"id":"pt_batch4_independent_events_014","difficulty":"standard","question_type":"application","question":"If $P(A)=0.2$, $P(B)=0.5$, and $P(A\\cap B)=0.1$, are $A$ and $B$ independent?","options":["No, because the events overlap","No, because $P(A)\\ne P(B)$","Yes, because all events are independent","Yes, because $0.2\\cdot0.5=0.1$"],"answer_mode":"server","feedback_revision":"22521f79e51058028b60978b","time_limit":30},{"id":"pt_batch4_independent_events_016","difficulty":"challenge","question_type":"conceptual","question":"Can an event be independent of itself?","options":["Only if $P(A)=0$ or $P(A)=1$","Always","Never","Only if $P(A)=1/2$"],"answer_mode":"server","feedback_revision":"611ca0b2fc633a5744d7eb16","time_limit":40},{"id":"pt_batch4_independent_events_018","difficulty":"challenge","question_type":"conceptual","question":"If $P(A)=0$, what happens to the factorization condition with any event $B$?","options":["It becomes $P(A\\cap B)=0=P(A)P(B)$","It becomes impossible because $A$ cannot be an event","It forces $P(B)=0$","It implies $A=S$"],"answer_mode":"server","feedback_revision":"fbaeb3f1da005ed584ae3c23","time_limit":40},{"id":"pt_batch4_independent_events_007_curated20261027_001","difficulty":"standard","question_type":"application","question":"Two cards are drawn uniformly at random without replacement from a standard $52$-card deck with $4$ aces. Let $A$ be 'the first card is an ace' and $B$ 'the second card is an ace'. Which statement is correct?","options":["Dependent, since $\\mathbb{P}(B\\mid A)=\\tfrac{3}{51}\\ne\\tfrac{4}{52}=\\mathbb{P}(B)$","Independent, since $\\mathbb{P}(A)=\\mathbb{P}(B)=\\tfrac{4}{52}$","Disjoint, since the same card cannot be drawn twice","Independent, since each draw is uniform over the cards left"],"answer_mode":"server","feedback_revision":"7bb071aa7c5b613d94aed3c7","time_limit":35},{"id":"pt_batch4_independent_events_013_curated20261027_002","difficulty":"basic","question_type":"conceptual","question":"Which conditions define mutual independence of three events $A,B,C$?","options":["All three pairs and the triple intersection factor into products","Only the triple intersection factors into the product of the three","Every pair factors; the triple product then follows automatically","The three events are pairwise disjoint"],"answer_mode":"server","feedback_revision":"a7507d80f0c379256941a1a4","time_limit":25},{"id":"pt_batch4_independent_events_017_curated20261027_003","difficulty":"challenge","question_type":"application","question":"Two fair coins are tossed independently. Let $A$ be 'first toss heads', $B$ 'second toss heads' and $C$ 'both tosses show the same face'. Which statement is correct?","options":["They are pairwise independent, but not mutually independent","They are mutually independent, since every pair is independent","They are not pairwise independent, since $C$ depends on $A$","They are mutually independent, since $\\mathbb{P}(A\\cap B\\cap C)=\\tfrac{1}{8}$"],"answer_mode":"server","feedback_revision":"5f0d37f014e2e1c507adc164","time_limit":40}]}}