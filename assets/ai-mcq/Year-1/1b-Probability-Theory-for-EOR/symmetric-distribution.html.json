th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","concept_id":"Year-1/1b-Probability-Theory-for-EOR/symmetric-distribution.html","concept":{"concept_id":"Year-1/1b-Probability-Theory-for-EOR/symmetric-distribution.html","questions":[{"id":"pt_batch11_symmetric_distribution_001","difficulty":"basic","question_type":"conceptual","question":"What does it mean that the distribution of $X$ is symmetric about $a$?","options":["$X-a$ and $a-X$ have the same distribution","$X+a$ and $X-a$ have the same expectation only","$X$ is always normally distributed","$X$ has variance zero"],"answer_mode":"server","feedback_revision":"0df32dd7d24929d6b54c9c6c","time_limit":30},{"id":"pt_batch11_symmetric_distribution_007","difficulty":"basic","question_type":"application","question":"About what point is a fair die distribution symmetric?","options":["$3.5$","$3$","$4$","$6$"],"answer_mode":"server","feedback_revision":"2588ebd473e4c2a89015c7a5","time_limit":20},{"id":"pt_batch11_symmetric_distribution_004_curated20261027_001","difficulty":"basic","question_type":"conceptual","question":"The distribution of $X$ is symmetric about $a$. Which statement is correct in general?","options":["$a$ is the only median of $X$","$\\mathbb{E}[X]=a$ when the mean exists, but $a$ need not be a median","$a$ is a median, but $\\mathbb{E}[X]$ can differ from $a$ even when it exists","$a$ is a median, and $\\mathbb{E}[X]=a$ whenever the mean exists"],"answer_mode":"server","feedback_revision":"17203e31022477a1b87d17ea","time_limit":40},{"id":"pt_batch11_symmetric_distribution_005_curated20261027_002","difficulty":"basic","question_type":"application","question":"Which of these distributions is symmetric but not normal?","options":["The uniform distribution on $(1,3)$","The normal distribution $\\mathcal{N}(2,4)$","The exponential distribution with rate $1$","The binomial distribution $\\operatorname{Bin}(4,0.3)$"],"answer_mode":"server","feedback_revision":"a50a71b270977aaa60ce255a","time_limit":25},{"id":"pt_batch11_symmetric_distribution_010_curated20261027_003","difficulty":"standard","question_type":"conceptual","question":"Which condition is necessary and sufficient for the distribution of $X$ to be symmetric about $5$?","options":["$\\mathbb{P}(X\\le 5-t)=\\mathbb{P}(X\\ge 5+t)$ for every $t\\ge 0$","$\\mathbb{P}(X\\le 5-t)=\\mathbb{P}(X\\ge 5+t)$ for $t=1$","$\\mathbb{E}[X]=5$ and $5$ is a median of $X$","$\\mathbb{P}(X<5)=\\mathbb{P}(X>5)$"],"answer_mode":"server","feedback_revision":"6000bbc1634c24945ba8158c","time_limit":30},{"id":"pt_batch11_symmetric_distribution_015_curated20261027_004","difficulty":"challenge","question_type":"application","question":"For each integer $n\\ge1$, $X$ takes the values $2^{n}$ and $-2^{n}$, each with probability $2^{-n-1}$. These masses sum to $1$, and the law is symmetric about $0$. What is $\\mathbb{E}[X]$?","options":["$0$, since symmetric terms cancel in pairs","Undefined, since $\\mathbb{E}[X^{+}]$ and $\\mathbb{E}[X^{-}]$ are both infinite","$+\\infty$, since $\\mathbb{E}[X^{+}]$ is infinite","$0$, since the centre of symmetry is the mean"],"answer_mode":"server","feedback_revision":"46422caa1659696525ff6794","time_limit":40}]}}