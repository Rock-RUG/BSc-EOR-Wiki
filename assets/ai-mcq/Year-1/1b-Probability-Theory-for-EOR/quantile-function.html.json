estion":"If a CDF jumps from $0.4$ to $0.7$ at $x=2$, what value should $Q(0.5)$ select under the infimum definition?","options":["$0.5$","$2$","$0.4$","$0.7$"],"answer_mode":"server","feedback_revision":"9b58d9e60c562ce1239ba901"},{"id":"pt_batch9_quantile_function_020","difficulty":"challenge","question_type":"application","question":"A student tries to evaluate $Q(1.2)$. What is wrong?","options":["The CDF must be normal","The answer is always $1.2$","The quantile level must lie between $0$ and $1$","Quantile functions only accept integers"],"answer_mode":"server","feedback_revision":"69a4b35cf8eab9622f713a08"}]}}