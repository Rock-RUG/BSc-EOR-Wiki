{"version":"ai-mcq-bank-v2-la-batch15-high-quality-rewritten-affected-2026-05-22-stem-fixed-inequality-rendering-fixed-student-facing-qc-2026-05-31-pt-foundations-2026-06-11-pt-batch2-foundations-counting-2026-06-11-pt-batch3-counting-probability-rules-2026-06-11-pt-batch4-conditioning-2026-06-11-pt-batch5-random-variables-2026-06-11-pt-batch6-discrete-distributions-2026-06-11-pt-batch7-distribution-foundations-2026-06-11-pt-batch8-continuous-expectation-2026-06-11-pt-batch9-non-week7-expectation-transform-2026-06-11-pt-batch10-non-week7-process-summary-2026-06-11-pt-batch11-non-week7-final-summary-shape-2026-06-11-quality-round1-2026-06-14-quality-round2-2026-06-14-quality-round3-2026-06-14-quality-round4-deep-2026-06-14+quality-round5-difficulty-2026-06-14+quality-round6-expression-2026-06-14+quality-round7-answer-cue-2026-06-14+quality-round8-answer-shape-2026-06-14+quality-round9-answer-position-2026-06-14+quality-round10-template-padding-2026-06-14+quality-round11-generic-stems-2026-06-14+quality-round12-deterministic-cleanup-2026-06-15+quality-pilot-deep-rework-2026-06-15","concept_id":"Year-1/1b-Probability-Theory-for-EOR/complement-of-an-event.html","concept":{"concept_id":"Year-1/1b-Probability-Theory-for-EOR/complement-of-an-event.html","questions":[{"id":"pt_batch2_complement_of_an_event_001","difficulty":"basic","question_type":"conceptual","question":"What is the complement $A^c$ of an event $A$ in a sample space $S$?","options":["The event that the realized outcome is in $S$ but not in $A$","The event containing only outcomes that are in both $A$ and $S$","The event that occurs exactly when $A$ occurs","The probability value assigned to $A$"],"answer_mode":"server","feedback_revision":"5c71da32111152ec891e48a0"},{"id":"pt_batch2_complement_of_an_event_002","difficulty":"basic","question_type":"conceptual","question":"Which notation is standard for the complement of $A$?","options":["$A\\cap A$","$P(A)$","$A^c$","$S-A^c$"],"answer_mode":"server","feedback_revision":"701ed9dde4fdc5f428ede7df"},{"id":"pt_batch2_complement_of_an_event_003","difficulty":"basic","question_type":"conceptual","question":"What is the probability rule for the complement of an event?","options":["$P(A^c)=1-P(A)$","$P(A^c)=P(A)$","$P(A^c)=P(A)+1$","$P(A^c)=P(A\\cap S)$"],"answer_mode":"server","feedback_revision":"4c1b1e5322fc12973d778236"},{"id":"pt_batch2_complement_of_an_event_004","difficulty":"standard","question_type":"conceptual","question":"$(A\\cup B)^c$ equals:","options":["$A^c\\cap B^c$","$A^c\\cup B^c$","$A^c\\cap B$","$(A\\cap B)^c$"],"answer_mode":"server","feedback_revision":"d835791aff579d930d10a78a"},{"id":"pt_batch2_complement_of_an_event_005","difficulty":"standard","question_type":"conceptual","question":"$(A\\cap B)^c$ equals:","options":["$(A\\cup B)^c$","$A^c\\cup B^c$","$A^c\\cap B^c$","$A\\cup B$"],"answer_mode":"server","feedback_revision":"ae996f7c52d1c28936027e99"},{"id":"pt_batch2_complement_of_an_event_006","difficulty":"basic","question_type":"application","question":"If $S=\\{1,2,3,4,5,6\\}$ and $A=\\{2,4,6\\}$, what is $A^c$?","options":["$\\{2,4,6\\}$","$\\{1,3,5\\}$","$\\{1,2,3,4,5,6\\}$","$\\emptyset$"],"answer_mode":"server","feedback_revision":"f02db845820bb7db63b45443"},{"id":"pt_batch2_complement_of_an_event_007","difficulty":"basic","question_type":"application","question":"If $P(A)=0.30$, what is $P(A^c)$?","options":["$0.30$","$1.30$","$0.70$","$0.09$"],"answer_mode":"server","feedback_revision":"1cb3bfd39744bbfa9862294c"},{"id":"pt_batch2_complement_of_an_event_008","difficulty":"basic","question_type":"application","question":"For one die roll, what is the complement of 'roll an even number'?","options":["Roll a number greater than $4$","Roll an even number again","Roll an odd number","Roll both even and odd"],"answer_mode":"server","feedback_revision":"2a0257ee0940c380a086d64f"},{"id":"pt_batch2_complement_of_an_event_009","difficulty":"basic","question_type":"application","question":"What is the complement of 'at least one machine fails'?","options":["No machine fails","All machines fail","Exactly one machine fails","At least two machines fail"],"answer_mode":"server","feedback_revision":"8dca98c636a6dd981d30f310"},{"id":"pt_batch2_complement_of_an_event_010","difficulty":"basic","question_type":"application","question":"If $A$ is impossible, so $P(A)=0$, what is $P(A^c)$?","options":["$0$","$1$","$1/2$","Undefined"],"answer_mode":"server","feedback_revision":"1a9b9b3164b97af651104bf6"},{"id":"pt_batch2_complement_of_an_event_011","difficulty":"standard","question_type":"conceptual","question":"Why is the complement method often useful for events described by 'at least one'?","options":["It turns every event into an independent event, under all circumstances whatsoever.","It removes the need for a sample space","It makes $P(A^c)$ equal to $P(A)$","It can be easier to compute the probability of no occurrences and subtract from $1$"],"answer_mode":"server","feedback_revision":"5a271c431b4ce8b15fc53067"},{"id":"pt_batch2_complement_of_an_event_012","difficulty":"basic","question_type":"conceptual","question":"$(A^c)^c$ equals:","options":["$S$","$\\emptyset$","$A$","$A^c$"],"answer_mode":"server","feedback_revision":"41e6bc17b02337b99dcb502b"},{"id":"pt_batch2_complement_of_an_event_013","difficulty":"standard","question_type":"conceptual","question":"What assumption is needed when forming $A^c$?","options":["The event $A$ has probability exactly $1/2$","The outcomes must be numerical","The event $A$ must be empty","A sample space $S$ has been specified"],"answer_mode":"server","feedback_revision":"8b40ab81e9ff4f9a7ea595b9"},{"id":"pt_batch2_complement_of_an_event_014","difficulty":"standard","question_type":"application","question":"If $P(A^c)=0.18$, what is $P(A)$?","options":["$0.18$","$1.18$","$0.0324$","$0.82$"],"answer_mode":"server","feedback_revision":"646d2e188ec36b34455a229c"},{"id":"pt_batch2_complement_of_an_event_015","difficulty":"standard","question_type":"application","question":"In the birthday problem, which event is the complement of 'at least two people share a birthday'?","options":["Everyone has the same birthday","Exactly one pair shares a birthday","No birthdays are recorded","All birthdays are different"],"answer_mode":"server","feedback_revision":"1171f22f94407c9668e9f765"},{"id":"pt_batch2_complement_of_an_event_016","difficulty":"standard","question_type":"application","question":"Let $S=\\{a,b,c,d\\}$ and $A=\\{a,d\\}$. Which statement is true?","options":["$A^c=\\{a,d\\}$ and $A\\cup A^c=A$","$A^c=\\{b,c,d\\}$ and $A\\cap A^c=\\{d\\}$","$A^c=\\emptyset$ because $A$ is not empty","$A^c=\\{b,c\\}$ and $A\\cap A^c=\\emptyset$"],"answer_mode":"server","feedback_revision":"cf5865ab772723c674739b41"},{"id":"pt_batch2_complement_of_an_event_017","difficulty":"challenge","question_type":"conceptual","question":"Why is $A^c$ not simply 'everything not in $A$' without qualification?","options":["Because $A^c$ must include objects outside the probability model","Because complements are defined only for numerical outcomes","Because $A^c$ always equals the empty set","Because complements are taken relative to the specified sample space $S$"],"answer_mode":"server","feedback_revision":"5b5c827a87eb8d7cb5b1260c"},{"id":"pt_batch2_complement_of_an_event_018","difficulty":"challenge","question_type":"conceptual","question":"If $A^c=\\emptyset$, what must be true about $A$?","options":["$A=\\emptyset$","$P(A)=0$ must hold","$A=S$","$A$ and $S$ are disjoint"],"answer_mode":"server","feedback_revision":"8558c0564b4c349b1377aff6"},{"id":"pt_batch2_complement_of_an_event_019","difficulty":"challenge","question_type":"application","question":"A system has three components. Let $A$ be 'at least one component fails'. If each component independently works with probability $0.9$, what is $P(A)$?","options":["$0.9^3$","$3\\cdot0.9$","$1-3\\cdot0.9$","$1-0.9^3$"],"answer_mode":"server","feedback_revision":"cc4bb2626f07d48ae0fae1e4"},{"id":"pt_batch2_complement_of_an_event_020","difficulty":"challenge","question_type":"application","question":"Let $S=[0,+\\infty)$ and $A=[0,5]$. Which set is $A^c$ relative to $S$?","options":["$(-\\infty,0)\\cup(5,+\\infty)$","$(5,+\\infty)$","$[5,+\\infty)$","$[0,5)$"],"answer_mode":"server","feedback_revision":"788593f99c3de8945db017d3"}]}}