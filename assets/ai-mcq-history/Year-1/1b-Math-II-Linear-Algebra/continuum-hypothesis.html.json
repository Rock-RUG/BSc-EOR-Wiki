th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-1/1b-Math-II-Linear-Algebra/continuum-hypothesis.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/continuum-hypothesis.html","questions":[{"id":"la_batch22_continuum_hypothesis_002","difficulty":"basic","question_type":"conceptual","question":"Which two cardinalities are compared in the continuum hypothesis?","options":["$\\aleph_0$ and $\\mathfrak{c}$","$0$ and $1$","$\\mathbb{N}$ and $\\mathbb{Z}$ as labelled sets rather than cardinalities","$\\aleph_0$ and $\\aleph_1$ by definition only"],"answer_mode":"server","feedback_revision":"3d939148c364494ad84820f9","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_batch22_continuum_hypothesis_004","difficulty":"basic","question_type":"conceptual","question":"What is the informal question behind the continuum hypothesis?","options":["Is there an intermediate infinity between $\\mathbb{N}$ and $\\mathbb{R}$?","Are there real numbers between two distinct integers?","Can every matrix be diagonalised over $\\mathbb{R}$?","Does every finite set have a power set?"],"answer_mode":"server","feedback_revision":"968dba2b5478b6381d271d1a","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_batch22_continuum_hypothesis_005","difficulty":"basic","question_type":"conceptual","question":"Does the continuum hypothesis claim that $\\mathbb{R}$ is countable?","options":["No. It asks if a cardinality lies between $\\aleph_0$ and $\\mathfrak{c}$.","Yes. It says $\\operatorname{card}(\\mathbb{R})=\\aleph_0$.","Yes. It says no infinite cardinality lies above $\\aleph_0$.","No. It says $\\mathbb{R}$ has no subsets of size $\\aleph_0$."],"answer_mode":"server","feedback_revision":"89a75d2a02ec40510db9ede9","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch22_continuum_hypothesis_006","difficulty":"basic","question_type":"application","question":"Which cardinality condition is ruled out if the continuum hypothesis is assumed true?","options":["$\\operatorname{card}(A)=\\aleph_0$","$\\aleph_0 \\lt \\operatorname{card}(A) \\lt \\mathfrak{c}$","$\\operatorname{card}(A)=\\mathfrak{c}$","$\\operatorname{card}(A)\\lt\\aleph_0$ for a finite set $A$"],"answer_mode":"server","feedback_revision":"0c54f7c1f324e71b27e6391a","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch22_continuum_hypothesis_007","difficulty":"basic","question_type":"application","question":"Assume the continuum hypothesis. Can there be a set $A$ with $\\aleph_0 \\lt \\operatorname{card}(A) \\lt \\mathfrak{c}$?","options":["Yes, because the hypothesis only concerns subsets of $\\mathbb{R}$","Yes, since Cantor's theorem gives sets of every cardinality","No, because the hypothesis rules out such a cardinality","No, because every uncountable set has cardinality $\\mathfrak{c}$"],"answer_mode":"server","feedback_revision":"1977664b5958af0ce57de0c7","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch22_continuum_hypothesis_008","difficulty":"basic","question_type":"application","question":"Assume the continuum hypothesis. If $A\\subseteq\\mathbb{R}$ is uncountable, what cardinality must $A$ have?","options":["$\\aleph_0$","A cardinality strictly between $\\aleph_0$ and $\\mathfrak{c}$","No cardinality at all","$\\mathfrak{c}$"],"answer_mode":"server","feedback_revision":"0da10c83d090cb04b0cafec2","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch22_continuum_hypothesis_009","difficulty":"basic","question_type":"application","question":"Does a countably infinite set violate the continuum hypothesis?","options":["Yes. It is strictly smaller than $\\mathfrak{c}$, which is enough.","Yes. Its size $\\aleph_0$ lies between $\\aleph_0$ and $\\mathfrak{c}$.","No. Its cardinality is exactly $\\aleph_0$, an endpoint.","No. Its cardinality is $\\mathfrak{c}$, the upper endpoint."],"answer_mode":"server","feedback_revision":"825693a80f9559f0dbdfecd0","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch22_continuum_hypothesis_012","difficulty":"standard","question_type":"conceptual","question":"What is the negation of the continuum hypothesis?","options":["Every set has cardinality $\\aleph_0$.","$\\mathfrak{c}$ is finite.","There is $A$ with $\\aleph_0<\\operatorname{card}(A)<\\mathfrak{c}$.","No uncountable set exists."],"answer_mode":"server","feedback_revision":"57d33dd06a81c749d29e080d","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch22_continuum_hypothesis_013","difficulty":"standard","question_type":"conceptual","question":"What does the strictness in $\\aleph_0 \\lt \\operatorname{card}(A) \\lt \\mathfrak{c}$ exclude?","options":["The cases $\\operatorname{card}(A)=\\aleph_0$ or $\\mathfrak{c}$.","Only finite sets","Only subsets of $\\mathbb{R}$","Only sets without bijections."],"answer_mode":"server","feedback_revision":"e1cf9e033d97e7b01b83f0c9","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch22_continuum_hypothesis_015","difficulty":"standard","question_type":"application","question":"Which set is not an intermediate-size counterexample to the continuum hypothesis?","options":["$\\mathbb{N}$","A set $A$ with $\\aleph_0 \\lt \\operatorname{card}(A) \\lt \\mathfrak{c}$","A subset of $\\mathbb{R}$ whose cardinality is strictly greater than $\\aleph_0$ and strictly less than $\\mathfrak{c}$","A hypothetical set of cardinality strictly between countable infinity and the continuum"],"answer_mode":"server","feedback_revision":"8c64896795584a746943615c","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch22_continuum_hypothesis_016","difficulty":"standard","question_type":"application","question":"If $\\operatorname{card}(A)=2^{\\aleph_0}$, what is $\\operatorname{card}(A)$ in continuum notation?","options":["$\\mathfrak{c}$","$\\aleph_0$","A finite cardinal","A cardinality strictly below $\\aleph_0$"],"answer_mode":"server","feedback_revision":"9bb1cba8a5226100d39e12a1","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"la_batch22_continuum_hypothesis_019","difficulty":"challenge","question_type":"application","question":"Which statement would be a direct counterexample to the continuum hypothesis?","options":["Some $A$ has $\\aleph_0<\\operatorname{card}(A)<\\mathfrak{c}$.","$\\mathbb{N}$ is countably infinite.","$\\operatorname{card}(\\mathbb{R})=\\mathfrak{c}$.","$[0,1]$ is uncountable."],"answer_mode":"server","feedback_revision":"d06c35ba7e520f1a37a1b673","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch22_continuum_hypothesis_020","difficulty":"challenge","question_type":"application","question":"Assume the continuum hypothesis. If $A\\subseteq\\mathbb{R}$ is neither finite nor countable, what must be true?","options":["$\\operatorname{card}(A)=\\aleph_0$","$\\operatorname{card}(A)=\\mathfrak{c}$","$A$ has no cardinality","$A$ must have cardinality strictly between $\\aleph_0$ and $\\mathfrak{c}$"],"answer_mode":"server","feedback_revision":"aced2ee8c479faadf3e3bec7","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}