bb{F}$ under discussion"],"answer_mode":"server","feedback_revision":"3056dd364f6af13cfb75ac94","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch21_root_of_a_polynomial_004","difficulty":"basic","question_type":"conceptual","question":"Why is a root described as an input rather than as a coefficient?","options":["Because it is never a scalar","Because it is always the constant term","Because it must multiply the leading coefficient","Because it is substituted into the polynomial"],"answer_mode":"server","feedback_revision":"89204c54b0fd16cb8502bd78","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"la_batch21_root_of_a_polynomial_005","difficulty":"basic","question_type":"conceptual","question":"What does it mean to say a field is algebraically closed?","options":["Every polynomial over it is constant, so it has no roots to find.","Every nonconstant polynomial over it has a root in that field","Every element of the field is zero","Every polynomial has degree one"],"answer_mode":"server","feedback_revision":"262314d594c5ca9a11c972cb","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"la_batch21_root_of_a_polynomial_006","difficulty":"basic","question_type":"application","question":"Which number is a root of $p(x)=x-2$?","options":["$2$","$1$","$0$","$-2$"],"answer_mode":"server","feedback_revision":"0f398c48e9332ccef69bba00","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch21_root_of_a_polynomial_007","difficulty":"basic","question_type":"application","question":"Which are the roots of $p(x)=x^2-1$?","options":["$1$ only","$1$ and $-1$","$-1$ only","$0$ and $1$"],"answer_mode":"server","feedback_r