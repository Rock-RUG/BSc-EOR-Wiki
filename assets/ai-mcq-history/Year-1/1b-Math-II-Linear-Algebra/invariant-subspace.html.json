th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-1/1b-Math-II-Linear-Algebra/invariant-subspace.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/invariant-subspace.html","questions":[{"id":"la_batch19_invariant_subspace_004","difficulty":"basic","question_type":"conceptual","question":"Which subspaces are always listed as basic invariant subspaces for a linear operator A?","options":["Only eigenspaces with positive eigenvalues.","${0}$, V, $ker A$, and $range A$.","Only ${0}$ and no other subspace.","All subsets of V, whether or not they are subspaces."],"answer_mode":"server","feedback_revision":"635af9cef2dff1bb3a062fd0","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"la_batch19_invariant_subspace_005","difficulty":"basic","question_type":"conceptual","question":"What is the geometric idea behind an invariant subspace?","options":["The operator sends every vector to a perpendicular vector.","The subspace contains no nonzero vector.","The subspace changes dimension after applying A.","The operator never sends that part of the space outside itself."],"answer_mode":"server","feedback_revision":"1dd4e1729cc33809900683f9","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_invariant_subspace_006","difficulty":"basic","question_type":"application","question":"For $A=\\begin{pmatrix}2&0\\\\0&3\\end{pmatrix}$, is the x-axis invariant?","options":["No, A sends $(x,0)$ to $(0,3x)$.","No, diagonal matrices have no invariant axes.","Only if x is positive.","Yes, A sends $(x,0)$ to $(2x,0)$."],"answer_mode":"server","feedback_revision":"eae36fa6395946a0fb3db6aa","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_invariant_subspace_008","difficulty":"basic","question_type":"application","question":"For $A=\\begin{pmatrix}0&1\\\\1&0\\end{pmatrix}$, is the x-axis invariant?","options":["No, A sends $(1,0)^{\\top}$ to $(0,1)^{\\top}$.","Yes, because A is square.","Only if the field is complex.","Yes, because every line through the origin is invariant."],"answer_mode":"server","feedback_revision":"7a01d744b940b2bd95918740","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_invariant_subspace_009","difficulty":"basic","question_type":"application","question":"Let A be any linear operator. Why is $ker A$ invariant under A?","options":["If $u∈ker A$, then $Au=0$, and $0∈ker A$.","If $u∈ker A$, then $Au=u$, so $u∈ker A$.","The kernel is invariant because it equals V for every A.","The kernel is invariant only when A is invertible."],"answer_mode":"server","feedback_revision":"0fe2e6e8963c8683693c666f","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_invariant_subspace_010","difficulty":"basic","question_type":"application","question":"For $A=\\begin{pmatrix}1&1\\\\0&1\\end{pmatrix}$, is $span((1,0)^{\\top})$ invariant?","options":["No, A sends it to $(1,1)^{\\top}$.","Only if the scalar is 1.","Yes, A sends $(1,0)^{\\top}$ to $(1,0)^{\\top}$.","No, only eigenspaces of diagonal matrices are invariant."],"answer_mode":"server","feedback_revision":"dcfeb931ccf3d7b0025cb465","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_invariant_subspace_013","difficulty":"standard","question_type":"conceptual","question":"Can a subspace U be invariant even if A is not the identity on U?","options":["Yes. A may move vectors inside U without fixing them.","No. Invariant means fixed pointwise.","No. Invariant means A sends U to zero.","Yes, but only when A maps every vector of U to a vector outside U."],"answer_mode":"server","feedback_revision":"c1e10d3955872f35518b53ee","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_invariant_subspace_015","difficulty":"standard","question_type":"application","question":"For $A=\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$, what is $range A$?","options":["$span((1,0)^{\\top})$","$R^2$","$span((0,1)^{\\top})$","${0}$"],"answer_mode":"server","feedback_revision":"2f124c4e96d4d94ce0b8d319","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"la_batch19_invariant_subspace_017","difficulty":"challenge","question_type":"conceptual","question":"For a one-dimensional subspace $span(p)$ with $p≠0$, what does invariance under A amount to?","options":["P is orthogonal to $Ap$.","P is an eigenvector of A.","P lies in $ker A$ only.","P has norm 1."],"answer_mode":"server","feedback_revision":"d2d589944e8dfdd54cdbd9d0","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_batch19_invariant_subspace_018","difficulty":"challenge","question_type":"conceptual","question":"Why is $\\ker A$ invariant under a linear operator $A$?","options":["If $u\\in\\ker A$, then $Au=0$, and $0\\in\\ker A$","Every $u\\in\\ker A$ satisfies $Au=u$","$\\ker A$ always equals $\\operatorname{range}A$","$A$ must be invertible whenever its kernel is invariant"],"answer_mode":"server","feedback_revision":"80643cc322d0669a7cd0f216","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_batch19_invariant_subspace_019","difficulty":"challenge","question_type":"application","question":"For $A=\\begin{pmatrix}1&1\\\\0&1\\end{pmatrix}$, is $span((0,1)^{\\top})$ invariant?","options":["No, because $A(0,1)^{\\top}=(1,1)^{\\top}$ is not in $span((0,1)^{\\top})$.","Only if the scalar multiplying $(0,1)^{\\top}$ is zero.","Yes, because every coordinate axis is invariant for upper triangular matrices.","Yes, because the matrix has eigenvalue 1."],"answer_mode":"server","feedback_revision":"d2bceb366a6f2e20e22ed116","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_invariant_subspace_020","difficulty":"challenge","question_type":"application","question":"Let U be the plane $z=0$ in $R^3$ and $A(x,y,z)=(x+y,y,2z)$. Is U invariant?","options":["Yes, if z=0 then the third coordinate of A(x,y,z) is also 0.","Only for vectors with x=y.","No, because A is not the identity on U.","No, because the first coordinate changes from $x$ to $x+y$ under A."],"answer_mode":"server","feedback_revision":"58ee03fb0fda48d2095a418b","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"}]}}