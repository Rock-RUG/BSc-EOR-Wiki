th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-1/1b-Math-II-Linear-Algebra/direct-sum.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/direct-sum.html","questions":[{"id":"la_batch19_direct_sum_002","difficulty":"basic","question_type":"conceptual","question":"For two subspaces, what condition is equivalent to the sum being direct?","options":["$V_1∩V_2$ contains a nonzero vector.","$V_1∩V_2=V_1+V_2$.","$V_1∩V_2={0}$.","$V_1=V_2$."],"answer_mode":"server","feedback_revision":"6b05b6385f50880392508443","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_batch19_direct_sum_003","difficulty":"basic","question_type":"conceptual","question":"What does the symbol $V_1\\oplus V_2$ emphasize that $V_1+V_2$ does not?","options":["The intersection is the whole space.","The two subspaces are multiplied.","The decomposition is unique.","The result is not a subspace."],"answer_mode":"server","feedback_revision":"9449ed9ffa16ac533e6a18f2","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_direct_sum_005","difficulty":"basic","question_type":"conceptual","question":"What is the standard direct-sum example in $R^2$?","options":["Two identical diagonal lines always form a direct sum.","The x-axis and y-axis form a direct sum equal to $R^2$.","The x-axis with itself forms a direct sum equal to $R^2$.","The origin alone and the origin alone form $R^2$."],"answer_mode":"server","feedback_revision":"1f4026900019a050f24e82cd","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"la_batch19_direct_sum_007","difficulty":"basic","question_type":"application","question":"Let $U=span((1,0))$ and $W=span((0,1))$ in $R^2$. What is $U∩W$?","options":["$W$","$R^2$","${0}$","$U$"],"answer_mode":"server","feedback_revision":"e46d36ed3d76e9dc14239be2","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"la_batch19_direct_sum_009","difficulty":"basic","question_type":"application","question":"If $V=U\\oplus W$ and $u+w=0$ with $u∈U$ and $w∈W$, what must be true?","options":["$u=w$ can be any nonzero vector.","$u=0$ and $w=0$","$u$ must equal $w$ but need not be zero.","$w$ must be outside W."],"answer_mode":"server","feedback_revision":"f5e16f35356fbcad90f29a70","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_batch19_direct_sum_011","difficulty":"standard","question_type":"conceptual","question":"Does $V_1+V_2=W$ automatically imply $W=V_1\\oplus V_2$?","options":["No. It also needs $W$ to be the whole space $V$.","No. The sum must also have unique decompositions.","Yes. Every sum of two subspaces is direct.","Yes, provided $V_1$ and $V_2$ are different subspaces."],"answer_mode":"server","feedback_revision":"61fd00f47c72ecebe62a8665","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_direct_sum_012","difficulty":"standard","question_type":"conceptual","question":"For two finite-dimensional subspaces, what dimension check is consistent with a direct sum?","options":["$dim U=dim W$ is required.","$dim(U+W)=dim U+dim W$.","$dim(U+W)=dim(U∩W)$ always.","$dim(U+W)=dim U-dim W$ always."],"answer_mode":"server","feedback_revision":"866c5fca9e4789ab72c6331a","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_direct_sum_013","difficulty":"standard","question_type":"conceptual","question":"What is the decomposition problem behind direct sums?","options":["Given w, find the unique components $v_i∈V_i$ whose sum is w.","Given w, find a single subspace $V_i$ that contains w by itself.","Given w, find some components $v_i∈V_i$ summing to w, in any number of ways.","Given the subspaces $V_i$, find the vectors w that lie in every $V_i$."],"answer_mode":"server","feedback_revision":"f6e2f25f1d82688b9b1c0822","time_limit":35,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_direct_sum_015","difficulty":"standard","question_type":"application","question":"In the previous example, write $(0,1)$ as $a(1,0)+b(1,1)$.","options":["$a=1$, $b=-1$","$a=0$, $b=1$","$a=1$, $b=1$","$a=-1$, $b=1$"],"answer_mode":"server","feedback_revision":"59933674230f64c9a0c5b300","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_batch19_direct_sum_016","difficulty":"standard","question_type":"application","question":"If $dim U=2$, $dim W=3$, and $U∩W={0}$, what is $dim(U\\oplus W)$?","options":["$3$","$1$","$5$","$6$"],"answer_mode":"server","feedback_revision":"1491f13b1c05b5886f2d9f07","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_batch19_direct_sum_018","difficulty":"challenge","question_type":"conceptual","question":"Can a direct sum use subspaces that are not perpendicular?","options":["Yes. Perpendicularity is stronger than the uniqueness condition.","No. In a direct sum the components must be orthogonal to each other.","Yes, but only when the subspaces together span the whole space.","No. Non-perpendicular subspaces always intersect nontrivially."],"answer_mode":"server","feedback_revision":"631331d75e702b649426fab2","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_batch19_direct_sum_019","difficulty":"challenge","question_type":"application","question":"Let $U=span((1,0,0),(0,1,0))$ and $W=span((1,1,0))$ in $R^3$. Is $U+W$ direct?","options":["No, because W is contained in U.","Only if the z-coordinate is ignored.","Yes, because the generators are nonzero.","Yes, because W is one-dimensional."],"answer_mode":"server","feedback_revision":"9a553187e6e586d36de1ff9f","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_batch19_direct_sum_020","difficulty":"challenge","question_type":"application","question":"Let $U=span((1,0,0),(0,1,0))$ and $W=span((0,0,1))$. What is the direct-sum decomposition of $(2,-1,5)$?","options":["$(0,0,5)+(2,-1,5)$","$(2,0,5)+(0,-1,0)$","$(2,-1,0)+(0,0,5)$","$(2,-1,5)+(0,0,5)$"],"answer_mode":"server","feedback_revision":"bd63a94d1483310ae983b76f","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}