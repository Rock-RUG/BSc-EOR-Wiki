th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-1/1b-Math-II-Linear-Algebra/de-moivres-formula.html","concept":{"concept_id":"Year-1/1b-Math-II-Linear-Algebra/de-moivres-formula.html","title":"De Moivre's Formula","questions":[{"id":"la_qc_demoivre_001","difficulty":"basic","question_type":"conceptual","question":"When $z=r(\\cos\\varphi+\\mathrm{i}\\sin\\varphi)$ is raised to the power $n$, what happens to the modulus?","options":["It becomes $nr$.","It becomes $r+n$.","It stays $r$ for every $n$.","It becomes $r^n$."],"answer_mode":"server","feedback_revision":"accfd6721cda810aad02b5f4","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_002","difficulty":"basic","question_type":"conceptual","question":"What happens to the angle in De Moivre’s formula?","options":["It becomes $n\\varphi$.","It becomes $\\varphi^n$.","It becomes $\\varphi+n$.","It is replaced by $r\\varphi$."],"answer_mode":"server","feedback_revision":"9f33e786057422eb9be1ad39","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_003","difficulty":"basic","question_type":"conceptual","question":"Why is polar form the natural input for De Moivre’s formula?","options":["Because Cartesian coordinates cannot represent complex numbers.","Because powers act directly on modulus and angle.","Because every complex number then has modulus $1$.","Because it avoids multiplication entirely."],"answer_mode":"server","feedback_revision":"9dc3d02701c4c36c0908e671","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"la_qc_demoivre_006","difficulty":"basic","question_type":"application","question":"What is $(\\cos\\varphi+\\mathrm{i}\\sin\\varphi)^2$?","options":["$2\\cos\\varphi+2\\mathrm{i}\\sin\\varphi$","$\\cos(\\varphi^2)+\\mathrm{i}\\sin(\\varphi^2)$","$\\cos(2\\varphi)+\\mathrm{i}\\sin(2\\varphi)$","$\\cos\\varphi-\\mathrm{i}\\sin\\varphi$"],"answer_mode":"server","feedback_revision":"f7f5e0756b5533b34ec73046","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_008","difficulty":"basic","question_type":"application","question":"Use De Moivre’s formula to compute $\\mathrm{i}^4$.","options":["$-1$","$\\mathrm{i}$","$-\\mathrm{i}$","$1$"],"answer_mode":"server","feedback_revision":"1e1e12d6f05f1878b1fe5f28","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"la_qc_demoivre_009","difficulty":"basic","question_type":"application","question":"Using polar form, what is $(1+\\mathrm{i})^2$?","options":["$2$","$-2$","$2\\mathrm{i}$","$1+2\\mathrm{i}$"],"answer_mode":"server","feedback_revision":"74950e612e7e5407705790aa","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_010","difficulty":"basic","question_type":"application","question":"If $z=3(\\cos\\varphi+\\mathrm{i}\\sin\\varphi)$, what is the modulus of $z^2$?","options":["$3$","$9$","$6$","$\\varphi^2$"],"answer_mode":"server","feedback_revision":"9685741e2d97bde96610f4d3","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_011","difficulty":"standard","question_type":"conceptual","question":"Why does the angle ambiguity in polar form not break De Moivre’s formula for integer powers?","options":["The angle ambiguity disappears because $n=0$ always.","Integer powers ignore the modulus.","Replacing $\\varphi$ by $\\varphi+2\\pi k$ changes $n\\varphi$ by a multiple of $2\\pi$.","Sine and cosine are not periodic."],"answer_mode":"server","feedback_revision":"703afc25558959d7580750fc","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_qc_demoivre_012","difficulty":"standard","question_type":"conceptual","question":"What geometric effect does taking powers have on a unit complex number?","options":["It changes the modulus to $n$ and keeps the angle fixed.","It multiplies the angle while keeping modulus $1$.","It sends every unit complex number to zero.","It turns the complex number into a real matrix."],"answer_mode":"server","feedback_revision":"3c3e7879892bc795a935c093","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_013","difficulty":"standard","question_type":"conceptual","question":"Why is De Moivre’s formula about powers, not directly about choosing roots?","options":["Roots of complex numbers are always real, so polar form is not needed.","Powers and roots coincide, so the formula already covers both directly.","Roots are inverse problems and generally have several possible answers.","Roots have no polar form, so the angle cannot be divided by $n$."],"answer_mode":"server","feedback_revision":"2e1c0ca10d07ca8d4adb4cd7","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_014","difficulty":"standard","question_type":"application","question":"Compute $\\left(\\cos\\frac{\\pi}{3}+\\mathrm{i}\\sin\\frac{\\pi}{3}\\right)^3$.","options":["$1$","$-1$","$\\mathrm{i}$","$-\\mathrm{i}$"],"answer_mode":"server","feedback_revision":"6c505586d47f29bf1ce3fa08","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_015","difficulty":"standard","question_type":"application","question":"Let $z=\\sqrt{2}(\\cos(\\pi/4)+\\mathrm{i}\\sin(\\pi/4))$. What is $z^4$?","options":["$-4$","$4$","$2\\mathrm{i}$","$-2$"],"answer_mode":"server","feedback_revision":"1176534c3d77c69aa1648e2d","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_016","difficulty":"standard","question_type":"application","question":"Let $z=1-\\mathrm{i}$. Which polar-form step is essential before using De Moivre's formula for $z^4$?","options":["Use modulus $1$ because the real part is $1$.","Replace $z$ by its real part before taking powers.","Use no argument because $z$ is not on the unit circle.","Use argument $-\\pi/4$ or an equivalent angle, not $\\pi/4$."],"answer_mode":"server","feedback_revision":"8948552448d54170f8b86317","time_limit":35,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_017","difficulty":"challenge","question_type":"conceptual","question":"Why is the case $z=0$ harmless for positive powers but not for negative powers?","options":["Negative powers make the angle unique.","Positive powers require $r \\lt 0$.","Positive powers of $0$ are defined; negative ones divide by $0$","The formula does not apply to positive powers of $z=0$, only to negative ones"],"answer_mode":"server","feedback_revision":"50357109d2ad9347acaeb43d","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_018","difficulty":"challenge","question_type":"conceptual","question":"Why is $(z^m)^n=z^{mn}$ consistent with the polar-form rule for integer powers?","options":["The modulus becomes $r^m\\cdot r^n=r^{m+n}$ and the angle becomes $m\\varphi+n\\varphi=(m+n)\\varphi$.","The modulus becomes $(r^m)^n=r^{mn}$ and the angle stays $m\\varphi$.","The modulus becomes $(r^m)^n=r^{m^n}$ and the angle becomes $(m\\varphi)^n$.","The modulus becomes $(r^m)^n=r^{mn}$ and the angle becomes $n(m\\varphi)=mn\\varphi$."],"answer_mode":"server","feedback_revision":"2b1a2982d34465affc394902","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"la_qc_demoivre_019","difficulty":"challenge","question_type":"application","question":"Compute $(1+\\sqrt{3}\\,\\mathrm{i})^3$ using De Moivre’s formula.","options":["$8$","$8\\mathrm{i}$","$-8$","$-8\\mathrm{i}$"],"answer_mode":"server","feedback_revision":"d402c326d675e3d422a68aa4","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"la_qc_demoivre_020","difficulty":"challenge","question_type":"application","question":"Use De Moivre’s formula to compute $\\mathrm{i}^6$.","options":["$1$","$-1$","$\\mathrm{i}$","$-\\mathrm{i}$"],"answer_mode":"server","feedback_revision":"7692219ba97e637c9712c573","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}