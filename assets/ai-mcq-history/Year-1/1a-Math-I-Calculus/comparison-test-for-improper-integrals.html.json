h endpoints.","Diverges at both endpoints."],"answer_mode":"server","feedback_revision":"dbdf9ff235c0f5d184974873","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"wiki20261002_comparison_improper_017","difficulty":"challenge","question_type":"application","question":"For real $a$, when does $\\int_1^\\infty x^a/(1+x^2)\\,\\mathrm{d}x$ converge?","options":["$a<2$","$a\\le1$","$a>1$","$a<1$"],"answer_mode":"server","feedback_revision":"5962c203a7634ec38a8e1ff6","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"wiki20261002_comparison_improper_018","difficulty":"challenge","question_type":"application","question":"For real $a$, when does $\\int_0^1 x^a/(1+x)\\,\\mathrm{d}x$ converge?","options":["$a<-1$","$a>-2$","$a>-1$","$a\\ge-1$"],"answer_mode":"server","feedback_revision":"7d301a7fba2d8925a0defaa3","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}