r","feedback_revision":"77ba1f3381e687405285b756","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_continuity_02671b24_012","difficulty":"challenge","question_type":"application","question":"Let $f(x)=\\frac{1}{x}$ with domain $X=\\mathbb{R}\\setminus\\{0\\}$. Where is $f$ continuous?","options":["$f$ is continuous at $x = 0$.","$f$ is continuous on its domain $X$.","$f$ is not continuous anywhere in $X$.","$f$ is a constant function."],"answer_mode":"server","feedback_revision":"469aa0f8da38dad2d5927e00","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"expansion_pack_011_continuity_new_001","difficulty":"standard","question_type":"conceptual","question":"Let $x_0\\in X$ be a limit point of $X$ and $f\\colon X\\to\\mathbb{R}$. With limits taken through $X$, continuity at $x_0$ is equivalent to which statement?","options":["$\\displaystyle\\lim_{x\\to x_0}f(x)=f(x_0)$","$\\displaystyle\\lim_{x\\to x_0}f(x)=0$","$\\displaystyle\\lim_{x\\to x_0}f(x)$ exists, whatever $f(x_0)$ is","$f(x_0)=0$"],"answer_mode":"server","feedback_revision":"dd6872fc18264728de20195a","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"expansion_pack_011_continuity_new_002","difficulty":"basic","question_type":"application","question":"Is a constant function $f(x)=c$ continuous on $\\mathbb{R}$?","options":["Yes; it is continuous at every real input","No; it has a jump at every real input","Yes; but only at the input $x=0$","Yes; but only when its value $c=0$"],"answer_mode":"server","feedback_revision":"de1c1c89ef8774798d321bd2","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"expansion_pack_011_cont