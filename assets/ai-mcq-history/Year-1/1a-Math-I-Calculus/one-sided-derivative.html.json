th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-1/1a-Math-I-Calculus/one-sided-derivative.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/one-sided-derivative.html","questions":[{"id":"year_1_1a_math_i_calculus_one_sided_derivative_70a3d191_002","difficulty":"basic","question_type":"conceptual","question":"What does a one-sided derivative measure?","options":["The average value of a function on the whole domain.","An instantaneous rate of change from one direction","The largest value attained by the function near the point.","Whether the function is bounded on every interval."],"answer_mode":"server","feedback_revision":"bc760a781000dd295a012ac5","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"year_1_1a_math_i_calculus_one_sided_derivative_70a3d191_003","difficulty":"basic","question_type":"application","question":"For $f(x) = |x|$, what is the right derivative at $0$?","options":["$-1$.","$0$.","$1$.","$2$."],"answer_mode":"server","feedback_revision":"f576b856d95cf3ad17838bc4","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_one_sided_derivative_70a3d191_005","difficulty":"standard","question_type":"conceptual","question":"If both one-sided derivatives exist at $x_0$, what additional condition implies differentiability at $x_0$?","options":["The left derivative is negative.","The right derivative is positive.","The left and right derivatives are equal.","The function is defined only on one side of $x_0$."],"answer_mode":"server","feedback_revision":"8fb1d37cd9921e0ec28c5048","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_one_sided_derivative_70a3d191_006","difficulty":"standard","question_type":"conceptual","question":"Is a one-sided derivative the same object as a one-sided limit of the derivative function?","options":["They are always the same object by definition.","One-sided derivatives only exist when the derivative function is continuous.","A one-sided derivative is not the same as a one-sided limit of the derivative function.","A one-sided derivative never uses a limit."],"answer_mode":"server","feedback_revision":"3675504082f1534bdfadba6d","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_one_sided_derivative_70a3d191_008","difficulty":"standard","question_type":"application","question":"Let $f(x) = x^2$ for $x \\ge 0$ and consider the boundary point $0$ of the domain $[0,\\infty)$. What is $f'_+(0)$?","options":["$1$.","$-1$.","$0$.","$2$."],"answer_mode":"server","feedback_revision":"f3711bff2e4df356a7898c33","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_one_sided_derivative_70a3d191_009","difficulty":"challenge","question_type":"conceptual","question":"Why does the left derivative use the same quotient $\\frac{f(x)-f(x_0)}{x-x_0}$ rather than changing the denominator to $x_0-x$?","options":["Because $x-x_0$ is always positive from the left.","The quotient is kept; only the limit direction changes","Because the left derivative ignores the value $f(x_0)$.","Because the left derivative is defined without a limit."],"answer_mode":"server","feedback_revision":"ff9f813e824f4b7a61faaf95","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_one_sided_derivative_70a3d191_010","difficulty":"challenge","question_type":"conceptual","question":"Which situation is especially suited to a one-sided derivative?","options":["Any interior point where $f$ has an ordinary two-sided derivative.","A point where $f$ is undefined, such as a vertical asymptote.","A boundary point where the function is defined only on one side.","A point where only one-sided limits of $f'$ can be computed."],"answer_mode":"server","feedback_revision":"731a8b0eec8a651902f2b992","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_one_sided_derivative_70a3d191_011","difficulty":"challenge","question_type":"application","question":"Let $f(x) = x^2$ for $x \\ge 0$ and $f(x) = x$ for $x \\lt 0$, with $f(0) = 0$. Which statement is true at $0$?","options":["$f'_+(0) = 0$ and $f'_-(0) = 1$, so $f$ is not differentiable at $0$.","$f'_+(0) = 1$ and $f'_-(0) = 0$, so $f$ is differentiable at $0$.","$f'_+(0) = f'_-(0) = 0$, so $f$ is differentiable at $0$.","The one-sided derivatives do not exist because $f(0) = 0$."],"answer_mode":"server","feedback_revision":"311ab97cddfa7ccad6c63c08","time_limit":45,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_one_sided_derivative_70a3d191_012","difficulty":"challenge","question_type":"application","question":"A function has $f'_+(a) = 4$ and $f'_-(a) = 4$. What follows?","options":["$f$ is differentiable at $a$ and $f'(a) = 4$.","$f$ is not differentiable at $a$ because the derivatives are one-sided.","$f$ must be a polynomial near $a$.","$f$ has a corner at $a$."],"answer_mode":"server","feedback_revision":"12b69b25064a66170024e691","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"one_sided_derivative_new_014","difficulty":"basic","question_type":"conceptual","question":"Which notation denotes the right derivative at $x_0$?","options":["$f'_+(x_0)$","$f'_-(x_0)$","$f(x_0^-)$","$\\lim_{x\\to\\infty}f(x)$"],"answer_mode":"server","feedback_revision":"211838d82e635494faf19850","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"one_sided_derivative_new_015","difficulty":"basic","question_type":"conceptual","question":"What quotient is used for both one-sided derivatives?","options":["$\\dfrac{f(x_0)-f(x)}{x-x_0}$","$\\dfrac{f(x)}{x_0}$","$\\dfrac{f(x)-f(x_0)}{x-x_0}$","$\\dfrac{x-x_0}{f(x)-f(x_0)}$"],"answer_mode":"server","feedback_revision":"5f9dd0f7cab8fbff7af0ce57","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"one_sided_derivative_new_016","difficulty":"basic","question_type":"application","question":"Let $f(x)=3x$ for $x\\ge0$. What is $f'_+(0)$?","options":["$0$","$-3$","$3$","The right derivative is undefined"],"answer_mode":"server","feedback_revision":"416de02d31ae2578401ea90e","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"one_sided_derivative_new_017","difficulty":"basic","question_type":"application","question":"Let $f(x)=-x$ for $x\\le0$ and $f(0)=0$. What is $f'_-(0)$?","options":["$-1$","$1$","$0$","The left derivative is undefined"],"answer_mode":"server","feedback_revisi