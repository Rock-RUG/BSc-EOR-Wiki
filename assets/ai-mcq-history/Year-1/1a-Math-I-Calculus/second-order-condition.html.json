th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-1/1a-Math-I-Calculus/second-order-condition.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/second-order-condition.html","questions":[{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_001","difficulty":"basic","question_type":"conceptual","question":"What does the second order condition use to classify a stationary point?","options":["The order of a sequence","The sign of $f''(x_0)$","The number of elements in a set","Only the value $f(x_0)$"],"answer_mode":"server","feedback_revision":"a59d16276fced6d8f08457a1","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_002","difficulty":"basic","question_type":"conceptual","question":"If $f''(x_0) \\lt 0$ at a stationary point, what does the condition indicate?","options":["$x_0$ is a local minimum point.","$x_0$ is not in the domain.","$x_0$ is a local maximum point.","Further analysis is always required."],"answer_mode":"server","feedback_revision":"a4be6c15937cd85b48bb0bf4","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_003","difficulty":"basic","question_type":"application","question":"At a stationary point $x_0$, suppose $f''(x_0) = 7$. What does the second order condition indicate?","options":["$x_0$ is a local maximum point.","$x_0$ is a local minimum point.","$x_0$ is undefined.","No conclusion is possible because $7 \\gt 0$."],"answer_mode":"server","feedback_revision":"ecdeb93d2399fd8ada73cb19","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_004","difficulty":"basic","question_type":"application","question":"At a stationary point $x_0$, suppose $f''(x_0) = -3$. What does the second order condition indicate?","options":["$x_0$ is a local maximum point.","$x_0$ is a local minimum point.","$x_0$ is a rational number only.","The point cannot be stationary."],"answer_mode":"server","feedback_revision":"50af4abb5350323f917384c4","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_005","difficulty":"standard","question_type":"conceptual","question":"What does $f''(x_0) = 0$ indicate in the second order condition?","options":["There is definitely a local maximum.","There is definitely a local minimum.","Further analysis is needed.","The first derivative is undefined."],"answer_mode":"server","feedback_revision":"cf2680a505476174f462d89f","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_006","difficulty":"standard","question_type":"conceptual","question":"Is the second order condition necessary, sufficient, or both for a local extremum?","options":["It is necessary but not sufficient.","It is sufficient but not necessary.","It never gives a conclusion.","It applies without a stationary point."],"answer_mode":"server","feedback_revision":"d7a125ea8bc424129fe680a8","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_007","difficulty":"standard","question_type":"application","question":"Given $f''(x) = 24x^2-10x^4$, what is $f''(2)$?","options":["$64$","$-112$","$24$","$-64$"],"answer_mode":"server","feedback_revision":"026220d53e443e2468e12f22","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_008","difficulty":"standard","question_type":"application","question":"Given $f''(2)=f''(-2)=-64<0$ at the stationary points $x=2$ and $x=-2$, what holds?","options":["They are both local minimum points.","They are not stationary points.","They require denominator zero.","They are local maximum points."],"answer_mode":"server","feedback_revision":"8020808e88f375b0fc33ebee","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_009","difficulty":"challenge","question_type":"conceptual","question":"Why is the assumption that $x_0$ is a stationary point important?","options":["It guarantees that $f''(x_0)$ exists, which the test needs to work.","The test classifies only stationary points; elsewhere it says nothing.","It makes $x_0$ an extremum already, so the sign of $f''$ only decides which type.","It ensures $f''(x_0)\\neq 0$, so the test can never be inconclusive."],"answer_mode":"server","feedback_revision":"77406a4e07dc53743665e675","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_010","difficulty":"challenge","question_type":"conceptual","question":"How does the second order condition refine the first order condition?","options":["It replaces the stationarity condition $f'(x_0)=0$ by $f''(x_0)=0$.","It uses second derivatives to find stationary points the first test misses.","It shows that every stationary point is a local maximum or minimum.","It uses second derivatives to distinguish maxima from minima."],"answer_mode":"server","feedback_revision":"642e02c34e559ab6155f5dfc","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_second_order_condition_77659bf5_012","difficulty":"challenge","question_type":"application","question":"Using $f''(x) = 24x^2-10x^4$, what does the second order condition say at $x = -2$?","options":["$x = -2$ is a local minimum point because $f''(-2) = 64 \\gt 0$.","$x = -2$ is inconclusive because $f''(-2) = 0$.","$x = -2$ is a local maximum point because $f''(-2) = -64 \\lt 0$.","$x = -2$ is a local minimum point because $f''(-2) = -64 \\lt 0$."],"answer_mode":"server","feedback_revision":"a9ca1d59a67960878a6de2fd","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"second_order_condition_new_014","difficulty":"basic","question_type":"conceptual","question":"What does a positive value of $f''(x_0)$ indicate at a stationary point?","options":["Local maximality.","Local minimality.","Failure of differentiability.","That $x_0$ is outside the interval."],"answer_mode":"server","feedback_revision":"d3b8658786fc41802301b3f4","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"second_order_condition_new_015","difficulty":"basic","question_type":"conceptual","question":"What type of information does the second order condition add to the first order condition?","options":["Information about the behaviour of $f$ as $x\\to\\pm\\infty$.","Area information from integrating $f$ over an interval near $x_0$.","Slope information about where $f'(x)$ equals zero.","Curvature information from the second derivative."],"answer_mode":"server","feedback_revision":"41b81ad24e93f37bca3490dc","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"second_order_condition_new_020","difficulty":"standard","question_type":"application","question":"For $f''(x)=24x^2-10x^4$, what does $f''(0)=0$ tell us at the stationary point $x=0$?","options":["$x=0$ is automatically a local maximum.","The condition alone is inconclusive.","$x=0$ is automatically not stationary.","$x=0$ lies outside the domain."],"answer_mode":"server","feedback_revision":"7293012cb236928c582e25fd","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}