othing$","$\\{1,\\{2\\}\\}$","$\\{\\{1,2\\}\\}$"],"answer_mode":"server","feedback_revision":"73bd3afb0f6586eb56931850","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year-1-1a-math-i-calculus-singleton-set-html-q20","difficulty":"challenge","question_type":"conceptual","question":"For any object $a$, why does the set written as $\\{a,a\\}$ have exactly one element?","options":["Because every set with braces is a singleton.","Because $a$ and $a$ are two different elements of the set that happen to share the same name.","Because repeated occurrences of the same element do not create distinct set elements.","Because the second $a$ is ignored only when $a=0$."],"answer_mode":"server","feedback_revision":"15a0b851546703b26ba23838","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}