43104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_005","difficulty":"standard","question_type":"conceptual","question":"What does the proposition define as $a_n$?","options":["$a_n = \\sum_{i = 1}^{n}f(i)+\\int_1^n f(x)\\,\\mathrm{d}x$","$a_n = \\sum_{i = 1}^{n}f(i)-\\int_0^n f(x)\\,\\mathrm{d}x$","$a_n = \\sum_{i = 1}^{n}f(i)-\\int_1^n f(x)\\,\\mathrm{d}x$","$a_n = \\sum_{i = 1}^{\\infty}f(i)-\\int_1^{\\infty} f(x)\\,\\mathrm{d}x$"],"answer_mode":"server","feedback_revision":"c25390747c81b1e038385918","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_007","difficulty":"standard","question_type":"application","question":"Let $f$ be positive, continuous and decreasing on $[1,\\infty)$, with $\\int_1^\\infty f(x)\\,\\mathrm{d}x$ convergent. What does the integral test imply about the series $\\sum_{n=1}^\\infty f(n)$?","options":["$\\sum_{n = 1}^{\\infty} f(n)$ diverges","$\\sum_{n = 1}^{\\infty} f(n)$ converges","The test gives the exact value of $\\sum_{n = 1}^{\\infty}f(n)$","$f$ must be increasing"],"answer_mode":"server","feedback_revision":"c05b381ca4291bfeca9739d2","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_008","difficulty":"standard","question_type":"application","question":"Let $f$ be positive, continuous and decreasing on $[1,\\infty)$, with $\\int_1^\\infty f(x)\\,\\mathrm{d}x$ divergent. What does the integral test imply about the series $\\sum_{n=1}^\\infty f(n)$?","options":["$\\sum_{n = 1}^{\\infty} f(n)$ converges","$\\sum_{n = 1}^{\\infty} f(n)$ diverges","The first term is undefined","The test gives the exact sum"],"answer_mode":"server","feedback_revision":"185481ec8a7ae83279568fec","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_009","difficulty":"challenge","question_type":"conceptual","question":"Which missing assumption would make use of the integral test unsafe?","options":["The function $f$ may fail to be differentiable.","Nonnegativity or monotone decrease may fail.","$f$ may have no antiderivative in closed form.","The terms $f(n)$ may fail to tend to $0$."],"answer_mode":"server","feedback_revision":"f7e46fdbd6dff9c4e95dc1e9","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_010","difficulty":"challenge","question_type":"conceptual","question":"Under the integral test hypotheses on $f$, what is the conclusion about the sequence $\\left(\\sum_{i=1}^n f(i)-\\int_1^n f(x)\\,\\mathrm{d}x\\right)_{n=1}^\\infty$?","options":["It is always equal to zero","It is convergent","It is divergent","It is undefined for all $n \\geq 1$"],"answer_mode":"server","feedback_revision":"625242538498d8f71bcee87a","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_011","difficulty":"challenge","question_type":"application","question":"A student applies the integral test and then reports the exact value of $\\sum_{n = 1}^{\\infty}f(n)$ from the integral comparison alone. What is the issue?","options":["Nothing; the integral comparison gives the sum exactly.","The sum is exact only after adding the term $f(1)$ to the integral.","The test gives convergence information, not the exact sum.","The value is right only up to an additive constant $C$."],"answer_mode":"server","feedback_revision":"dc9f99b97a98336166ba776e","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_012","difficulty":"challenge","question_type":"application","question":"Apply the integral test with $f(x)=1/x$ on $[1,\\infty)$ to the harmonic series $\\sum_{n=1}^\\infty 1/n$. Which conclusion about convergence is correct?","options":["It diverges, because $\\int_1^{\\infty}\\frac{1}{x}\\,\\mathrm{d}x$ diverges","It converges, because its terms $1/n$ tend to $0$","It converges, because $\\int_1^{\\infty}\\frac{1}{x}\\,\\mathrm{d}x$ is finite","The test does not apply, since $1/x$ is not defined at $0$"],"answer_mode":"server","feedback_revision":"b3be712b96e2ca9b72093843","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_013","difficulty":"basic","question_type":"conceptual","question":"What kind of function is required for the integral test?","options":["Nonnegative, continuous, and decreasing.","Negative and increasing only","Only discontinuous, unbounded functions.","Constant equal to zero only"],"answer_mode":"server","feedback_revision":"f7c22ca64236b332cc1c5c75","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_014","difficulty":"basic","question_type":"conceptual","question":"What does the integral test compare an infinite series with?","options":["A related improper integral","A finite product","A derivative at one point","A maximum on a closed interval"],"answer_mode":"server","feedback_revision":"f81b4bd64a3dc44bd166ae81","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_015","difficulty":"basic","question_type":"conceptual","question":"Does the integral test give the exact value of the series sum?","options":["Yes, the sum equals $\\int_1^{\\infty}f(x)\\,\\mathrm{d}x$","Only when the improper integral converges","No, it provides a comparison for convergence","Only when $f$ has an elementary antiderivative"],"answer_mode":"server","feedback_revision":"e51ef07abfeebb54bb6d657d","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_016","difficulty":"basic","question_type":"application","question":"Which improper integral is paired with $\\displaystyle\\sum_{n=1}^\\infty\\frac{1}{n^3}$ by the integral test?","options":["$\\displaystyle\\int_0^1 x^3\\,\\mathrm{d}x$","$\\displaystyle\\int_1^\\infty\\frac{1}{x^3}\\,\\mathrm{d}x$","$\\displaystyle\\int_1^3\\frac{1}{x}\\,\\mathrm{d}x$","$\\displaystyle\\int_1^\\infty x^3\\,\\mathrm{d}x$"],"answer_mode":"server","feedback_revision":"8f0cb653598f039f158c8902","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_017","difficulty":"basic","question_type":"application","question":"If $f(x)=1/x^2$, which property needed for the test holds on $[1,+\\infty)$?","options":["$f$ is nonnegative and increasing","$f$ is nonnegative and decreasing","$f$ is negative and decreasing","$f$ is unbounded near $x=1$"],"answer_mode":"server","feedback_revision":"1c678259cadd31548b217f41","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_018","difficulty":"basic","question_type":"application","question":"If $\\displaystyle\\int_1^\\infty f(x)\\,\\mathrm{d}x$ converges under the test hypotheses, what happens to $\\sum_{n=1}^\\infty f(n)$?","options":["It diverges","It equals the integral exactly","It has no partial sums","It converges"],"answer_mode":"server","feedback_revision":"bada35d3bc6a1b4e0b760b07","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_integral_test_for_convergence_5acd1c2e_020","difficulty":"standard","question_type":"application","question":"Let $f\\colon[1,\\infty)\\to[0,\\infty)$ be continuous and decreasing. If $\\int_1^\\infty f(x)\\,\\mathrm{d}x$ diverges, which conclusion about $\\sum_{n=1}^\\infty f(n)$ follows from the integral test?","options":["$\\displaystyle\\sum_{n=1}^\\infty f(n)$ converges to the integral","The function must be negative","$\\displaystyle\\sum_{n=1}^\\infty f(n)$ diverges","The series has only finitely many terms"],"answer_mode":"server","feedback_revision":"45e9da161079765aec5b0134","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}