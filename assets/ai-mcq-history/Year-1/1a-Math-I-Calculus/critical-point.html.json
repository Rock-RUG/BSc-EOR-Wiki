th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-1/1a-Math-I-Calculus/critical-point.html","concept":{"concept_id":"Year-1/1a-Math-I-Calculus/critical-point.html","questions":[{"id":"year_1_1a_math_i_calculus_critical_point_286e9a26_003","difficulty":"basic","question_type":"application","question":"For $f(x) = x^2$, which point is a critical point?","options":["$x = 0$","$x = 1$","$x = -1$","$x = 2$"],"answer_mode":"server","feedback_revision":"288a07b506de0261230e3c8b","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_critical_point_286e9a26_005","difficulty":"standard","question_type":"conceptual","question":"What is the precise relationship between local extrema and critical points?","options":["Every critical point is a local extremum.","Local extrema can occur only at critical points.","Local extrema never occur at critical points.","Critical points occur only where the derivative fails to exist."],"answer_mode":"server","feedback_revision":"fc2fb8c3901c5c6d637ab523","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"pilot_critical_point_002","difficulty":"standard","question_type":"conceptual","question":"Which function has a critical point at $0$ that is not a local extremum?","options":["$f(x)=-x^2$","$f(x)=x^3$","$f(x)=x^2$","$f(x)=x^2+1$"],"answer_mode":"server","feedback_revision":"820af6a31b4283779f6574ac","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_critical_point_286e9a26_007","difficulty":"standard","question_type":"application","question":"For $f(x)=x^3$, the point $x=0$ is a critical point. What does this example show?","options":["A critical point need not correspond to an extremum.","Every point where $f'(x_0)=0$ is a local maximum or minimum.","An extremum at $x_0$ requires $f''(x_0)\\neq0$.","Critical points arise only where $f'$ is undefined."],"answer_mode":"server","feedback_revision":"446a0ea61faf404d33763031","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"pilot_critical_point_003","difficulty":"standard","question_type":"application","question":"Which set lists all critical points of $f(x)=x^3-3x$?","options":["$\\{3\\}$","$\\{-3,0,3\\}$","$\\{-1,1\\}$","$\\{0\\}$"],"answer_mode":"server","feedback_revision":"30ac07f94a7a236d1f01ce50","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_critical_point_286e9a26_009","difficulty":"challenge","question_type":"conceptual","question":"Which case shows why the condition $x_0\\in X$ matters?","options":["A point outside $X$ is critical whenever the formula for $f'$ is undefined there.","It ensures every critical point is a local extremum of $f$.","A point outside $X$ is not critical, even if a formula is undefined there.","It guarantees that $f'(x_0)$ exists at every critical point."],"answer_mode":"server","feedback_revision":"08a0ff739636d69a3ba17860","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_math_i_calculus_critical_point_286e9a26_010","difficulty":"challenge","question_type":"conceptual","question":"Which type of behaviour can critical points indicate besides local extrema?","options":["Non-smooth behaviour","Zeros of the function","Vertical asymptotes","Horizontal asymptotes"],"answer_mode":"server","feedback_revision":"572669c095a7221e46760904","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"year_1_1a_math_i_calculus_critical_point_286e9a26_011","difficulty":"challenge","question_type":"application","question":"Let $f(x) = \\frac{1}{x}$ with domain $X = \\mathbb{R}\\setminus\\{0\\}$. Is $x = 0$ a critical point?","options":["Yes, because the formula is undefined at $0$.","Yes, because $f'(0) = 0$.","No, because $0\\notin X$.","No, because all undefined derivatives are ignored even inside the domain."],"answer_mode":"server","feedback_revision":"b188e048ed427a1761bd0ce7","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_1a_math_i_calculus_critical_point_286e9a26_012","difficulty":"challenge","question_type":"application","question":"Let $f(x) = |x-2|$ on $\\mathbb{R}$. Which statement best matches the definition of a critical point?","options":["$x = 2$ is critical because the derivative is undefined there.","$x = 2$ is not critical because $f(2) = 0$.","Every $x \\neq 2$ is critical because the function is absolute-valued.","No point can be critical unless the derivative is zero."],"answer_mode":"server","feedback_revision":"c5d7de6ce4760fc45a108c30","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"expansion_pack_013_critical_point_new_001","difficulty":"basic","question_type":"conceptual","question":"Which two derivative behaviours can make a domain point critical?","options":["The derivative is positive or negative.","The derivative is zero or undefined.","The function value is zero or one.","The input is rational or irrational."],"answer_mode":"server","feedback_revision":"8e4b18a6c823a733536ddfcf","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"pilot_critical_point_005","difficulty":"standard","question_type":"conceptual","question":"Is the condition $f'(x_0)=0$ sufficient for $x_0$ to be a local extremum?","options":["No: $f'(x_0)=0$ gives criticality, not an extremum.","Yes: a zero derivative always marks a local extremum.","Yes, provided $f$ is differentiable on all of $\\mathbb{R}$.","No: local extrema occur only where $f'$ is undefined."],"answer_mode":"server","feedback_revision":"89e5ed9c5ee0ded71ab4e0a1","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"pilot_critical_point_007","difficulty":"challenge","question_type":"conceptual","question":"A function has a sharp corner at an interior point $x_0$ of its domain. Is $x_0$ critical?","options":["Yes: $f'(x_0)$ is undefined at a corner.","No: $f$ is not continuous at a corner.","Only if the one-sided slopes have opposite signs.","Only if $f(x_0)=0$, as for $|x|$ at $0$."],"answer_mode":"server","feedback_revision":"c1560c86b9f9dbc7ada201b0","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"expansion_pack_013_critical_point_new_006","difficulty":"basic","question_type":"application","question":"Let $f'(x)=2x-4$ on $\\mathbb{R}$. Which point satisfies the zero-derivative critical-point condition?","options":["$x=0$","$x=4$","$x=-2$","$x=2$"],"answer_mode":"server","feedback_revision":"d28222cc811d5cd71f14ea2a","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"pilot_critical_point_009","difficulty":"basic","question_type":"application","question":"For $f(x)=x^3$, which point satisfies $f'(x)=0$?","options":["$x=0$","$x=1$","$x=-1$","$x=3$"],"answer_mode":"server","feedback_revision":"244d7dd1fb6a78036937ebb8","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}