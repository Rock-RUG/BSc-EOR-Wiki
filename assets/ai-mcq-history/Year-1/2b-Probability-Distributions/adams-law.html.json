ed","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2b_probability_distributions_adams_law_f1d0ecd5_013","difficulty":"standard","question_type":"conceptual","question":"Suppose $\\mathbb{E}[Y\\mid X]=0$ almost surely. What follows?","options":["$\\mathbb{E}[Y]=0$","$Y=0$ almost surely","$X$ and $Y$ are independent","$\\mathbb{E}[X]=0$"],"answer_mode":"server","feedback_revision":"3e03e80c592a8d8a485c95d9","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2b_probability_distributions_adams_law_f1d0ecd5_015","difficulty":"standard","question_type":"application","question":"An insurer handles $N$ claims. The count $N$ is the number of independent Bernoulli trials up to and including the first success, with success probability $\\tfrac{1}{4}$ per trial. Nonnegative claim sizes each have mean $50$ and are independent of $N$. What is the expected total claim amount?","options":["$50$","$12.5$","$150$","$200$"],"answer_mode":"server","feedback_revision":"922d1f19ee259522dc370879","time_limit":35,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2b_probability_distributions_adams_law_f1d0ecd5_018","difficulty":"challenge","question_type":"conceptual","question":"Let $\\mathbb{E}[Y^2]<\\infty$. A student proposes computing $\\mathbb{E}[Y^2]$ as $\\mathbb{E}[(\\mathbb{E}[Y\\mid X])^2]$. Which condition is necessary and sufficient for this calculation to be correct?","options":["$\\operatorname{Var}(Y\\mid X)=0$ almost surely","$\\mathbb{E}[Y\\mid X]$ is constant almost surely","The joint law of $(X,Y)$ is the product of the marginals","$\\mathbb{E}[Y]=0$"],"answer_mode":"server","feedback_revision":"e3e3089357f8172d221e18ee","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code"