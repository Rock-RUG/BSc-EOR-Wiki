th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-1/2b-Probability-Distributions/poisson-splitting.html","concept":{"concept_id":"Year-1/2b-Probability-Distributions/poisson-splitting.html","questions":[{"id":"year_1_2b_probability_distributions_poisson_splitting_73bfdfd0_007","difficulty":"basic","question_type":"application","question":"$N\\sim\\operatorname{Pois}(6)$ items get labels A, B, C with probabilities $\\tfrac{1}{2}$, $\\tfrac{1}{3}$, $\\tfrac{1}{6}$, independently. What is the probability that no item is labelled C?","options":["$\\mathrm{e}^{-6}$","$\\big(\\tfrac{5}{6}\\big)^6$","$\\mathrm{e}^{-1}$","$1-\\mathrm{e}^{-1}$"],"answer_mode":"server","feedback_revision":"3ccf6a4b4025eef71bb31eed","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2b_probability_distributions_poisson_splitting_73bfdfd0_008","difficulty":"basic","question_type":"application","question":"Let $N\\sim\\operatorname{Pois}(4)$. Each item is labelled type 1 with probability $1/4$ and type 2 otherwise, independently of the other labels and of $N$. Let $X$ and $Y$ count the two types. What is $\\mathbb{P}(X=1,Y=0)$?","options":["$4\\mathrm{e}^{-4}$","$\\mathrm{e}^{-3}$","$3\\mathrm{e}^{-4}$","$\\mathrm{e}^{-4}$"],"answer_mode":"server","feedback_revision":"9a561a1e00470dfededea1df","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2b_probability_distributions_poisson_splitting_73bfdfd0_009","difficulty":"basic","question_type":"application","question":"Visitors number $N\\sim\\operatorname{Pois}(50)$, and each is a member with probability $0.28$, independently. What is the standard deviation of the number of non-members?","options":["$36$","$6$","$\\sqrt{50}$","$\\sqrt{14}$"],"answer_mode":"server","feedback_revision":"512528d587da6a9f69239f1a","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2b_probability_distributions_poisson_splitting_73bfdfd0_011","difficulty":"standard","question_type":"conceptual","question":"Let $N\\sim\\operatorname{Pois}(\\lambda)$ with $\\lambda>0$. Independently of $N$, each item receives an independent categorical label with fixed probabilities $p_1,\\ldots,p_k$ summing to $1$. Let $X_i,X_j$ be distinct category counts with $p_i,p_j>0$. Given $N=n$, their covariance is $-np_ip_j$. What is their unconditional covariance?","options":["$-\\lambda p_ip_j$","$\\lambda p_ip_j$","$-\\lambda^2p_ip_j$","$0$"],"answer_mode":"server","feedback_revision":"ba491f87d15aea9feaf3f0e8","time_limit":35,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"later_topic_preview"},{"id":"year_1_2b_probability_distributions_poisson_splitting_73bfdfd0_013","difficulty":"standard","question_type":"conceptual","question":"Let $N\\sim\\operatorname{Pois}(\\lambda)$ with $\\lambda>0$. Each item is labelled type 1 with probability $0<p<1$, independently of the other labels and of $N$. The type counts $X$ and $Y=N-X$ are independent. Is $X$ also independent of $N$?","options":["No: $\\operatorname{Cov}(X,N)=\\lambda p>0$","Yes, because $X$ is independent of $Y$","Yes, because the labels are independent of $N$","No: $X$ always equals $pN$ exactly"],"answer_mode":"server","feedback_revision":"f5ecd7d805aaac9c5e3b8105","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2b_probability_distributions_poisson_splitting_73bfdfd0_017","difficulty":"challenge","question_type":"conceptual","question":"Let $N\\sim\\operatorname{Bin}(m,r)$, where $m\\ge1$ is an integer and $0<r<1$. Independently of $N$ and of the other labels, each item is labelled type 1 with probability $0<p<1$. Let $X$ and $Y=N-X$ be the type counts. Which statement gives their unconditional covariance and the resulting independence conclusion?","options":["$\\operatorname{Cov}(X,Y)=-mr^2p(1-p)$: dependent","$\\operatorname{Cov}(X,Y)=0$: independent, as in Poisson splitting","$\\operatorname{Cov}(X,Y)=-mrp(1-p)$: dependent","$\\operatorname{Cov}(X,Y)=mr(1-r)p(1-p)$: dependent"],"answer_mode":"server","feedback_revision":"ba048fa30be434e982cbdf5d","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2b_probability_distributions_poisson_splitting_73bfdfd0_018","difficulty":"challenge","question_type":"conceptual","question":"Let $N\\sim\\operatorname{Pois}(\\lambda)$ with $\\lambda>0$. Independently of $N$, choose a batch probability $P$ equal to $a$ or $b$, each with probability $1/2$, where $0<a<b<1$. Given $P$, label the items independently of each other and of $N$, with type-1 probability $P$. Let $X,Y$ count the two types. What is their unconditional covariance?","options":["$0$","$-\\lambda^2(b-a)^2/4$","$\\lambda^2(b-a)^2/4$","$-\\lambda(b-a)^2/4$"],"answer_mode":"server","feedback_revision":"919b34f6194a899ef5242253","time_limit":45,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"later_topic_preview"}]}}