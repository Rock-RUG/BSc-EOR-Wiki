/2}$","$2\\mathrm{e}^{-2}$"],"answer_mode":"server","feedback_revision":"bc623c4d82e5f80289d70fa2","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2b_probability_distributions_conditional_cumulative_distribution_function_107bf435_009","difficulty":"basic","question_type":"application","question":"For a fixed conditioning value $y$, suppose $F_{X\\mid Y}(-2\\mid y)=0.18$ and $F_{X\\mid Y}(4\\mid y)=0.73$. What is $\\mathbb{P}(-2<X\\le4\\mid Y=y)$?","options":["$0.55$","$0.73$","$0.91$","$0.27$"],"answer_mode":"server","feedback_revision":"87b47c27c497638d6ce3a2d3","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"year_1_2b_probability_distributions_conditional_cumulative_distribution_function_107bf435_010","difficulty":"basic","question_type":"application","question":"Given $Y=y$, $X$ is uniform on $(y,y+2)$. What is $\\mathbb{P}(X\\le1.5\\mid Y=1)$?","options":["$0.25$","$0.75$","$0.5$","$1$"],"answer_mode":"server","feedback_revision":"19d3c2a0cd9bdfdc30c677c1","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2b_probability_distributions_conditional_cumulative_distribution_function_107bf435_014","difficulty":"standard","question_type":"application","question":"Given $Y=y>0$, $X$ is uniform on $(0,y^2)$. What is the conditional median of $X$ given $Y=2$?","options":["$1$","$2$","$4$","$\\sqrt{2}$"],"answer_mode":"server","feedback_revision":"f1f43decaf0bd8b10e1d8998","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2b_probability_distributions_conditional_cumulative_distribution_function_107bf435_015","difficulty":"standard","question_type":"application","question":"$X=Y+Z$, where $Z\\sim\\operatorname{Exp}(1)$ is independent of $Y$. What is $\\mathbb{P}(X>3\\mid Y=1)$?","options":["$\\mathrm{e}^{-3}$","$1-\\mathrm{e}^{-2}$","$\\mathrm{e}^{-1}$","$\\mathrm{e}^{-2}$"],"answer_mode":"server","feedback_revision":"ec61705f926c8337aa5e044c","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2b_probability_distributions_conditional_cumulative_distribution_function_107bf435_016","difficulty":"standard","question_type":"application","question":"For each $y>0$, $X\\mid Y=y$ is uniform on $(0,y)$. For which conditioning values is $\\mathbb{P}(X\\le1\\mid Y=y)=1$?","options":["Only $y=1$","$y\\ge1$","Every $y>0$","$0<y\\le1$"],"answer_mode":"server","feedback_revision":"458ac5a7823d44f4790fc41a","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2b_probability_distributions_conditional_cumulative_distribution_function_107bf435_017","difficulty":"challenge","question_type":"conceptual","question":"Let $Y$ be continuous and $X=2Y$, so that $(X,Y)$ has no joint density. Given $Y=y$, which distribution has the CDF $F_{X\\mid Y}(x\\mid y)$?","options":["A uniform law between zero and $2y$.","A point mass concentrated at $2y$.","The marginal law of $X$, with CDF $F_Y(x/2)$.","No distribution, because a joint density is required."],"answer_mode":"server","feedback_revision":"9e4c66e59c6bb9868a3f82b7","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"out_of_course_scope"}]}}