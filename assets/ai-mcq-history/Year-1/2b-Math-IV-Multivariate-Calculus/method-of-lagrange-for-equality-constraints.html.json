$","$(x,y,z)=(3/2,1/2,1)$, $(\\mu,\\nu)=(2,-1)$","$(x,y,z)=(2,1,0)$, $(\\mu,\\nu)=(3,1)$","$(x,y,z)=(3/2,1/2,1)$, $(\\mu,\\nu)=(2,1)$"],"answer_mode":"server","feedback_revision":"201b8a408852beccd2020194","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"}]}}