th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-1/2b-Math-IV-Multivariate-Calculus/multivariable-inverse-function-theorem.html","concept":{"concept_id":"Year-1/2b-Math-IV-Multivariate-Calculus/multivariable-inverse-function-theorem.html","questions":[{"id":"year_1_2b_math_iv_multivariate_calculus_multivariable_inverse_function_theorem_5616bfba_003","difficulty":"basic","question_type":"conceptual","question":"Let $f\\colon A\\to\\mathbb{R}^n$ be $C^1$ on an open set $A\\subseteq\\mathbb{R}^n$, with $x_0\\in A$ and $\\det Df(x_0)\\ne0$. The inverse function theorem gives an open neighbourhood $V$ of $x_0$ on which $f$ is bijective onto the open set $f(V)$. What follows for outputs near $y_0=f(x_0)$?","options":["Every output in $\\mathbb{R}^n$ has a unique preimage in $V$","Every sufficiently nearby output has a unique preimage in $V$","Nearby outputs have preimages in $V$, but uniqueness is not guaranteed","Nearby outputs can lie outside $f(V)$ no matter how close they are to $y_0$"],"answer_mode":"server","feedback_revision":"ee9141893b6a1dd6687a9fe2","time_limit":40,"curation_status":"retired","retired_at":"2026-10-26T13:01:42.374624+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2b_math_iv_multivariate_calculus_multivariable_inverse_function_theorem_5616bfba_006","difficulty":"basic","question_type":"application","question":"For $f(x,y)=(x+y^2,\\ y+x^2)$ at $x_0=(1,0)$, with $y_0=f(x_0)=(1,1)$, what is the derivative of the local inverse at $y_0$?","options":["$\\begin{pmatrix}1&0\\\\2&1\\end{pmatrix}$","$\\begin{pmatrix}1&0\\\\-2&1\\end{pmatrix}$","$\\begin{pmatrix}1&0\\\\ \\tfrac{1}{2}&1\\end{pmatrix}$","$\\tfrac{1}{3}\\begin{pmatrix}-1&2\\\\2&-1\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"60fa5bd44d516a524c8e289c","time_limit":25,"curation_status":"retired","retired_at":"2026-10-26T13:01:42.374624+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2b_math_iv_multivariate_calculus_multivariable_inverse_function_theorem_5616bfba_007","difficulty":"basic","question_type":"application","question":"For $f(x,y)=(\\mathrm{e}^x\\cos y,\\mathrm{e}^x\\sin y)$ on $\\mathbb{R}^2$, at which points does the multivariable inverse function theorem apply?","options":["Only where $\\cos y\\ne0$","Only at points with $x>0$","Nowhere, as $f$ is periodic in $y$","At every point of $\\mathbb{R}^2$"],"answer_mode":"server","feedback_revision":"5da431402b1c90194429679f","time_limit":30,"curation_status":"retired","retired_at":"2026-10-26T13:01:42.374624+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2b_math_iv_multivariate_calculus_multivariable_inverse_function_theorem_5616bfba_011","difficulty":"standard","question_type":"conceptual","question":"Let $f\\colon A\\to\\mathbb{R}^n$ be differentiable on an open set $A\\subseteq\\mathbb{R}^n$. Suppose it has a differentiable local inverse $g$ with $y_0=f(x_0)$ and $g(y_0)=x_0$. Which identity follows by differentiating $g(f(x))=x$ at $x_0$?","options":["$Dg(x_0)\\,Df(y_0)=I_n$","$Dg(y_0)+Df(x_0)=I_n$","$Dg(y_0)\\,Df(x_0)=0_{n\\times n}$","$Dg(y_0)\\,Df(x_0)=I_n$"],"answer_mode":"server","feedback_revision":"63b45be9d517381f04883988","time_limit":30,"curation_status":"retired","retired_at":"2026-10-26T13:01:42.374624+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2b_math_iv_multivariate_calculus_multivariable_inverse_function_theorem_5616bfba_015","difficulty":"standard","question_type":"application","question":"For $f(x)=x^2$ near $x_0=-2$, which formula gives the local inverse near $y_0=4$?","options":["$y\\mapsto\\sqrt y$","$y\\mapsto-\\sqrt y$","$y\\mapsto1/y^2$","None, since $x^2$ is not injective"],"answer_mode":"server","feedback_revision":"7e194408cf5e942d72e93078","time_limit":30,"curation_status":"retired","retired_at":"2026-10-26T13:01:42.374624+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2b_math_iv_multivariate_calculus_multivariable_inverse_function_theorem_5616bfba_017","difficulty":"challenge","question_type":"conceptual","question":"Let $f\\colon A\\to\\mathbb{R}^n$ be $C^1$ on an open set $A\\subseteq\\mathbb{R}^n$, with $x_0\\in A$ and $\\det Df(x_0)\\ne0$. Let $g\\colon f(V)\\to V$ be the $C^1$ inverse of the restriction to a neighbourhood $V$ of $x_0$, and set $y_0=f(x_0)$. Which formula gives $Dg(y)$ for $y\\in f(V)$ in general?","options":["$Dg(y)=(Df(x_0))^{-1}$ for every such $y$","$Dg(y)=(Df(y))^{-1}$","$Dg(y)=(Df(g(y)))^{-1}$","$Dg(y)=Df(g(y))$"],"answer_mode":"server","feedback_revision":"953dfe438e25a3f884b3d856","time_limit":40,"curation_status":"retired","retired_at":"2026-10-26T13:01:42.374624+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2b_math_iv_multivariate_calculus_multivariable_inverse_function_theorem_5616bfba_019","difficulty":"challenge","question_type":"application","question":"For $f(x,y)=(x^2,\\ x+y)$ near $x_0=(1,0)$, write the local inverse as $(x,y)=g(u,v)$. What is $\\partial y/\\partial u$ at $(u,v)=(1,1)$?","options":["$\\tfrac{1}{2}$","$-1$","$0$","$-\\tfrac{1}{2}$"],"answer_mode":"server","feedback_revision":"5916d5edf1814c184bdd6a2b","time_limit":40,"curation_status":"retired","retired_at":"2026-10-26T13:01:42.374624+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2b_math_iv_multivariate_calculus_multivariable_inverse_function_theorem_5616bfba_020","difficulty":"challenge","question_type":"application","question":"Let $f\\colon A\\to\\mathbb{R}^2$ be $C^1$ on an open set $A\\subseteq\\mathbb{R}^2$, with $x_0\\in A$, $Df(x_0)=\\begin{pmatrix}1&2\\\\3&4\\end{pmatrix}$ and $y_0=f(x_0)$. Let $g$ be the local inverse with $g(y_0)=x_0$. Which first-order approximation holds for small $k\\in\\mathbb{R}^2$?","options":["$g(y_0+k)\\approx x_0+\\begin{pmatrix}-2&1\\\\\\tfrac{3}{2}&-\\tfrac{1}{2}\\end{pmatrix}k$","$g(y_0+k)\\approx x_0+\\begin{pmatrix}1&2\\\\3&4\\end{pmatrix}k$","$g(y_0+k)\\approx y_0+\\begin{pmatrix}-2&1\\\\\\tfrac{3}{2}&-\\tfrac{1}{2}\\end{pmatrix}k$","$g(y_0+k)\\approx x_0+\\begin{pmatrix}4&-2\\\\-3&1\\end{pmatrix}k$"],"answer_mode":"server","feedback_revision":"f2830e0bcc5277187008b33b","time_limit":40,"curation_status":"retired","retired_at":"2026-10-26T13:01:42.374624+00:00","reason_code":"replaced_after_academic_review"}]}}