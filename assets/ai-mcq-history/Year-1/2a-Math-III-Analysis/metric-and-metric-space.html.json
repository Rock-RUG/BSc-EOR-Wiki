target"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_bda40d51_005","difficulty":"standard","question_type":"conceptual","question":"Which formula expresses symmetry of a metric?","options":["$d(\\boldsymbol{x},\\boldsymbol{y}) = -d(\\boldsymbol{y},\\boldsymbol{x})$","$d(\\boldsymbol{x},\\boldsymbol{y}) = 0$ for all points","$d(\\boldsymbol{x},\\boldsymbol{y}) = d(\\boldsymbol{y},\\boldsymbol{x})$","$d(\\boldsymbol{x},\\boldsymbol{z}) = d(\\boldsymbol{x},\\boldsymbol{y})d(\\boldsymbol{y},\\boldsymbol{z})$"],"answer_mode":"server","feedback_revision":"24d6a45987ef678eefef4ecc","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_bda40d51_006","difficulty":"standard","question_type":"conceptual","question":"Which formula expresses the triangle inequality?","options":["$d(\\boldsymbol{x},\\boldsymbol{z})\\leq d(\\boldsymbol{x},\\boldsymbol{y})+d(\\boldsymbol{y},\\boldsymbol{z})$","$d(\\boldsymbol{x},\\boldsymbol{z})\\geq d(\\boldsymbol{x},\\boldsymbol{y})+d(\\boldsymbol{y},\\boldsymbol{z})$","$d(\\boldsymbol{x},\\boldsymbol{z}) = d(\\boldsymbol{x},\\boldsymbol{y})-d(\\boldsymbol{y},\\boldsymbol{z})$","$d(\\boldsymbol{x},\\boldsymbol{z}) = 0$ for all $\\boldsymbol{x},\\boldsymbol{z}$"],"answer_mode":"server","feedback_revision":"b28780d5cc9068abe81b8145","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_bda40d51_007","difficulty":"standard","question_type":"application","question":"Suppose $d(\\boldsymbol{x},\\boldsymbol{y}) = 4$ in a metric space. What is $d(\\boldsymbol{y},\\boldsymbol{x})$?","options":["$4$","$-4$","$0$","$8$"],"answer_mode":"server","feedback_revision":"33dd9c10c523cf7c03f796c8","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_bda40d51_008","difficulty":"standard","question_type":"application","question":"If $d(\\boldsymbol{x},\\boldsymbol{y}) = 2$ and $d(\\boldsymbol{y},\\boldsymbol{z}) = 3$, what upper bound does the triangle inequality give for $d(\\boldsymbol{x},\\boldsymbol{z})$?","options":["$1$","$5$","$6$","$0$"],"answer_mode":"server","feedback_revision":"db542da43baaa9e508ef98d1","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_bda40d51_009","difficulty":"challenge","question_type":"conceptual","question":"A proposed distance allows $d(\\boldsymbol{x},\\boldsymbol{y}) = 0$ for two distinct points. Which metric property fails?","options":["Identity of indiscernibles.","Symmetry only.","The triangle inequality only.","Non-negativity only."],"answer_mode":"server","feedback_revision":"54429eba748ef0b8a1011c38","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_bda40d51_010","difficulty":"challenge","question_type":"conceptual","question":"Which proposed distance on $\\mathbb{C}$ satisfies the basic metric requirement that distances are real and non-negative?","options":["$d(z,w)=z-w$","$d(z,w)=\\operatorname{Re}(z-w)$","$d(z,w)=|z-w|$","$d(z,w)=-|z-w|$"],"answer_mode":"server","feedback_revision":"05645e3731adec4ea396b634","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_bda40d51_011","difficulty":"challenge","question_type":"application","question":"Why is a rule with $d(\\boldsymbol{x},\\boldsymbol{y}) = -1$ for some pair unable to be a metric?","options":["It violates symmetry but not non-negativity.","It violates non-negativity.","It satisfies all metric properties.","It violates only the notation for ordered pairs."],"answer_mode":"server","feedback_revision":"3e20e78796a10ec0d6e5877a","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_bda40d51_012","difficulty":"challenge","question_type":"application","question":"For Euclidean distance in $\\mathbb{R}^n$, which formula is given?","options":["$d(\\boldsymbol{x},\\boldsymbol{y}) = \\sum_{i = 1}^{n}(x_i+y_i)$","$d(\\boldsymbol{x},\\boldsymbol{y}) = \\ \\left(\\sum_{i = 1}^{n}(x_i-y_i)^2\\right)^{1/2}$","$d(\\boldsymbol{x},\\boldsymbol{y}) = \\max_{1\\leq i\\leq n}x_i y_i$","$d(\\boldsymbol{x},\\boldsymbol{y}) = 0$ for all $\\boldsymbol{x},\\boldsymbol{y}$"],"answer_mode":"server","feedback_revision":"7209155d1ad8f11a54b97e04","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_f31c9f44_014","difficulty":"basic","question_type":"conceptual","question":"Which metric property says $d(\\boldsymbol{x},\\boldsymbol{y})=d(\\boldsymbol{y},\\boldsymbol{x})$?","options":["Triangle inequality","Non-negativity","Symmetry","Identity of indiscernibles"],"answer_mode":"server","feedback_revision":"75a6ebac3f83e077e9bdb980","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"no_diagnostic_value"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_f31c9f44_015","difficulty":"basic","question_type":"conceptual","question":"Which metric property says $d(\\boldsymbol{x},\\boldsymbol{y})=0$ exactly when $\\boldsymbol{x}=\\boldsymbol{y}$?","options":["Symmetry","Identity of indiscernibles","Triangle inequality","Boundedness"],"answer_mode":"server","feedback_revision":"93b05f52988635b6eaff283b","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_f31c9f44_016","difficulty":"basic","question_type":"application","question":"If $d$ is a metric and $\\boldsymbol{x}\\neq\\boldsymbol{y}$, which value is impossible for $d(\\boldsymbol{x},\\boldsymbol{y})$?","options":["$0$","$1$","$2$","$\\frac{1}{2}$"],"answer_mode":"server","feedback_revision":"df3841fa0441239fd6f1b337","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_2a_math_iii_analysis_metric_and_metric_space_f31c9f44_019","difficulty":"standard","question_type":"conceptual","question":"Why must a metric take values in $[0,+\\infty)$?","options":["Distances must always be integers.","Distances are required to be nonnegative real numbers.","Distances are allowed to be complex numbers.","Distances must be negative whenever the points are distinct."],"answer_mode":"server","feedback_revision":"ed9f711563ccaa4b0dab9115","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"}]}}