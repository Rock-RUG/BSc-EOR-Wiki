c3408bf887b53b","time_limit":25,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_or_modelling_uniform_demand_distribution_1645907b_015","difficulty":"standard","question_type":"application","question":"A newsvendor item sells at $p=10$ and costs $c=6$ per unit, and each leftover unit costs 2 to dispose of (salvage value $s=-2$). Demand is spread uniformly over $[30,90]$. What is the optimal stock?","options":["60","70","54","50"],"answer_mode":"server","feedback_revision":"38ff52833abf9256371b66b6","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_1_1a_or_modelling_uniform_demand_distribution_1645907b_016","difficulty":"standard","question_type":"application","question":"A newsvendor item costs $c=6$ per unit with salvage value $s=2$, and demand is spread uniformly over $[50,150]$. The selling price rises from $p=10$ to $p=12$. How does the optimal stock change?","options":["It rises by 15 units","It falls by 10 units","It rises by 10 units","It rises by 25 units"],"answer_mode":"server","feedback_revision":"967813e5ac47b63cc64826ab","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}