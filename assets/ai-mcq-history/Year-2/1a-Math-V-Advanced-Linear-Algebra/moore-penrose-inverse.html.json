th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-2/1a-Math-V-Advanced-Linear-Algebra/moore-penrose-inverse.html","concept":{"concept_id":"Year-2/1a-Math-V-Advanced-Linear-Algebra/moore-penrose-inverse.html","questions":[{"id":"year_2_1a_math_v_advanced_linear_algebra_moore_penrose_inverse_735318bf_006","difficulty":"basic","question_type":"application","question":"What is the Moore-Penrose inverse of $A=\\begin{pmatrix}2&0\\\\0&0\\end{pmatrix}$?","options":["$\\begin{pmatrix}\\tfrac{1}{2}&0\\\\0&1\\end{pmatrix}$","$\\begin{pmatrix}\\tfrac{1}{2}&0\\\\0&0\\end{pmatrix}$","$\\begin{pmatrix}2&0\\\\0&0\\end{pmatrix}$","It does not exist, as $A$ is singular"],"answer_mode":"server","feedback_revision":"98958d5c71a8308e5cf8adb9","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_2_1a_math_v_advanced_linear_algebra_moore_penrose_inverse_735318bf_008","difficulty":"basic","question_type":"application","question":"Let $A=\\begin{pmatrix}1&2\\\\2&4\\end{pmatrix}$ and $G=\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$. Which of the Penrose conditions (1) $AGA=A$, (2) $GAG=G$, (3) $AG$ symmetric, (4) $GA$ symmetric fail?","options":["Only (1) fails; (2), (3) and (4) hold","(3) and (4) fail; (1) and (2) hold","Only (2) fails; the other three hold","None fail, so $G$ is $A^+$"],"answer_mode":"server","feedback_revision":"21dd855e1cba2999e6c1c86e","time_limit":35,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_2_1a_math_v_advanced_linear_algebra_moore_penrose_inverse_735318bf_015","difficulty":"standard","question_type":"application","question":"Let $\\boldsymbol{a}=(1,-1)^{\\top}$, a $2\\times1$ matrix, so $\\boldsymbol{a}^+=\\tfrac{1}{2}(1,-1)$. What are $\\boldsymbol{a}\\boldsymbol{a}^+$ and $\\boldsymbol{a}^+\\boldsymbol{a}$?","options":["$\\boldsymbol{a}\\boldsymbol{a}^+=I_2$, $\\boldsymbol{a}^+\\boldsymbol{a}=1$","$\\boldsymbol{a}\\boldsymbol{a}^+=\\begin{pmatrix}1&-1\\\\-1&1\\end{pmatrix}$, $\\boldsymbol{a}^+\\boldsymbol{a}=2$","$\\boldsymbol{a}\\boldsymbol{a}^+=\\tfrac{1}{2}\\begin{pmatrix}1&-1\\\\-1&1\\end{pmatrix}$, $\\boldsymbol{a}^+\\boldsymbol{a}=1$","$\\boldsymbol{a}\\boldsymbol{a}^+=\\tfrac{1}{2}\\begin{pmatrix}1&1\\\\1&1\\end{pmatrix}$, $\\boldsymbol{a}^+\\boldsymbol{a}=1$"],"answer_mode":"server","feedback_revision":"5a167708d831f7323e2e8216","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_2_1a_math_v_advanced_linear_algebra_moore_penrose_inverse_735318bf_016","difficulty":"standard","question_type":"application","question":"The single equation $x_1+2x_2=5$ is written as $A\\boldsymbol{x}=b$ with $A=(1,2)$ and $b=5$, so $A^+=\\tfrac{1}{5}(1,2)^{\\top}$. Which solution is $A^+b$?","options":["$(5,0)^{\\top}$","$(5,10)^{\\top}$","$(1,2)^{\\top}$","$(0,\\tfrac{5}{2})^{\\top}$"],"answer_mode":"server","feedback_revision":"9257c0d368db786a93badd2b","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_2_1a_math_v_advanced_linear_algebra_moore_penrose_inverse_735318bf_017","difficulty":"challenge","question_type":"conceptual","question":"Let $A$ be a real $m\\times n$ matrix and $G=A^+$, so that (1) $AGA=A$, (2) $GAG=G$, (3) $AG$ symmetric, (4) $GA$ symmetric. What is the Moore-Penrose inverse $G^+$ of the $n\\times m$ matrix $G$?","options":["$A$: swapping the roles of $A$ and $G$ turns (1) into (2) and (3) into (4)","$A^{\\top}$: inverting twice returns a transpose, as $G$ has the shape of $A^{\\top}$","$A$ only when $A$ is invertible; otherwise $G^+$ differs from $A$","Not unique: every generalized inverse of $G$ qualifies, $A$ among them"],"answer_mode":"server","feedback_revision":"7411fdb684cbeaf2c811ffeb","time_limit":55,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_2_1a_math_v_advanced_linear_algebra_moore_penrose_inverse_735318bf_018","difficulty":"challenge","question_type":"conceptual","question":"Let $G$ satisfy $AGA=A$ for a real matrix $A$, with $\\operatorname{rank}G>\\operatorname{rank}A$. Can $G$ be the Moore-Penrose inverse $A^+$?","options":["Yes, provided $AG$ and $GA$ are symmetric","Yes; rank plays no role in the Penrose conditions","No: condition (2) forces $\\operatorname{rank}A^+\\le\\operatorname{rank}A$","No, because $A^+$ always has full rank"],"answer_mode":"server","feedback_revision":"bc084825c787f84e7c3c6355","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_2_1a_math_v_advanced_linear_algebra_moore_penrose_inverse_735318bf_019","difficulty":"challenge","question_type":"application","question":"Let $A=\\begin{pmatrix}1&0\\\\1&0\\end{pmatrix}$. Which matrix is $A^+$?","options":["$\\tfrac{1}{2}\\begin{pmatrix}1&1\\\\0&0\\end{pmatrix}$","$\\begin{pmatrix}1&0\\\\0&0\\end{pmatrix}$","$\\begin{pmatrix}1&1\\\\0&0\\end{pmatrix}$","$\\tfrac{1}{2}\\begin{pmatrix}1&0\\\\1&0\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"ed7c365e06ecb250db99ac72","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_2_1a_math_v_advanced_linear_algebra_moore_penrose_inverse_735318bf_020","difficulty":"challenge","question_type":"application","question":"Let $A=\\begin{pmatrix}1&0&1\\\\0&1&0\\end{pmatrix}$, a $2\\times3$ matrix of full row rank. Which $3\\times2$ matrix is its Moore-Penrose inverse $A^+$?","options":["$\\begin{pmatrix}1&0\\\\0&1\\\\0&0\\end{pmatrix}$","$\\begin{pmatrix}\\tfrac{1}{2}&0\\\\0&1\\\\\\tfrac{1}{2}&0\\end{pmatrix}$","$\\begin{pmatrix}1&0\\\\0&1\\\\1&0\\end{pmatrix}$","$\\tfrac{1}{2}\\begin{pmatrix}1&0\\\\0&1\\\\1&0\\end{pmatrix}$"],"answer_mode":"server","feedback_revision":"3855d6c26945917e2f257927","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"}]}}