th1-surjection-curation-001+math1-bijection-curation-001+math1-union-curation-001+math1-proper-curation-001+math1-complement-curation-001+math1-complement-render-001+math1-division-curation-001+math1-reciprocal-curation-001+math1-inequality-curation-001+math1-inequality-feedback-001+math1-maximum-curation-001+math1-minimum-curation-001+math1-boundedset-curation-001+math1-endpoint-curation-001+audit-groups-20261027+topup-math-i-20261028+topup-math-ii-20261028+topup-pt-20261028+topup-math-iii-20261028","history_only":true,"curation_sha256":"402117cd2ecc28eaf6387aaefcadec5f0c0540f0912f8a96983845daf37ec8e2","concept_id":"Year-2/1a-Math-V-Advanced-Linear-Algebra/fundamental-theorem-of-linear-algebra.html","concept":{"concept_id":"Year-2/1a-Math-V-Advanced-Linear-Algebra/fundamental-theorem-of-linear-algebra.html","questions":[{"id":"year_2_1a_math_v_advanced_linear_algebra_fundamental_theorem_of_linear_algebra_b8fd6321_008","difficulty":"basic","question_type":"application","question":"Which vector spans the null space $\\operatorname{Null}(A)$ of $A=\\begin{pmatrix}1&2&-1\\\\0&1&1\\end{pmatrix}$?","options":["$(3,-1,1)^{\\top}$","$(1,2,-1)^{\\top}$","$(1,0,1)^{\\top}$","$(3,1,1)^{\\top}$"],"answer_mode":"server","feedback_revision":"92a90bf345dd5beee997e9e2","time_limit":20,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_2_1a_math_v_advanced_linear_algebra_fundamental_theorem_of_linear_algebra_b8fd6321_013","difficulty":"standard","question_type":"conceptual","question":"Let $A$ be a real square $n\\times n$ matrix of rank $r$. How are its row space $\\operatorname{Row}(A)$ and column space $\\operatorname{Col}(A)$ related in general?","options":["They are always equal, since $A$ is square","Both have dimension $r$, but they need not be equal","They are orthogonal complements of each other","Their dimensions differ unless $A$ is symmetric"],"answer_mode":"server","feedback_revision":"e830f6000ec19746c7da9f2a","time_limit":35,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_2_1a_math_v_advanced_linear_algebra_fundamental_theorem_of_linear_algebra_b8fd6321_017","difficulty":"challenge","question_type":"conceptual","question":"Let $A$ be a real square matrix. Are $\\operatorname{Null}(A)$ and $\\operatorname{Col}(A)$, both subspaces of $\\mathbb{R}^n$, always orthogonal to each other?","options":["Yes: $\\operatorname{Null}(A)=\\operatorname{Row}(A)^\\perp$, and $\\operatorname{Row}(A)=\\operatorname{Col}(A)$","No: for $\\begin{pmatrix}0&1\\\\0&0\\end{pmatrix}$ both equal $\\operatorname{span}\\{(1,0)^{\\top}\\}$","Yes: their dimensions $n-r$ and $r$ add up to $n$","No: they lie in different spaces, so orthogonality is undefined"],"answer_mode":"server","feedback_revision":"e8d74557a9e6f8931f096d8c","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_2_1a_math_v_advanced_linear_algebra_fundamental_theorem_of_linear_algebra_b8fd6321_018","difficulty":"challenge","question_type":"conceptual","question":"Let $A$ be a real $m\\times n$ matrix with $\\operatorname{Null}(A)\\neq\\{\\boldsymbol{0}\\}$, and let $A\\boldsymbol{x}=\\boldsymbol{b}$ be solvable. How many solutions lie in the row space $\\operatorname{Row}(A)$?","options":["Exactly one, whatever the dimension of $\\operatorname{Null}(A)$","Infinitely many, since $\\operatorname{Null}(A)\\neq\\{\\boldsymbol{0}\\}$","None, unless $A$ is invertible","Exactly $r$, one per row-space basis vector"],"answer_mode":"server","feedback_revision":"05d57dd3e1a3a28ae37e2d1d","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_2_1a_math_v_advanced_linear_algebra_fundamental_theorem_of_linear_algebra_b8fd6321_019","difficulty":"challenge","question_type":"application","question":"For $A=\\begin{pmatrix}1&2\\\\2&4\\\\3&6\\end{pmatrix}$, $\\operatorname{Null}(A^{\\top})$ is spanned by $\\boldsymbol{y}_1=(-2,1,0)^{\\top}$ and $\\boldsymbol{y}_2=(-3,0,1)^{\\top}$. Is $A\\boldsymbol{x}=\\boldsymbol{b}$ solvable for $\\boldsymbol{b}=(1,2,4)^{\\top}$?","options":["Yes, since $\\boldsymbol{y}_1^{\\top}\\boldsymbol{b}=0$","Yes, since $\\boldsymbol{b}$ has no zero entry","No, since $\\boldsymbol{y}_2^{\\top}\\boldsymbol{b}=1\\neq0$","Yes: $\\boldsymbol{x}=(1,0)^{\\top}$ solves it"],"answer_mode":"server","feedback_revision":"2802a81df2fbc4a8be0e8fe7","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_2_1a_math_v_advanced_linear_algebra_fundamental_theorem_of_linear_algebra_b8fd6321_020","difficulty":"challenge","question_type":"application","question":"For $A=\\begin{pmatrix}1&0\\\\0&1\\\\1&1\\end{pmatrix}$, for which $k$ is $A\\boldsymbol{x}=(1,2,k)^{\\top}$ solvable?","options":["Only for $k=-3$","For every real $k$","Only for $k=3$","For no real $k$"],"answer_mode":"server","feedback_revision":"d55f66d855481742b2faea45","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}