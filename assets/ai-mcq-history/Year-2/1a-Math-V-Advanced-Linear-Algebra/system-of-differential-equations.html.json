ired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_2_1a_math_v_advanced_linear_algebra_system_of_differential_equations_b5748393_020","difficulty":"challenge","question_type":"application","question":"Which vector function solves $x_1'=-x_2$, $x_2'=x_1$ with $\\boldsymbol{x}(0)=(1,0)^{\\top}$? Check by differentiating.","options":["$\\big(\\cos t,\\ -\\sin t\\big)^{\\top}$","$\\big(1,\\ t\\big)^{\\top}$","$\\big(\\mathrm{e}^{-t},\\ \\mathrm{e}^{t}-1\\big)^{\\top}$","$\\big(\\cos t,\\ \\sin t\\big)^{\\top}$"],"answer_mode":"server","feedback_revision":"582a7bbf8beb635df17768a0","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"}]}}