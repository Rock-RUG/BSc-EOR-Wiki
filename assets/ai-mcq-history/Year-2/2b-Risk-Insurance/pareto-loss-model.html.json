alls from 1/2 to 1/4; per-payment mean rises from two to four."],"answer_mode":"server","feedback_revision":"dd71bbb7697d1d7ad2c32b3a","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}