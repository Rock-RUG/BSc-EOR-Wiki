edback_revision":"da4fc3f4cb29891d5c19f4b5","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_2_2b_game_theory_subgame_54c40742_015","difficulty":"standard","question_type":"application","question":"Player 1 chooses $A$, $B$ or $C$. Player 2 learns only whether $A$ was chosen: her nodes after $B$ and $C$ form one information set, and her node after $A$ is a singleton. She then chooses $x$ or $y$ and the game ends. How many subgames are there?","options":["$4$","$1$","$2$","$3$"],"answer_mode":"server","feedback_revision":"c086bc6b07570524feeddca5","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"}]}}