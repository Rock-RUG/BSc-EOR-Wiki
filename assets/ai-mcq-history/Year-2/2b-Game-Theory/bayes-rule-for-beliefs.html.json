fa3799aaf66de246d88341","time_limit":40,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_2_2b_game_theory_bayes_rule_for_beliefs_5df5a60b_018","difficulty":"challenge","question_type":"conceptual","question":"An entrant is competitive ($C$) with prior probability $p$ and weak ($W$) otherwise; type $C$ enters with probability $q_C$ and type $W$ with probability $q_W$. The incumbent sees entry but not the type. Let $p=0.3$ and suppose each type enters only by mistake, with $q_C=q_W=0.001$. What restriction does Bayes' rule place on the belief after entry?","options":["None, since entry is practically never observed","$\\mu=0.001$, the entry probability of each type","$\\mu=0.3$, since entry has positive probability","$\\mu=\\frac{1}{2}$, as both types enter equally rarely"],"answer_mode":"server","feedback_revision":"e0a0f32866f6d7c62331a5ba","time_limit":45,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"},{"id":"year_2_2b_game_theory_bayes_rule_for_beliefs_5df5a60b_020","difficulty":"challenge","question_type":"application","question":"An entrant is competitive ($C$) with prior probability $p$ and weak ($W$) otherwise; type $C$ enters with probability $q_C$ and type $W$ with probability $q_W$. The incumbent sees entry but not the type. Let $p=0.4$, $q_C=0.9$, $q_W=0.3$; then $\\mathbb{P}(C\\mid\\text{entry})=\\frac{2}{3}$. What belief $\\mathbb{P}(C\\mid\\text{no entry})$ should the incumbent hold if the entrant stays out?","options":["$\\frac{1}{3}$","$0.1$","$\\frac{2}{23}$","$\\frac{1}{8}$"],"answer_mode":"server","feedback_revision":"aa336afbfa23c20cec2a622b","time_limit":45,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"}]}}