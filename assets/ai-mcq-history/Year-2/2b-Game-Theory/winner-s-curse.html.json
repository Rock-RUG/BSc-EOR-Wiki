edback_revision":"3fa2236b1f6a04195f3b2e95","time_limit":35,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_2_2b_game_theory_winner_s_curse_2d3a9b23_016","difficulty":"standard","question_type":"application","question":"Five bidders estimate a common value $v$ by $\\theta_i=v+\\varepsilon_i$, errors i.i.d. $U[-20,20]$, and each bids her estimate in a first-price auction. Using $\\mathbb{E}[\\max_i\\varepsilon_i]=-20+40\\cdot\\frac{n}{n+1}$, by how much does the winner overpay on average?","options":["$\\frac{20}{3}$","$10$","$\\frac{40}{3}$","$0$"],"answer_mode":"server","feedback_revision":"ece86766c0a06b928a6759e0","time_limit":30,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"duplicate_diagnostic_target"},{"id":"year_2_2b_game_theory_winner_s_curse_2d3a9b23_019","difficulty":"challenge","question_type":"application","question":"The object's common value is $v=\\theta_1+\\theta_2$, where $\\theta_1,\\theta_2$ are i.i.d. $U[0,1]$ and bidder $i$ observes only $\\theta_i$. In a first-price auction (highest bid wins and pays her bid) both bid naively $\\theta_i+0.5$, so bidder 1 with signal $x$ wins when $\\theta_2<x$. For which signals $x\\in[0,1]$ is her expected profit given winning negative?","options":["Only $x>\\frac{1}{2}$, as optimistic signals overstate the value","Every $x<1$, with loss $\\frac{1}{2}(1-x)$ shrinking as $x$ rises","Only $x<\\frac{1}{2}$, as pessimistic signals win only against weak rivals","No signal, since $\\mathbb{E}[v\\mid\\theta_1]$ is an unbiased estimate"],"answer_mode":"server","feedback_revision":"4202f48a8d20e4829e0046fc","time_limit":50,"curation_status":"retired","retired_at":"2026-10-27T08:58:47.943104+00:00","reason_code":"replaced_after_academic_review"}]}}